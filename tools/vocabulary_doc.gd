# Godot EventSheets - headless vocabulary-doc driver.
#
#   godot --headless --path . --script tools/vocabulary_doc.gd
#   godot --headless --path . --script tools/vocabulary_doc.gd -- --check
#
# Writes the project vocabulary reference (default res://EVENTSHEETS-VOCABULARY.md;
# override with the eventsheets/project/vocabulary_doc_path setting). The Project
# Doctor notes when a generated doc has gone stale.
#
# --check writes nothing: it generates the doc in memory, compares it with the file on
# disk and prints `vocabulary doc drifted=0` or `vocabulary doc drifted=1` plus the
# first differing line, exit 1 on drift. It is the gate that keeps a reference doc
# regenerated by a broken generator from being committed as though it were current.
@tool
extends SceneTree


func _init() -> void:
	if OS.get_cmdline_user_args().has("--check"):
		quit(_check())
		return
	var path: String = EventSheetVocabularyDoc.write()
	if path.is_empty():
		printerr("vocabulary_doc: couldn't write %s" % EventSheetVocabularyDoc.doc_path())
		quit(1)
		return
	print("vocabulary doc written: %s" % path)
	quit(0)


func _check() -> int:
	var path: String = EventSheetVocabularyDoc.doc_path()
	var committed: String = FileAccess.get_file_as_string(path)
	var generated: String = EventSheetVocabularyDoc.generate()
	if committed == generated:
		print("vocabulary doc drifted=0")
		return 0
	var committed_lines: PackedStringArray = committed.split("\n")
	var generated_lines: PackedStringArray = generated.split("\n")
	var count: int = mini(committed_lines.size(), generated_lines.size())
	var first: int = count
	for index: int in count:
		if committed_lines[index] != generated_lines[index]:
			first = index
			break
	print("vocabulary doc drifted=1")
	print("first difference at line %d of %s" % [first + 1, path])
	print("  committed: %s" % (committed_lines[first] if first < committed_lines.size() else "<end of file>"))
	print("  generated: %s" % (generated_lines[first] if first < generated_lines.size() else "<end of file>"))
	print("regenerate with: godot --headless --path . --script tools/vocabulary_doc.gd")
	return 1
