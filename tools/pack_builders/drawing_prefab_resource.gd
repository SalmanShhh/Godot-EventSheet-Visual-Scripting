# Pack builder - drawing_prefab_resource (a data-driven Custom Resource; run via build_sample_behaviors.gd).
@tool

const Lib := preload("res://tools/pack_builders/_lib.gd")


## DrawingPrefabResource: a reusable drawing as a .tres asset - an ORDERED list of shape
## steps (circle, ring, rect, line, cone, stamp, arc, pie, rounded_rect, regular_polygon) edited as a grid in the Inspector. The
## Drawing Canvas's Draw Prefab action replays the steps in order at any position, scale,
## and rotation - author a target marker or explosion scorch once, stamp it everywhere.
static func build() -> bool:
	var sheet: EventSheetResource = EventSheetResource.new()
	sheet.host_class = "Resource"
	sheet.custom_class_name = "DrawingPrefabResource"
	sheet.class_description = "A reusable drawing: an ordered grid of shape steps replayed by the Drawing Canvas's Draw Prefab action at any position, scale, and rotation. Fill the steps grid in the Inspector and save as a .tres."
	sheet.variables = {
		"prefab_name": {"type": "String", "default": "marker", "exported": true,
			"attributes": {"tooltip": "A label for your own reference (the canvas does not read it)."}},
		"steps": {"type": "Array", "default": [], "exported": true,
			"attributes": {"tooltip": "The shapes drawn top to bottom: kind, offset and size values for each.",
				"drawer": "table", "table_columns": [{"name": "kind", "type": "enum", "options": ["circle", "ring", "rect", "line", "cone", "stamp", "arc", "pie", "rounded_rect", "regular_polygon"]}, {"name": "x", "type": "float"}, {"name": "y", "type": "float"}, {"name": "p1", "type": "float"}, {"name": "p2", "type": "float"}, {"name": "p3", "type": "float"}, {"name": "color", "type": "color"}, {"name": "texture", "type": "String"}]}}
	}
	# Runtime compiled-steps cache: replaying a prefab across 1000+ stamps must not re-parse strings
	# (Color.from_string, dict.get defaults, stamp texture loads) every draw. compiled_steps() parses the
	# steps ONCE into typed draw entries and caches them, invalidated when the resource changes. Both
	# renderers (DrawingPrefabStamp.draw_prefab_steps and CanvasSurface.prefab) read this on the main
	# thread; the off-thread thumbnail rasterizer keeps reading the raw steps and never touches this.
	var cache: RawCodeRow = RawCodeRow.new()
	cache.code = "\n".join(PackedStringArray([
		"# Runtime only (not",
		"# exported, so never serialized). Read ONLY on the main thread (the draw paths); the off-thread",
		"# thumbnail rasterizer reads the raw steps instead and never calls this.",
		"## Steps pre-parsed for drawing, cached until the resource changes.",
		"var _compiled: Array = []",
		"## True when the compiled strokes match the current settings.",
		"var _compiled_valid: bool = false",
		"## Size the strokes were last compiled for; -1 until compiled.",
		"var _compiled_size: int = -1",
		"",
		"## Returns steps pre-parsed to typed entries {kind, x, y, p1, p2, p3, color: Color, tex: Texture2D},",
		"## building and caching on first call and after any change. The size guard also rebuilds when steps",
		"## are appended or removed at runtime; an in-place value edit needs emit_changed() (the Inspector",
		"## does this automatically on every cell edit).",
		"func compiled_steps() -> Array:",
		"\tif not changed.is_connected(_invalidate_compiled):",
		"\t\tchanged.connect(_invalidate_compiled)",
		"\tif _compiled_valid and _compiled_size == steps.size():",
		"\t\treturn _compiled",
		"\t_compiled = compile_steps(steps)",
		"\t_compiled_size = steps.size()",
		"\t_compiled_valid = true",
		"\treturn _compiled",
		"",
		"func _invalidate_compiled() -> void:",
		"\t_compiled_valid = false",
		"\t_compiled = []",
		"",
		"## A line step's two points, both in the prefab's own space: where it starts (its offset) and where",
		"## it ends (its End, measured from the prefab's origin, not from the offset). Every renderer takes",
		"## the span from here so a line ends at the same point in the game, the viewport and the Inspector.",
		"## Works on a raw step and on a compiled entry alike.",
		"static func line_span(entry: Dictionary) -> PackedVector2Array:",
		"\treturn PackedVector2Array([",
		"\t\tVector2(float(entry.get(\"x\", 0.0)), float(entry.get(\"y\", 0.0))),",
		"\t\tVector2(float(entry.get(\"p1\", 0.0)), float(entry.get(\"p2\", 0.0))),",
		"\t])",
		"",
		"## The transform a stamp step is drawn under, in the prefab's own space: its offset, turned by its Spin",
		"## (degrees, about its centre). The stamp node draws every stamp under this, as Draw Prefab turns one.",
		"static func stamp_frame(entry: Dictionary) -> Transform2D:",
		"\treturn Transform2D(deg_to_rad(float(entry.get(\"p2\", 0.0))), Vector2(float(entry.get(\"x\", 0.0)), float(entry.get(\"y\", 0.0))))",
		"",
		"## The outline of a step drawn as a polygon or a stroke - an arc, a pie, a rounded rectangle or a regular",
		"## polygon - as points in the prefab's own space. The stamp node, Draw Prefab and the Inspector picture",
		"## all draw these four from the same rules, so a shape is one picture wherever it is seen. An arc is the",
		"## points of its stroke (a polyline); the other three are closed shapes (a polygon). A step that would",
		"## draw nothing (no radius, no sweep, no width, no size) answers an empty list. Works on a raw step and",
		"## on a compiled entry alike.",
		"##",
		"##   arc, pie           p1 radius, p2 start angle, p3 end angle (degrees, 0 = right, growing clockwise on",
		"##                      screen). The sweep runs from the start to the end, backwards when the end is below",
		"##                      the start, and is held to one full turn.",
		"##   rounded_rect       p1 width, p2 height, p3 corner radius, placed right and down from the offset like",
		"##                      a Rectangle; corners larger than half the short side are held to half of it.",
		"##   regular_polygon    p1 radius (centre to corner), p2 sides (3 to 32), p3 angle of the first corner.",
		"## @ace_hidden",
		"static func shape_outline(entry: Dictionary) -> PackedVector2Array:",
		"\tvar out: PackedVector2Array = PackedVector2Array()",
		"\tvar at: Vector2 = Vector2(float(entry.get(\"x\", 0.0)), float(entry.get(\"y\", 0.0)))",
		"\tvar p1: float = float(entry.get(\"p1\", 0.0))",
		"\tvar p2: float = float(entry.get(\"p2\", 0.0))",
		"\tvar p3: float = float(entry.get(\"p3\", 0.0))",
		"\tvar kind: String = str(entry.get(\"kind\", \"\"))",
		"\tmatch kind:",
		"\t\t\"arc\", \"pie\":",
		"\t\t\tvar start: float = deg_to_rad(p2)",
		"\t\t\tvar sweep: float = clampf(deg_to_rad(p3) - start, -TAU, TAU)",
		"\t\t\tif p1 <= 0.0 or absf(sweep) < 0.0005:",
		"\t\t\t\treturn out",
		"\t\t\tvar segments: int = maxi(ceili(absf(sweep) / TAU * 48.0), 2)",
		"\t\t\tif kind == \"pie\":",
		"\t\t\t\tout.append(at)",
		"\t\t\t# A pie turned all the way round would end on the point it began at: it keeps one of the two.",
		"\t\t\tvar rim: int = segments if kind == \"pie\" and absf(sweep) >= TAU - 0.0005 else segments + 1",
		"\t\t\tfor step: int in rim:",
		"\t\t\t\tout.append(at + Vector2.from_angle(start + sweep * float(step) / float(segments)) * p1)",
		"\t\t\"rounded_rect\":",
		"\t\t\tvar box: Rect2 = Rect2(at, Vector2(p1, p2)).abs()",
		"\t\t\tif box.size.x <= 0.0 or box.size.y <= 0.0:",
		"\t\t\t\treturn out",
		"\t\t\tvar radius: float = clampf(p3, 0.0, minf(box.size.x, box.size.y) * 0.5)",
		"\t\t\tif radius < 0.01:",
		"\t\t\t\treturn PackedVector2Array([box.position, Vector2(box.end.x, box.position.y), box.end, Vector2(box.position.x, box.end.y)])",
		"\t\t\tvar inner: Rect2 = box.grow(-radius)",
		"\t\t\tvar centres: Array[Vector2] = [inner.end, Vector2(inner.position.x, inner.end.y), inner.position, Vector2(inner.end.x, inner.position.y)]",
		"\t\t\tfor quadrant: int in 4:",
		"\t\t\t\tfor step: int in 7:",
		"\t\t\t\t\tout.append(centres[quadrant] + Vector2.from_angle(PI * 0.5 * (float(quadrant) + float(step) / 6.0)) * radius)",
		"\t\t\"regular_polygon\":",
		"\t\t\tvar sides: int = clampi(roundi(p2), 3, 32)",
		"\t\t\tif p1 <= 0.0:",
		"\t\t\t\treturn out",
		"\t\t\tfor corner: int in sides:",
		"\t\t\t\tout.append(at + Vector2.from_angle(deg_to_rad(p3) + TAU * float(corner) / float(sides)) * p1)",
		"\treturn out",
		"",
		"## One line step's stroke: its ends, and its dash pattern when it has one. A step that says",
		"## neither draws the single plain line it always drew, so an older prefab is untouched.",
		"## @ace_hidden",
		"static func draw_stroke(canvas: CanvasItem, from: Vector2, to: Vector2, width: float, tint: Color, entry: Dictionary) -> void:",
		"\tif not bool(entry.get(\"dashed\", false)):",
		"\t\tdraw_capped(canvas, from, to, width, tint, str(entry.get(\"caps\", \"none\")))",
		"\t\treturn",
		"\tvar span: float = from.distance_to(to)",
		"\tif span <= 0.001:",
		"\t\treturn",
		"\tvar direction: Vector2 = (to - from) / span",
		"\tvar dash: float = maxf(float(entry.get(\"dash_size\", 8.0)), 0.5)",
		"\tvar period: float = dash + maxf(float(entry.get(\"dash_spacing\", 6.0)), 0.0)",
		"\tvar style: String = str(entry.get(\"dash_style\", \"plain\"))",
		"\t# Whole periods of offset land where they started, so a scrolled pattern never jumps.",
		"\tvar along: float = -fposmod(float(entry.get(\"dash_offset\", 0.0)) * period, period)",
		"\twhile along < span:",
		"\t\tvar starts: float = maxf(along, 0.0)",
		"\t\tvar ends: float = minf(along + dash, span)",
		"\t\tif ends > starts:",
		"\t\t\tif style == \"angled\":",
		"\t\t\t\tdraw_leaning_dash(canvas, from, direction, starts, ends, width, tint)",
		"\t\t\telse:",
		"\t\t\t\tdraw_capped(canvas, from + direction * starts, from + direction * ends, width, tint, \"round\" if style == \"rounded\" else \"none\")",
		"\t\talong += period",
		"",
		"## One straight run with its ends: cut square at the point (none), half a width past it",
		"## (square), or rounded off with a disc at each end (round).",
		"## @ace_hidden",
		"static func draw_capped(canvas: CanvasItem, from: Vector2, to: Vector2, width: float, tint: Color, caps: String) -> void:",
		"\tvar line_from: Vector2 = from",
		"\tvar line_to: Vector2 = to",
		"\tif caps == \"square\" and from.distance_to(to) > 0.001:",
		"\t\tvar reach: Vector2 = (to - from).normalized() * width * 0.5",
		"\t\tline_from -= reach",
		"\t\tline_to += reach",
		"\tcanvas.draw_line(line_from, line_to, tint, width)",
		"\tif caps == \"round\":",
		"\t\tcanvas.draw_circle(from, width * 0.5, tint)",
		"\t\tcanvas.draw_circle(to, width * 0.5, tint)",
		"",
		"## One angled dash: the same run leaning over by half a width, drawn as the parallelogram it",
		"## is - which is what makes a row of them read as a slant rather than as ticks.",
		"## @ace_hidden",
		"static func draw_leaning_dash(canvas: CanvasItem, from: Vector2, direction: Vector2, starts: float, ends: float, width: float, tint: Color) -> void:",
		"\tvar half: float = width * 0.5",
		"\tvar side: Vector2 = Vector2(-direction.y, direction.x) * half",
		"\tcanvas.draw_colored_polygon(PackedVector2Array([",
		"\t\tfrom + direction * (starts - half) + side,",
		"\t\tfrom + direction * (ends - half) + side,",
		"\t\tfrom + direction * (ends + half) - side,",
		"\t\tfrom + direction * (starts + half) - side,",
		"\t]), tint)",
		"",
		"## Parses raw steps (Dictionaries of strings) into typed entries - colors parsed once, stamp",
		"## textures loaded once (main thread). The renderers use the SAME shape for their generic-Resource",
		"## fallback, so a cached draw and an uncached draw are identical.",
		"##",
		"## The eight stored keys (kind, x, y, p1, p2, p3, color, texture) mean exactly what they always",
		"## did. Beside them a step may carry the optional look keys the Inspector card writes - the ends",
		"## of a line, its dash pattern, an arc's thickness, and whether a stroke's thickness follows the stamp's scale - and a step",
		"## that carries none of them compiles to the values it always drew with.",
		"static func compile_steps(raw: Array) -> Array:",
		"\tvar out: Array = []",
		"\tfor step: Variant in raw:",
		"\t\tif not (step is Dictionary):",
		"\t\t\tcontinue",
		"\t\tvar entry: Dictionary = step",
		"\t\tvar kind: String = str(entry.get(\"kind\", \"\"))",
		"\t\tvar tex: Texture2D = null",
		"\t\tif kind == \"stamp\":",
		"\t\t\tvar texture_path: String = str(entry.get(\"texture\", \"\")).strip_edges()",
		"\t\t\tif not texture_path.is_empty() and ResourceLoader.exists(texture_path):",
		"\t\t\t\ttex = load(texture_path) as Texture2D",
		"\t\tout.append({",
		"\t\t\t\"kind\": kind,",
		"\t\t\t\"x\": float(entry.get(\"x\", 0.0)),",
		"\t\t\t\"y\": float(entry.get(\"y\", 0.0)),",
		"\t\t\t\"p1\": float(entry.get(\"p1\", 0.0)),",
		"\t\t\t\"p2\": float(entry.get(\"p2\", 0.0)),",
		"\t\t\t\"p3\": float(entry.get(\"p3\", 0.0)),",
		"\t\t\t\"color\": Color.from_string(str(entry.get(\"color\", \"white\")), Color.WHITE),",
		"\t\t\t\"tex\": tex,",
		"\t\t\t\"caps\": str(entry.get(\"caps\", \"none\")),",
		"\t\t\t\"scale_mode\": str(entry.get(\"scale_mode\", \"uniform\")),",
		"\t\t\t\"thickness\": float(entry.get(\"thickness\", 2.0)),",
		"\t\t\t\"dashed\": bool(entry.get(\"dashed\", false)),",
		"\t\t\t\"dash_size\": float(entry.get(\"dash_size\", 8.0)),",
		"\t\t\t\"dash_spacing\": float(entry.get(\"dash_spacing\", 6.0)),",
		"\t\t\t\"dash_offset\": float(entry.get(\"dash_offset\", 0.0)),",
		"\t\t\t\"dash_style\": str(entry.get(\"dash_style\", \"plain\")),",
		"\t\t})",
		"\treturn out",
	]))
	sheet.events.append(cache)
	return Lib.save_pack(sheet, "res://eventsheet_addons/drawing_prefab_resource/drawing_prefab_resource")
