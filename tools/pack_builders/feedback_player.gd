		"const PUSH_ALONG: String = \"along\"",
		"",
		"## The transition words of a Tween, as Godot names them.",
		"const TRANSITIONS: Dictionary = {",
		"\t\"linear\": Tween.TRANS_LINEAR, \"sine\": Tween.TRANS_SINE, \"quint\": Tween.TRANS_QUINT,",
		"\t\"quart\": Tween.TRANS_QUART, \"quad\": Tween.TRANS_QUAD, \"expo\": Tween.TRANS_EXPO,",
		"\t\"elastic\": Tween.TRANS_ELASTIC, \"cubic\": Tween.TRANS_CUBIC, \"circ\": Tween.TRANS_CIRC,",
		"\t\"bounce\": Tween.TRANS_BOUNCE, \"back\": Tween.TRANS_BACK, \"spring\": Tween.TRANS_SPRING",
		"}",
		"",
		"## The ease words of a Tween, as Godot names them.",
		"const EASES: Dictionary = {",
		"\t\"in\": Tween.EASE_IN, \"out\": Tween.EASE_OUT, \"in_out\": Tween.EASE_IN_OUT, \"out_in\": Tween.EASE_OUT_IN",
		"}",
		"",
		"## The cards that have already said their node is missing, by label, so it is said once.",
		"var _told_cards: Dictionary = {}",
		"",
		"## The materials a Shader Value card gave one node, by node id, so a second card reuses the copy.",
		"var _own_materials: Dictionary = {}",
		"",
		"## The forces a Force For A Time card is holding on bodies right now: body, force and the timer's end.",
		"var _held_forces: Array[Dictionary] = []",
		"",
		"## The path a card holds under a key, or an empty path when it holds none. A card written by hand may",
		"## hold the path as text, so both spellings read.",
		"static func _path_of(card: Dictionary, key: String) -> NodePath:",
		"\tvar stored: Variant = card.get(key, NodePath())",
		"\treturn stored if stored is NodePath else NodePath(str(stored))",
		"",
		"## The node a card points at, or null. A card that names none acts on the object this player is under",
		"## when `host_when_empty` is set, and on nothing otherwise.",
		"func _target(card: Dictionary, key: String, host_when_empty: bool) -> Node:",
		"\tvar path: NodePath = _path_of(card, key)",
		"\tif path.is_empty():",
		"\t\treturn host if host_when_empty else null",
		"\treturn get_node_or_null(path)",
		"",
		"## Says once that a card could not do its work, and tells On Juice Card Skipped why.",
		"func _card_missing(card: Dictionary, reason: String) -> void:",
		"\tvar label: String = _label_of(card)",
		"\ton_feedback_skipped.emit(label, \"target missing\")",
		"\tif _told_cards.has(label):",
		"\t\treturn",
		"\t_told_cards[label] = true",
		"\tpush_warning(\"Juice Player: the card \\\"%s\\\" on %s %s, so it did nothing.\" % [label, name, reason])",
		"",
		"## A tween of this player's own, kept so a Restore or a stop can end it. Tweens that have finished are let go.",
		"func _new_tween() -> Tween:",
		"\tfor held: int in range(_tweens.size() - 1, -1, -1):",
		"\t\tif not is_instance_valid(_tweens[held]) or not _tweens[held].is_running():",
		"\t\t\t_tweens.remove_at(held)",
		"\tvar made: Tween = create_tween()",
		"\t_tweens.append(made)",
		"\treturn made",
		"",
		"## Writes down what a property was, so Restore Initial Values can put it back.",
		"func _remember(object: Object, property: String) -> Variant:",
		"\tvar before: Variant = object.get_indexed(NodePath(property))",
		"\t_keep_first(object, property, before)",
		"\treturn before",
		"",
		"## The number a card's text means: a plain number, or a name read from the game - an autoload and then",
		"## its properties (\"GameState.score\"), else a property of the object this player is under. Null when",
		"## the text names nothing that holds a number.",
		"func _number_from(text: String) -> Variant:",
		"\tvar said: String = text.strip_edges()",
		"\tif said.is_empty():",
		"\t\treturn null",
		"\tif said.is_valid_float():",
		"\t\treturn said.to_float()",
		"\tvar parts: PackedStringArray = said.split(\".\")",
		"\tvar current: Variant = get_node_or_null(\"/root/\" + parts[0])",
		"\tif current == null and host != null:",
		"\t\tcurrent = host.get(parts[0])",
		"\tfor part: int in range(1, parts.size()):",
		"\t\tif not (current is Object):",
		"\t\t\treturn null",
		"\t\tcurrent = (current as Object).get(parts[part])",
		"\tif current is float or current is int:",
		"\t\treturn float(current)",
		"\treturn null",
		"",
		"## One world card, done. The words are the ones in WORLD_WORDS; `at` is the strength already multiplied",
		"## by this player's own, and `seconds` the card's length.",
		"func _play_world_card(word: String, card: Dictionary, at: float, seconds: float, skipping: bool = false) -> void:",
		"\tmatch word:",
		"\t\tPARTICLES:",
		"\t\t\t_particles(card)",
		"\t\tANIMATION:",
		"\t\t\t_animation(card, seconds)",
		"\t\tSPRITE_ANIMATION:",
		"\t\t\t_sprite_animation(card, seconds)",
		"\t\tSHOW_HIDE:",
		"\t\t\t_show_hide(card, seconds)",
		"\t\tCALL_METHOD:",
		"\t\t\t_call_method(card)",
		"\t\tSPAWN_SCENE:",
		"\t\t\t_spawn_scene(card)",
		"\t\tPUSH:",
		"\t\t\t_push(card, at)",
		"\t\tFORCE_FOR_A_TIME:",
		"\t\t\t_force_for_a_time(card, seconds)",
		"\t\tGRAVITY_FOR_A_TIME:",
		"\t\t\t_gravity_for_a_time(card, seconds)",
		"\t\tFREEZE_BODY:",
		"\t\t\t_freeze_body(card, seconds)",
		"\t\tSQUASH_STRETCH, PUNCH_POSITION, PUNCH_ROTATION:",
		"\t\t\t_punch_through_juice(word, card, at, seconds)",
		"\t\tPOP:",
		"\t\t\t_pop(card, seconds)",
		"\t\tFADE:",
		"\t\t\t_fade(card, seconds)",
		"\t\tGRAB_FOCUS:",
		"\t\t\t_grab_focus(card)",
		"\t\tCOUNT_TO:",
		"\t\t\t_count_to(card, seconds)",
		"\t\tREVEAL_TEXT:",
		"\t\t\t_reveal_text(card, seconds)",
		"\t\tFILL_BAR:",
		"\t\t\t_fill_bar(card, seconds)",
		"\t\tSHADER_VALUE:",
		"\t\t\t_shader_value(card, seconds)",
		"\t\tPAUSE_PLAYER:",
		"\t\t\t_pause_player(card)",
		"\t\tCOLLISION_FOR:",
		"\t\t\t_collision_for(card, seconds)",
		"\t\tCOLLISION_LAYER_FOR:",
		"\t\t\t_collision_layer_for(card, seconds)",
		"\t\tREMOVE_NODE:",
		"\t\t\t_remove_node(card, skipping)",
		"\t\tDRAW_ORDER:",
		"\t\t\t_draw_order(card, seconds)",
		"\t\tSWITCH_NODE:",
		"\t\t\t_switch_node(card, seconds)",
		"\t\tLOOK_AT:",
		"\t\t\t_look_at(card, 0.0 if skipping else seconds)",
		"\t\tROTATE_BY:",
		"\t\t\t_turn(card, 0.0 if skipping else seconds, true)",
		"\t\tROTATE_TO:",
		"\t\t\t_turn(card, 0.0 if skipping else seconds, false)",
		"\t\tROTATION_SHAKE:",
		"\t\t\t_rotation_shake(card, at, seconds)",
		"\t\tLIGHT:",
		"\t\t\t_light(card, at, seconds)",
		"\t\tSCENE_LOOK:",
		"\t\t\t_scene_look(card, seconds)",
		"\t\tBUS_EFFECT:",
		"\t\t\t_bus_effect(card, seconds)",
		"\t\tSPRING:",
		"\t\t\t_spring(card, at)",
		"\t\tSLOW_OBJECT:",
		"\t\t\t_slow_object(card, seconds)",
		"\t\tANIMATION_PARAMETER:",
		"\t\t\t_animation_parameter(card, seconds)",
		"\t\tCHROMATIC_SHAKE:",
		"\t\t\t_chromatic_shake(card, at, seconds)",
		"",
		"## The Juice node a Chromatic Shake card started a shake on, so Stop, Restore and leaving the scene can close the split.",
		"var _chroma_node: Node = null",
		"",
		"## What a Chromatic Shake card asks the Juice node's own row for: [amount in pixels, seconds, mode, angle]. The strength",
		"## scales the amount and nothing else; the Juice node then holds it to the no-flashing choice and the effect-strength",
		"## dial, as it does for the row. A direction that wanders is the row's angle below zero; an angle is turned into the",
		"## 0 to 360 the row takes.",
		"## @ace_hidden",
		"static func chromatic_shake_asked(card: Dictionary, at: float, seconds: float) -> Array:",
		"\tvar angle: float = -1.0",
		"\tif str(card.get(\"direction\", \"wander\")) == \"angle\":",
		"\t\tangle = fposmod(float(card.get(\"angle\", 0.0)), 360.0)",
		"\tvar mode: String = \"constant\" if str(card.get(\"mode\", \"reducing\")) == \"constant\" else \"reducing\"",
		"\treturn [maxf(float(card.get(\"amount\", 12.0)), 0.0) * maxf(at, 0.0), maxf(seconds, 0.01), mode, angle]",
		"",
		"## Splits the screen's colours apart through the Juice node's Chromatic Shake row, and keeps the node so the split can be closed.",
		"func _chromatic_shake(card: Dictionary, at: float, seconds: float) -> void:",
		"\tvar juice: Node = _juice()",
		"\tif juice == null or not juice.has_method(\"chromatic_shake\"):",
		"\t\treturn",
		"\tvar asked: Array = chromatic_shake_asked(card, at, seconds)",
		"\tjuice.call(\"chromatic_shake\", asked[0], asked[1], asked[2], asked[3])",
		"\t_chroma_node = juice",
		"",
		"## Puts the colours together at once if a Chromatic Shake card of this player split them.",
		"func _end_chroma_shake() -> void:",
		"\tvar juice: Node = _chroma_node",
		"\t_chroma_node = null",
		"\tif juice != null and is_instance_valid(juice) and juice.has_method(\"stop_chromatic_shake\"):",
		"\t\tjuice.call(\"stop_chromatic_shake\")",
		"",
		"## The Juice node a player would play through, found from where it is saved: under the same object or under the",
		"## player. The editor asks it to say in amber that a Chromatic Shake card has nothing to play it.",
		"## @ace_hidden",
		"static func juice_beside(player: Node) -> Node:",
		"\tif player == null:",
		"\t\treturn null",
		"\tvar looked: Array = player.get_children()",
		"\tvar parent: Node = player.get_parent()",
		"\tif parent != null:",
		"\t\tlooked.append_array(parent.get_children())",
		"\tvar chosen: Variant = player.get(\"acts_on\")",
		"\tif chosen is Node:",
		"\t\tlooked.append_array((chosen as Node).get_children())",
		"\tfor child: Variant in looked:",
		"\t\tvar node: Node = child as Node",
		"\t\tif node != null and node != player and node.has_method(\"chromatic_shake\"):",
		"\t\t\treturn node",
		"\treturn null",
		"",
		"## Restarts, starts or stops a particles node.",
		"func _particles(card: Dictionary) -> void:",
		"\tvar target: Node = _target(card, \"node\", false)",
		"\tif target == null or not (\"emitting\" in target):",
		"\t\t_card_missing(card, \"points at no particles node\")",
		"\t\treturn",
		"\t_remember(target, \"emitting\")",
		"\tmatch str(card.get(\"do\", DO_RESTART)):",
		"\t\tDO_STOP:",
		"\t\t\ttarget.set(\"emitting\", false)",
		"\t\tDO_START:",
		"\t\t\ttarget.set(\"emitting\", true)",
		"\t\t_:",
		"\t\t\tif target.has_method(\"restart\"):",
		"\t\t\t\ttarget.call(\"restart\")",
		"\t\t\ttarget.set(\"emitting\", true)",
		"",
		"## Plays a clip of an AnimationPlayer. The card's seconds stretch the clip to that length, so Scale",
		"## Juice Timing speeds an animation up with the rest of the list.",
		"func _animation(card: Dictionary, seconds: float) -> void:",
		"\tvar target: AnimationPlayer = _target(card, \"node\", false) as AnimationPlayer",
		"\tif target == null:",
		"\t\t_card_missing(card, \"points at no animation player\")",
		"\t\treturn",
		"\tvar clip_name: String = str(card.get(\"animation\", \"\"))",
		"\tif not target.has_animation(clip_name):",
		"\t\t_card_missing(card, \"names the animation \\\"%s\\\", which that player does not have\" % clip_name)",
		"\t\treturn",
		"\tvar length: float = target.get_animation(clip_name).length",
		"\tvar speed: float = length / seconds if seconds > 0.0 and length > 0.0 else 1.0",
		"\ttarget.play(clip_name, -1.0, speed)",
		"",
		"## Plays an animation of an AnimatedSprite2D or AnimatedSprite3D, stretched to the card's seconds.",
		"func _sprite_animation(card: Dictionary, seconds: float) -> void:",
		"\tvar target: Node = _target(card, \"node\", false)",
		"\tvar frames: SpriteFrames = target.get(\"sprite_frames\") as SpriteFrames if target != null else null",
		"\tif frames == null or not target.has_method(\"play\"):",
		"\t\t_card_missing(card, \"points at no animated sprite\")",
		"\t\treturn",
		"\tvar clip_name: String = str(card.get(\"animation\", \"\"))",
		"\tif not frames.has_animation(clip_name):",
		"\t\t_card_missing(card, \"names the animation \\\"%s\\\", which that sprite does not have\" % clip_name)",
		"\t\treturn",
		"\tvar length: float = float(frames.get_frame_count(clip_name)) / maxf(frames.get_animation_speed(clip_name), 0.001)",
		"\ttarget.call(\"play\", clip_name, length / seconds if seconds > 0.0 and length > 0.0 else 1.0)",
		"",
		"## Shows a node, hides it, or shows it for the card's seconds and hides it again.",
		"func _show_hide(card: Dictionary, seconds: float) -> void:",
		"\tvar target: Node = _target(card, \"node\", true)",
		"\tif target == null or not (\"visible\" in target):",
		"\t\t_card_missing(card, \"points at no node that can be shown or hidden\")",
		"\t\treturn",
		"\t_remember(target, \"visible\")",
		"\tvar word: String = str(card.get(\"do\", DO_FLASH))",
		"\ttarget.set(\"visible\", word != DO_HIDE)",
		"\tif word == DO_FLASH:",
		"\t\tget_tree().create_timer(maxf(seconds, 0.0)).timeout.connect(func() -> void:",
		"\t\t\tif is_instance_valid(target):",
		"\t\t\t\ttarget.set(\"visible\", false))",
		"",
		"## Calls a method of a node with the values the card holds.",
		"func _call_method(card: Dictionary) -> void:",
		"\tvar target: Node = _target(card, \"node\", false)",
		"\tvar method: String = str(card.get(\"method\", \"\"))",
		"\tif target == null or not target.has_method(method):",
		"\t\t_card_missing(card, \"points at no node with a method called \\\"%s\\\"\" % method)",
		"\t\treturn",
		"\tvar given: Variant = card.get(\"args\", [])",
		"\ttarget.callv(method, given if given is Array else [])",
		"",
		"## Adds a copy of a scene to the running scene, at this object or at a node, taking it from the",
		"## object pool when that scene has one.",
		"func _spawn_scene(card: Dictionary) -> void:",
		"\tvar path: String = str(card.get(\"scene\", \"\"))",
		"\tvar scene: PackedScene = load(path) as PackedScene if not path.is_empty() and ResourceLoader.exists(path) else null",
		"\tif scene == null:",
		"\t\t_card_missing(card, \"names a scene that is not in the project\")",
		"\t\treturn",
		"\tvar anchor: Node = _target(card, \"node\", true) if str(card.get(\"at\", \"here\")) == \"node\" else host",
		"\tif anchor == null:",
		"\t\t_card_missing(card, \"points at no node to drop the scene at\")",
		"\t\treturn",
		"\tvar place: Variant = anchor.get(\"global_position\")",
		"\tvar pool: Node = get_node_or_null(\"/root/ObjectPool\")",
		"\tvar pooled: String = _pool_named_for(pool, scene)",
		"\tif not pooled.is_empty() and place != null:",
		"\t\tpool.call(\"spawn_safely\", pooled, place)",
		"\t\treturn",
		"\tvar made: Node = scene.instantiate()",
		"\tvar world: Node = get_tree().current_scene if get_tree().current_scene != null else get_parent()",
		"\tworld.add_child.call_deferred(made)",
		"\tif place != null:",
		"\t\tmade.set.call_deferred(\"global_position\", place)",
		"",
		"## The name of the object pool that holds copies of this scene, or \"\" when none does.",
		"func _pool_named_for(pool: Node, scene: PackedScene) -> String:",
		"\tif pool == null or not pool.has_method(\"spawn_safely\"):",
		"\t\treturn \"\"",
		"\tvar pools: Variant = pool.get(\"_pools\")",
		"\tif not (pools is Dictionary):",
		"\t\treturn \"\"",
		"\tfor pool_name: Variant in (pools as Dictionary):",
		"\t\tvar entry: Variant = (pools as Dictionary)[pool_name]",
		"\t\tif entry is Dictionary and (entry as Dictionary).get(\"scene\") == scene:",
		"\t\t\treturn str(pool_name)",
		"\treturn \"\"",
		"",
		"## The body a body card acts on, or null (said once) when the card names one that is not there.",
		"func _body_of(card: Dictionary) -> Node:",
		"\tvar body: Node = _target(card, \"body\", true)",
		"\tif body == null:",
		"\t\t_card_missing(card, \"points at no body\")",
		"\treturn body",
		"",
		"## The direction a Push goes, always of length one, or a zero vector when it has none.",
		"func _push_direction(card: Dictionary, body: Node) -> Variant:",
		"\tvar in_3d: bool = body is Node3D",
		"\tmatch str(card.get(\"direction\", PUSH_AWAY)):",
		"\t\tPUSH_FIXED:",
		"\t\t\tvar fixed: Vector3 = Vector3(float(card.get(\"x\", 0.0)), float(card.get(\"y\", -1.0)), float(card.get(\"z\", 0.0)))",
		"\t\t\tif in_3d:",
		"\t\t\t\treturn fixed.normalized()",
		"\t\t\treturn Vector2(fixed.x, fixed.y).normalized()",
		"\t\tPUSH_ALONG:",
		"\t\t\tvar moving: Variant = body.get(\"linear_velocity\")",
		"\t\t\tif moving == null:",
		"\t\t\t\tmoving = body.get(\"velocity\")",
		"\t\t\tif moving is Vector2 or moving is Vector3:",
		"\t\t\t\treturn moving.normalized()",
		"\t\t\treturn _no_direction(in_3d)",
		"\tvar from: Variant = body.get(\"global_position\")",
		"\tvar other: Node = _target(card, \"from\", false)",
		"\tvar there: Variant = null",
		"\tif other != null:",
		"\t\tthere = other.get(\"global_position\")",
		"\tif from == null or there == null or typeof(there) != typeof(from):",
		"\t\treturn _no_direction(in_3d)",
		"\treturn (from - there).normalized()",
		"",
		"## The direction of a push that has none: a vector of no length, of the kind the body uses.",
		"static func _no_direction(in_3d: bool) -> Variant:",
		"\tif in_3d:",
		"\t\treturn Vector3.ZERO",
		"\treturn Vector2.ZERO",
		"",
		"## A shove. A RigidBody takes it as an impulse, a CharacterBody has it added to its velocity once and",
		"## carries on moving itself. Anything else is not a body, and the card says so.",
		"func _push(card: Dictionary, at: float) -> void:",
		"\tvar body: Node = _body_of(card)",
		"\tif body == null:",
		"\t\treturn",
		"\tvar speed: float = float(card.get(\"speed\", 300.0)) * (at if bool(card.get(\"scaled\", true)) else 1.0)",
		"\tvar way: Variant = _push_direction(card, body)",
		"\tif body is RigidBody2D:",
		"\t\t(body as RigidBody2D).apply_central_impulse((way as Vector2) * speed * (body as RigidBody2D).mass)",
		"\telif body is RigidBody3D:",
		"\t\t(body as RigidBody3D).apply_central_impulse((way as Vector3) * speed * (body as RigidBody3D).mass)",
		"\telif body is CharacterBody2D:",
		"\t\t(body as CharacterBody2D).velocity += (way as Vector2) * speed",
		"\telif body is CharacterBody3D:",
		"\t\t(body as CharacterBody3D).velocity += (way as Vector3) * speed",
		"\telse:",
		"\t\t_card_missing(card, \"points at something that is not a physics body\")",
		"",
		"## A steady force on a RigidBody for a time, taken away again when the time is up or on Restore.",
		"func _force_for_a_time(card: Dictionary, seconds: float) -> void:",
		"\tvar body: Node = _body_of(card)",
		"\tif body == null:",
		"\t\treturn",
		"\tvar force: Variant = Vector3(float(card.get(\"x\", 0.0)), float(card.get(\"y\", -400.0)), float(card.get(\"z\", 0.0)))",
		"\tif body is RigidBody2D:",
		"\t\tforce = Vector2((force as Vector3).x, (force as Vector3).y)",
		"\t\t(body as RigidBody2D).add_constant_central_force(force)",
		"\telif body is RigidBody3D:",
		"\t\t(body as RigidBody3D).add_constant_central_force(force)",
		"\telse:",
		"\t\t_card_missing(card, \"points at something that is not a RigidBody\")",
		"\t\treturn",
		"\tvar held: Dictionary = {\"body\": body, \"force\": force}",
		"\t_held_forces.append(held)",
		"\tget_tree().create_timer(maxf(seconds, 0.0)).timeout.connect(_release_force.bind(held))",
		"",
		"## Takes one held force off its body, once.",
		"func _release_force(held: Dictionary) -> void:",
		"\tif not _held_forces.has(held):",
		"\t\treturn",
		"\t_held_forces.erase(held)",
		"\tvar body: Object = held.get(\"body\") as Object",
		"\tif body == null or not is_instance_valid(body):",
		"\t\treturn",
		"\tif body is RigidBody2D:",
		"\t\t(body as RigidBody2D).add_constant_central_force(-(held[\"force\"] as Vector2))",
		"\telif body is RigidBody3D:",
		"\t\t(body as RigidBody3D).add_constant_central_force(-(held[\"force\"] as Vector3))",
		"",
		"## Takes every held force off, at once.",
		"func _release_forces() -> void:",
		"\tfor held: Dictionary in _held_forces.duplicate():",
		"\t\t_release_force(held)",
		"",
		"## A different gravity scale on a RigidBody for a time, then the one it had.",
		"func _gravity_for_a_time(card: Dictionary, seconds: float) -> void:",
		"\tvar body: Node = _body_of(card)",
		"\tif body == null:",
		"\t\treturn",
		"\tif not (body is RigidBody2D or body is RigidBody3D):",
		"\t\t_card_missing(card, \"points at something that is not a RigidBody\")",
		"\t\treturn",
		"\tvar before: Variant = _remember(body, \"gravity_scale\")",
		"\tbody.set(\"gravity_scale\", float(card.get(\"amount\", 0.2)))",
		"\tget_tree().create_timer(maxf(seconds, 0.0)).timeout.connect(func() -> void:",
		"\t\tif is_instance_valid(body):",
		"\t\t\tbody.set(\"gravity_scale\", before))",
		"",
		"## Holds a RigidBody still for a time. Freezing is not allowed in the middle of a physics step, so it",
		"## is asked for at the end of the frame.",
		"func _freeze_body(card: Dictionary, seconds: float) -> void:",
		"\tvar body: Node = _body_of(card)",
		"\tif body == null:",
		"\t\treturn",
		"\tif not (body is RigidBody2D or body is RigidBody3D):",
		"\t\t_card_missing(card, \"points at something that is not a RigidBody\")",
		"\t\treturn",
		"\tvar before: Variant = _remember(body, \"freeze\")",
		"\tbody.set_deferred(\"freeze\", true)",
		"\tget_tree().create_timer(maxf(seconds, 0.0)).timeout.connect(func() -> void:",
		"\t\tif is_instance_valid(body):",
		"\t\t\tbody.set_deferred(\"freeze\", before))",
		"",
		"## Squash and stretch, a position kick or a rotation kick, done by the Juice node beside this one.",
		"func _punch_through_juice(word: String, card: Dictionary, at: float, seconds: float) -> void:",
		"\tvar juice: Node = _juice()",
		"\tif juice == null:",
		"\t\treturn",
		"\tmatch word:",
		"\t\tSQUASH_STRETCH:",
		"\t\t\tjuice.call(\"squash_and_stretch\", float(card.get(\"amount\", 0.3)) * at, seconds)",
		"\t\tPUNCH_POSITION:",
		"\t\t\tjuice.call(\"punch_position\", Vector2(float(card.get(\"x\", 0.0)), float(card.get(\"y\", -10.0))) * at, seconds)",
		"\t\tPUNCH_ROTATION:",
		"\t\t\tjuice.call(\"punch_rotation\", float(card.get(\"amount\", 10.0)) * at, seconds)",
		"",
		"## Scales a node up from its middle and lets it settle back.",
		"func _pop(card: Dictionary, seconds: float) -> void:",
		"\tvar target: Node = _target(card, \"node\", true)",
		"\tif target == null or not (\"scale\" in target):",
		"\t\t_card_missing(card, \"points at no node that can be scaled\")",
		"\t\treturn",
		"\tif target is Control:",
		"\t\t(target as Control).pivot_offset = (target as Control).size / 2.0",
		"\tvar rest: Variant = _remember(target, \"scale\")",
		"\tvar peak: float = float(card.get(\"amount\", 1.3))",
		"\tvar made: Tween = _new_tween()",
		"\tmade.tween_property(target, \"scale\", rest * peak, seconds * 0.4).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)",
		"\tmade.tween_property(target, \"scale\", rest, seconds * 0.6).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)",
		"",
		"## Fades a node to an alpha through its modulate.",
		"func _fade(card: Dictionary, seconds: float) -> void:",
		"\tvar target: Node = _target(card, \"node\", true)",
		"\tif not (target is CanvasItem):",
		"\t\t_card_missing(card, \"points at no node that can be faded\")",
		"\t\treturn",
		"\t_remember(target, \"modulate\")",
		"\t_new_tween().tween_property(target, \"modulate:a\", float(card.get(\"amount\", 0.0)), seconds)",
		"",
		"## Gives a Control the keyboard and gamepad focus.",
		"func _grab_focus(card: Dictionary) -> void:",
		"\tvar target: Control = _target(card, \"node\", false) as Control",
		"\tif target == null:",
		"\t\t_card_missing(card, \"points at no control\")",
		"\t\treturn",
		"\ttarget.grab_focus()",
		"",
		"## A label counts from the number it shows to a number.",
		"func _count_to(card: Dictionary, seconds: float) -> void:",
		"\tvar target: Node = _target(card, \"node\", false)",
		"\tvar goal: Variant = _number_from(str(card.get(\"to\", \"\")))",
		"\tif target == null or not (\"text\" in target):",
		"\t\t_card_missing(card, \"points at no label\")",
		"\t\treturn",
		"\tif goal == null:",
		"\t\t_card_missing(card, \"names a number that is not there (\\\"%s\\\")\" % str(card.get(\"to\", \"\")))",
		"\t\treturn",
		"\t_remember(target, \"text\")",
		"\tvar shown: String = str(target.get(\"text\")).strip_edges()",
		"\tvar from: float = shown.to_float() if shown.is_valid_float() else 0.0",
		"\t_new_tween().tween_method(func(value: float) -> void:",
		"\t\tif is_instance_valid(target):",
		"\t\t\ttarget.set(\"text\", str(int(round(value)))), from, float(goal), seconds)",
		"",
		"## The letters of a label appear one after another over the card's seconds.",
		"func _reveal_text(card: Dictionary, seconds: float) -> void:",
		"\tvar target: Node = _target(card, \"node\", false)",
		"\tif target == null or not (\"visible_ratio\" in target):",
		"\t\t_card_missing(card, \"points at no label\")",
		"\t\treturn",
		"\t_remember(target, \"visible_ratio\")",
		"\ttarget.set(\"visible_ratio\", 0.0)",
		"\t# A card that holds a speed (letters a second) reveals the text the label holds right now at that",
		"\t# speed; a card with only seconds takes exactly that long.",
		"\tvar span: float = seconds",
		"\tvar speed: float = float(card.get(\"speed\", 0.0))",
		"\tif speed > 0.0:",
		"\t\tspan = float(str(target.get(\"text\")).length()) / speed",
		"\t_new_tween().tween_property(target, \"visible_ratio\", 1.0, span)",
		"",
		"## A bar or slider glides to a number.",
		"func _fill_bar(card: Dictionary, seconds: float) -> void:",
		"\tvar target: Range = _target(card, \"node\", false) as Range",
		"\tvar goal: Variant = _number_from(str(card.get(\"to\", \"\")))",
		"\tif target == null:",
		"\t\t_card_missing(card, \"points at no bar\")",
		"\t\treturn",
		"\tif goal == null:",
		"\t\t_card_missing(card, \"names a number that is not there (\\\"%s\\\")\" % str(card.get(\"to\", \"\")))",
		"\t\treturn",
		"\t_remember(target, \"value\")",
		"\t_new_tween().tween_property(target, \"value\", float(goal), seconds)",
		"",
		"## The shader material of a node: a CanvasItem's material, or a 3D object's material override.",
		"static func _shader_material_of(target: Node) -> ShaderMaterial:",
		"\tif target is CanvasItem:",
		"\t\treturn (target as CanvasItem).material as ShaderMaterial",
		"\tif target is GeometryInstance3D:",
		"\t\treturn (target as GeometryInstance3D).material_override as ShaderMaterial",
		"\treturn null",
		"",
		"## Moves one value of the shader on a node. With \"only this object\" on, the node gets a copy of its",
		"## material to itself first, so the others that share the file are left alone; Restore gives the node",
		"## its own material back.",
		"func _shader_value(card: Dictionary, seconds: float) -> void:",
		"\tvar target: Node = _target(card, \"node\", true)",
		"\tvar shared: ShaderMaterial = _shader_material_of(target) if target != null else null",
		"\tvar value_name: String = str(card.get(\"parameter\", \"\"))",
		"\tif shared == null or shared.shader == null or value_name.is_empty():",
		"\t\t_card_missing(card, \"points at no node with a shader to move\")",
		"\t\treturn",
		"\tvar material: ShaderMaterial = shared",
		"\tif bool(card.get(\"only_this\", true)):",
		"\t\tvar key: int = target.get_instance_id()",
		"\t\tif not _own_materials.has(key) or not is_instance_valid(_own_materials[key]):",
		"\t\t\t_own_materials[key] = shared.duplicate()",
		"\t\t\tvar slot: String = \"material\" if target is CanvasItem else \"material_override\"",
		"\t\t\t_remember(target, slot)",
		"\t\t\ttarget.set(slot, _own_materials[key])",
		"\t\tmaterial = _own_materials[key]",
		"\tvar property: String = \"shader_parameter/\" + value_name",
		"\tvar before: Variant = material.get_shader_parameter(value_name)",
		"\tif before == null:",
		"\t\tbefore = RenderingServer.shader_get_parameter_default(material.shader.get_rid(), value_name)",
		"\tif before == null:",
		"\t\t_card_missing(card, \"names the shader value \\\"%s\\\", which that shader does not declare\" % value_name)",
		"\t\treturn",
		"\t_keep_first(material, property, before)",
		"\tvar goal: Variant = card.get(\"to\", before)",
		"\tvar made: Tween = _new_tween()",
		"\tvar way: Tween = made.set_trans(TRANSITIONS.get(str(card.get(\"trans\", \"sine\")), Tween.TRANS_SINE) as Tween.TransitionType)",
		"\tif bool(card.get(\"back\", false)):",
		"\t\tway.tween_property(material, property, goal, seconds * 0.5)",
		"\t\tway.tween_property(material, property, before, seconds * 0.5)",
		"\telse:",
		"\t\tway.tween_property(material, property, goal, seconds)",
		"",
		"## A property of a node walked to a value, the whole card: any node, a typed value, where it starts,",
		"## its transition and ease, and whether it comes back. Cards that hold none of these keys never reach",
		"## here and play exactly as they always did.",
		"func _tween_card(card: Dictionary, at: float, seconds: float) -> void:",
		"\tvar target: Node = _target(card, \"node\", true)",
		"\tvar property: String = str(card.get(\"effect\", \"\")).strip_edges()",
		"\tif target == null:",
		"\t\t_card_missing(card, \"points at a node that is not there\")",
		"\t\treturn",
		"\tif property.is_empty():",
		"\t\treturn",
		"\tvar before: Variant = target.get_indexed(NodePath(property))",
		"\tif before == null:",
		"\t\t_card_missing(card, \"points at %s, which has no property called \\\"%s\\\"\" % [target.name, property])",
		"\t\treturn",
		"\t_keep_first(target, property, before)",
		"\tvar goal: Variant = card.get(\"to\", float(card.get(\"amount\", 1.0)))",
		"\tvar relative: bool = bool(card.get(\"relative\", false))",
		"\t# A number is scaled by the strength of the play, as the one-number tween always was; a colour or a",
		"\t# position is a place, not an amount, so only a value added to what is there is scaled.",
		"\tif goal is float or goal is int or (relative and (goal is Vector2 or goal is Vector3)):",
		"\t\tgoal = goal * at",
		"\tif card.has(\"from\"):",
		"\t\ttarget.set_indexed(NodePath(property), card[\"from\"])",
		"\tvar made: Tween = _new_tween()",
		"\tvar shaped: Tween = made.set_trans(TRANSITIONS.get(str(card.get(\"trans\", \"linear\")), Tween.TRANS_LINEAR) as Tween.TransitionType)",
		"\tshaped.set_ease(EASES.get(str(card.get(\"ease\", \"in_out\")), Tween.EASE_IN_OUT) as Tween.EaseType)",
		"\tvar there: PropertyTweener = shaped.tween_property(target, NodePath(property), goal, seconds * (0.5 if bool(card.get(\"back\", false)) else 1.0))",
		"\tif relative:",
		"\t\tthere.as_relative()",
		"\tif bool(card.get(\"back\", false)):",
		"\t\tshaped.tween_property(target, NodePath(property), before, seconds * 0.5)",
		"",
		"## Whether a Tween Property card holds any of the keys that make it the whole card. A card that holds",
		"## none of them is the one-number tween on this object it has always been.",
		"static func _is_whole_tween(card: Dictionary) -> bool:",
		"\tfor key: String in [\"node\", \"to\", \"from\", \"trans\", \"ease\", \"relative\", \"back\"]:",
		"\t\tif card.has(key):",
		"\t\t\treturn true",
		"\treturn false",
		"",
		"## Whether the card names a node under this key at all.",
		"static func _names_a_node(card: Dictionary, key: String) -> bool:",
		"\treturn not _path_of(card, key).is_empty()",
		"",
		"## Fires a signal of a node, with the values the card holds.",
		"func _emit_on_node(card: Dictionary) -> void:",
		"\tvar target: Node = _target(card, \"node\", false)",
		"\tvar wanted: String = str(card.get(\"signal\", \"\"))",
		"\tif target == null or not target.has_signal(wanted):",
		"\t\t_card_missing(card, \"points at no node with a signal called \\\"%s\\\"\" % wanted)",
		"\t\treturn",
		"\tvar given: Variant = card.get(\"args\", [])",
		"\ttarget.callv(\"emit_signal\", [wanted] + (given as Array if given is Array else []))",
		"",
		"## The player a Play Player card plays: the one it picked, else the one its old typed name finds. Said",
		"## once, and refused, when it is this player itself or a player that is playing this one.",
		"func _player_to_play(card: Dictionary, typed: String) -> Node:",
		"\tvar other: Node = null",
		"\tif _names_a_node(card, \"player\"):",
		"\t\tother = _target(card, \"player\", false)",
		"\t\tif other == null:",
		"\t\t\t_card_missing(card, \"points at no Juice Player\")",
		"\t\t\treturn null",
		"\telse:",
		"\t\tother = get_node_or_null(NodePath(typed))",
		"\tif other == self or (other != null and _plays_through(other, self, 0)):",
		"\t\t_card_missing(card, \"would play a player that is already playing it\")",
		"\t\treturn null",
		"\treturn other",
		"",
		"## Whether `from` is playing, through the players it started, the one named `wanted`. The depth is a",
		"## guard against a ring of players that has no end.",
		"static func _plays_through(from: Node, wanted: Node, depth: int) -> bool:",
		"\tif depth > 8 or from.get(\"playing\") != true:",
		"\t\treturn false",
		"\tvar started: Variant = from.get(\"_nested\")",
		"\tif not (started is Array):",
		"\t\treturn false",
		"\tfor other: Variant in (started as Array):",
		"\t\tif other == wanted or (other is Node and _plays_through(other as Node, wanted, depth + 1)):",
		"\t\t\treturn true",
		"\treturn false"
	])
