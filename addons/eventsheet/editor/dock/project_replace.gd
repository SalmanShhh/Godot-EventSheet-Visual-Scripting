# Godot EventSheets - Replace in Project: the plan, the guarded write and the way back
#
# The Find in Project window lists what a replace WOULD change and this file is what happens when the
# button is pressed. It is loaded by path from the window (no class_name), so the editor's first open
# does not compile it.
#
# THREE RULES live here:
#   1. Event sheets and scripts you wrote are different things. A `.tres` sheet, a `.gd` that carries
#      the plugin's own markers and any file open in a tab are sheets, ticked by default. Every other
#      `.gd` is a script, listed in its own group and NOT ticked, so pressing the button with the
#      defaults never rewrites a comment or a string in somebody's hand-written code.
#   2. A file is only ever written once the result is known to be good: a sheet must still reopen and
#      re-emit as exactly what is written, a script must still parse. Otherwise it is skipped, counted
#      and left as it was.
#   3. Every file written is also kept, in a set of its own under the plugin's backups, so one action
#      can put exactly that replace back. A file changed by hand since is left alone.
@tool
extends RefCounted

const SETS_ROOT: String = "user://eventsheet_backups/_replace_sets"
## How many replaces are kept to be put back; the oldest set goes when a newer one lands.
const KEEP_SETS: int = 5
## The list shows this many files per group and this many lines per file; the rest are counted. A
## project of thousands of scripts must not become thousands of rows in a window.
const MAX_FILES_SHOWN: int = 100
const MAX_LINES_SHOWN: int = 3
const KIND_SHEET: String = "sheet"
const KIND_SCRIPT: String = "script"
const KIND_PACK: String = "pack"
const IMPORTER_PATH: String = "res://addons/eventforge/importer/gdscript_importer.gd"
const PARSE_PATH: String = "res://addons/eventsheet/editor/interaction/migration_plan.gd"
## What only a compiled sheet has: the banner the compiler writes as the first line. The `# @ace_`
## annotations are NOT a marker, because a hand-written script carries them too (the "Use in event
## sheets" door writes them into the user's own file).
const SHEET_BANNER: String = "# AUTO-GENERATED by EventForge"


## "sheet", "script" or "pack" for one file with matches, decided by what the file says about itself and
## never by whether it is open in a tab: a hand-written script that is merely open stays a script (and
## so starts unticked), while a sheet stored as `.gd` with none of the plugin's markers is listed with
## the scripts too, which the window says. `_open_paths` is kept so callers need not change.
static func kind_of(path: String, source: String, _open_paths: Dictionary = {}) -> String:
	if EventSheetProjectFind.is_pack_script(path):
		return KIND_PACK
	if path.get_extension().to_lower() != "gd":
		return KIND_SHEET
	return KIND_SHEET if has_sheet_marker(source) else KIND_SCRIPT


## True when a script's text starts with the banner the compiler writes into every sheet it emits.
static func has_sheet_marker(source: String) -> bool:
	return source.begins_with(SHEET_BANNER)


## Whether a file of this kind starts ticked.
static func default_ticked(kind: String) -> bool:
	return kind == KIND_SHEET


## Groups the matches Find returned into one entry per file, in the order Find gave them:
## [{path, kind, hits, places, open, lines: [{where, before, after}], more}]. `hits` counts the places
## the replace would change (Find ignores case, a replace does not, so a place that differs only in
## case is found but not counted).
static func plan(found: Array, needle: String, replacement: String, open_paths: Dictionary,
		markers: Dictionary = {}) -> Array[Dictionary]:
	var entries: Array[Dictionary] = []
	var by_path: Dictionary = {}
	var line_format: String = EventSheetL10n.translate("line %d")
	for match_entry: Dictionary in found:
		var path: String = str(match_entry.get("path", ""))
		if not by_path.has(path):
			var kind: String = ""
			if markers.has(path) and not EventSheetProjectFind.is_pack_script(path):
				# Find already read this file and noted what it says about itself.
				kind = KIND_SHEET if bool(markers[path]) else KIND_SCRIPT
			else:
				var source: String = ""
				if path.get_extension().to_lower() == "gd" and not EventSheetProjectFind.is_pack_script(path):
					source = FileAccess.get_file_as_string(path)
				kind = kind_of(path, source, open_paths)
			by_path[path] = entries.size()
			entries.append({"path": path, "kind": kind, "hits": 0,
				"places": 0, "open": open_paths.has(path), "lines": [], "more": 0})
		var entry: Dictionary = entries[int(by_path[path])]
		entry["places"] = int(entry["places"]) + 1
		var preview: String = str(match_entry.get("preview", ""))
		if not preview.contains(needle):
			continue
		entry["hits"] = int(entry["hits"]) + 1
		if (entry["lines"] as Array).size() < MAX_LINES_SHOWN:
			(entry["lines"] as Array).append({
				"where": _where(match_entry, line_format),
				"before": preview, "after": preview.replace(needle, replacement)})
		else:
			entry["more"] = int(entry["more"]) + 1
	return entries


## Where a match is, in the words the Event column uses (translated once for the whole plan).
static func _where(match_entry: Dictionary, line_format: String) -> String:
	if int(match_entry.get("event", 0)) > 0:
		return str(int(match_entry["event"]))
	if int(match_entry.get("line", 0)) > 0:
		return line_format % int(match_entry["line"])
	return "-"


## The entries a press of the button writes: ticked, with something to change, never a pack. `ticks`
## ({path: bool}) holds only what the reader changed; the rest follows the kind's default.
static func selected(entries: Array[Dictionary], ticks: Dictionary) -> Array[Dictionary]:
	var chosen: Array[Dictionary] = []
	for entry: Dictionary in entries:
		if str(entry["kind"]) == KIND_PACK or int(entry["hits"]) <= 0:
			continue
		if bool(ticks.get(str(entry["path"]), default_ticked(str(entry["kind"])))):
			chosen.append(entry)
	return chosen


## The count line: sheets and scripts apart, so a reader sees which of the two a press will touch.
static func summary(entries: Array[Dictionary], ticks: Dictionary) -> String:
	var sheets: int = 0
	var scripts: int = 0
	var places: int = 0
	for entry: Dictionary in selected(entries, ticks):
		places += int(entry["hits"])
		if str(entry["kind"]) == KIND_SHEET:
			sheets += 1
		else:
			scripts += 1
	return EventSheetL10n.translate("%d place(s) will change: %d sheet(s) and %d script(s) you wrote.") % [places, sheets, scripts]


## Writes every entry in `chosen` that is not open in a tab (an open tab changes through its own undo
## step, which the window drives). Returns {id, written: [{path, hits}], skipped: [paths a bad result
## kept from being written], failed: [paths that could not be saved]}. `replace_rows` is the find bar's
## row walk, so a sheet changes exactly what Replace All changes in an open one.
static func apply_closed(chosen: Array[Dictionary], needle: String, replacement: String,
		replace_rows: Callable) -> Dictionary:
	var skipped: PackedStringArray = PackedStringArray()
	var failed: PackedStringArray = PackedStringArray()
	var outcome: Dictionary = {"id": "", "written": [], "skipped": skipped, "failed": failed}
	if needle.is_empty():
		return outcome
	var set_id: String = _new_set_id()
	var kept: Array = []
	for entry: Dictionary in chosen:
		if bool(entry["open"]):
			continue
		var path: String = str(entry["path"])
		var before_bytes: PackedByteArray = FileAccess.get_file_as_bytes(path)
		var is_script_file: bool = path.get_extension().to_lower() == "gd"
		var after_bytes: PackedByteArray = PackedByteArray()
		var sheet: EventSheetResource = null
		if is_script_file:
			after_bytes = _rewritten_text(path, before_bytes, needle, replacement)
			if after_bytes.is_empty():
				skipped.append(path)
				continue
		else:
			sheet = _rewritten_sheet(path, needle, replacement, replace_rows)
			if sheet == null:
				skipped.append(path)
				continue
		var copy_name: String = "%04d.bak" % kept.size()
		if not _keep_copy(set_id, copy_name, before_bytes):
			failed.append(path)
			continue
		EventSheetBackups.backup_sheet(path)
		var landed: bool = false
		if is_script_file:
			var handle: FileAccess = FileAccess.open(path, FileAccess.WRITE)
			if handle != null:
				handle.store_buffer(after_bytes)
				landed = handle.get_error() == OK
				handle.close()
		else:
			landed = ResourceSaver.save(sheet, path) == OK
			landed = landed and ResourceLoader.load(path, "", ResourceLoader.CACHE_MODE_IGNORE) is EventSheetResource
			if not landed:
				_write_bytes(path, before_bytes)
		if not landed:
			failed.append(path)
			continue
		kept.append({"path": path, "copy": copy_name, "after": FileAccess.get_sha256(path)})
		(outcome["written"] as Array).append({"path": path, "hits": int(entry["hits"])})
		_tell_editor(path)
	outcome["skipped"] = skipped
	outcome["failed"] = failed
	if not kept.is_empty():
		_write_manifest(set_id, kept)
		_prune_sets()
		outcome["id"] = set_id
	return outcome


## What a `.gd` would hold after the replace, or an empty array when the new text is not good enough
## to write (a script that stopped parsing, a sheet that would not reopen as itself) or nothing changes.
static func _rewritten_text(path: String, before: PackedByteArray, needle: String, replacement: String) -> PackedByteArray:
	var source: String = before.get_string_from_utf8()
	if not source.contains(needle):
		return PackedByteArray()
	var text: String = source.replace(needle, replacement)
	if not _still_good(path, source, text):
		return PackedByteArray()
	return text.to_utf8_buffer()


## A `.tres` sheet with the replace made in memory (read past the cache, so a failed write leaves the
## loaded copy alone), or null when it has nothing to change.
static func _rewritten_sheet(path: String, needle: String, replacement: String, replace_rows: Callable) -> EventSheetResource:
	var sheet: EventSheetResource = ResourceLoader.load(path, "", ResourceLoader.CACHE_MODE_IGNORE) as EventSheetResource
	if sheet == null:
		return null
	var counter: Dictionary = {"count": 0}
	replace_rows.call(sheet.events, needle, replacement, counter)
	for function_entry: Variant in sheet.functions:
		if function_entry is EventFunction:
			var event_function: EventFunction = function_entry as EventFunction
			replace_rows.call(event_function.events if not event_function.events.is_empty()
				else event_function.rows, needle, replacement, counter)
	return sheet if int(counter.get("count", 0)) > 0 else null


static func _write_bytes(path: String, bytes: PackedByteArray) -> void:
	var handle: FileAccess = FileAccess.open(path, FileAccess.WRITE)
	if handle != null:
		handle.store_buffer(bytes)
		handle.close()


## True when the new text of a `.gd` is as good as the old one was: a script still parses, and a sheet
## still reopens and re-emits as exactly what is written.
static func _still_good(path: String, before: String, after: String) -> bool:
	var parser: GDScript = load(PARSE_PATH)
	if parser.parses(before) and not parser.parses(after):
		return false
	var kind: String = kind_of(path, before, {})
	if kind != KIND_SHEET:
		return true
	if _reemit(path, before) == before:
		return _reemit(path, after) == after
	return true


static func _reemit(path: String, text: String) -> String:
	var reopened: EventSheetResource = load(IMPORTER_PATH).new().import_external_source(text, true, path)
	if reopened == null:
		return ""
	reopened.external_source_path = path
	return str(EventSheetCompiler.echo(reopened).get("output", ""))


## Puts the newest set back: {restored, changed_since: [paths left alone], missing}. A file is
## restored only if it is still exactly what the replace wrote.
static func put_back(set_id: String) -> Dictionary:
	var changed: PackedStringArray = PackedStringArray()
	var outcome: Dictionary = {"restored": 0, "changed_since": changed, "missing": 0}
	var manifest: Array = read_manifest(set_id)
	for item: Variant in manifest:
		var entry: Dictionary = item as Dictionary
		var path: String = str(entry.get("path", ""))
		var copy_path: String = "%s/%s/%s" % [SETS_ROOT, set_id, str(entry.get("copy", ""))]
		if not FileAccess.file_exists(copy_path):
			outcome["missing"] = int(outcome["missing"]) + 1
			continue
		if FileAccess.get_sha256(path) != str(entry.get("after", "")):
			changed.append(path)
			continue
		_write_bytes(path, FileAccess.get_file_as_bytes(copy_path))
		outcome["restored"] = int(outcome["restored"]) + 1
		_tell_editor(path)
	outcome["changed_since"] = changed
	return outcome


## Puts the newest set back and says what happened, in a sentence the status line can carry.
static func put_back_newest() -> String:
	var ids: PackedStringArray = list_sets()
	if ids.is_empty():
		return EventSheetL10n.translate("There is no Replace in Project to put back.")
	var outcome: Dictionary = put_back(ids[0])
	discard_set(ids[0])
	var told: String = EventSheetL10n.translate("Put back %d file(s) as they were before the replace.") % int(outcome["restored"])
	var changed: PackedStringArray = outcome["changed_since"]
	if not changed.is_empty():
		told += " " + EventSheetL10n.translate("%d file(s) changed since and were left alone.") % changed.size()
	return told


## What Put them all back would restore, in one plain sentence: how many files and when the replace
## wrote them. Empty when there is nothing to put back. The window and Sheet Backups both say it.
static func newest_set_line() -> String:
	var ids: PackedStringArray = list_sets()
	if ids.is_empty():
		return ""
	var count: int = read_manifest(ids[0]).size()
	var stamp: String = ids[0]
	var when: String = EventSheetL10n.translate("today")
	if stamp.length() >= 13:
		var day: String = stamp.substr(0, 8)
		if day != Time.get_date_string_from_system().replace("-", ""):
			when = "%s-%s-%s" % [day.substr(0, 4), day.substr(4, 2), day.substr(6, 2)]
		when += " %s:%s" % [stamp.substr(9, 2), stamp.substr(11, 2)]
	return EventSheetL10n.translate("Put them all back restores %d file(s) the last Replace in Project wrote, %s.") % [count, when]


## Removes a set's copies once it has been put back.
static func discard_set(set_id: String) -> void:
	var folder: String = "%s/%s" % [SETS_ROOT, set_id]
	var directory: DirAccess = DirAccess.open(folder)
	if directory != null:
		for file_name: String in directory.get_files():
			DirAccess.remove_absolute("%s/%s" % [folder, file_name])
	DirAccess.remove_absolute(folder)


## The sets that can still be put back, newest first.
static func list_sets() -> PackedStringArray:
	var ids: PackedStringArray = PackedStringArray()
	var directory: DirAccess = DirAccess.open(SETS_ROOT)
	if directory == null:
		return ids
	for folder: String in directory.get_directories():
		if FileAccess.file_exists("%s/%s/manifest.json" % [SETS_ROOT, folder]):
			ids.append(folder)
	ids.sort()
	ids.reverse()
	return ids


static func read_manifest(set_id: String) -> Array:
	var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string("%s/%s/manifest.json" % [SETS_ROOT, set_id]))
	return (parsed as Array) if parsed is Array else []


static func _write_manifest(set_id: String, kept: Array) -> void:
	var handle: FileAccess = FileAccess.open("%s/%s/manifest.json" % [SETS_ROOT, set_id], FileAccess.WRITE)
	if handle != null:
		handle.store_string(JSON.stringify(kept))
		handle.close()


static func _keep_copy(set_id: String, copy_name: String, bytes: PackedByteArray) -> bool:
	DirAccess.make_dir_recursive_absolute("%s/%s" % [SETS_ROOT, set_id])
	var handle: FileAccess = FileAccess.open("%s/%s/%s" % [SETS_ROOT, set_id, copy_name], FileAccess.WRITE)
	if handle == null:
		return false
	handle.store_buffer(bytes)
	handle.close()
	return true


static func _prune_sets() -> void:
	var ids: PackedStringArray = list_sets()
	for index: int in range(KEEP_SETS, ids.size()):
		discard_set(ids[index])


## Sortable, unique within a machine's clock and a run: the time to the second, then a counter for a
## second replace in the same second.
static func _new_set_id() -> String:
	var stamp: String = Time.get_datetime_string_from_system().replace("-", "").replace(":", "").replace("T", "_")
	var id: String = stamp
	var suffix: int = 1
	while DirAccess.dir_exists_absolute("%s/%s" % [SETS_ROOT, id]):
		suffix += 1
		id = "%s_%d" % [stamp, suffix]
	return id


## Tells the editor a file changed under it, so the FileSystem dock and any loaded copy follow.
static func _tell_editor(path: String) -> void:
	if Engine.is_editor_hint() and Engine.has_singleton("EditorInterface"):
		var filesystem: Object = (Engine.get_singleton("EditorInterface") as Object).call("get_resource_filesystem")
		if filesystem != null:
			filesystem.call("update_file", path)
