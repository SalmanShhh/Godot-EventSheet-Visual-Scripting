	descriptors.append(F.expr("GetCurrentAnimation", "Get Current Animation", "current_animation", "General Expressions", "current_animation", "Returns the name of the animation currently playing.", "AnimationPlayer"))

	# ── More Array helpers (make list manipulation easy without dropping to code) ──
	descriptors.append(F.expr("ArrayFront", "First Item", "{var_name}.front()", "Variables: Array", "{var_name}.front()", "Returns the first item in the array.").param("var_name", "list", "Array", "Array variable.", "variable_reference:Array"))
	descriptors.append(F.expr("ArrayBack", "Last Item", "{var_name}.back()", "Variables: Array", "{var_name}.back()", "Returns the last item in the array.").param("var_name", "list", "Array", "Array variable.", "variable_reference:Array"))
	descriptors.append(F.expr("ArrayFind", "Index Of", "{var_name}.find({value})", "Variables: Array", "{var_name}.find({value})", "Returns the position of a value in the array, or -1 if it's missing.").param("var_name", "list", "Array", "Array variable.", "variable_reference:Array").param("value", "0", "Value", "Value to find (-1 if missing).", "expression"))
	descriptors.append(F.expr("ArrayCount", "Count Of", "{var_name}.count({value})", "Variables: Array", "{var_name}.count({value})", "Returns how many times a value appears in the array.").param("var_name", "list", "Array", "Array variable.", "variable_reference:Array").param("value", "0", "Value", "Value to count.", "expression"))
	descriptors.append(F.act("ArrayReverse", "Reverse Array", "{var_name}.reverse()", "Variables: Array", "Reverse {var_name}", "Flips the array so its items run in the opposite order.").param("var_name", "list", "Array", "Array variable.", "variable_reference:Array"))
	descriptors.append(F.act("ArrayPushFront", "Push Front", "{var_name}.push_front({value})", "Variables: Array", "Push front {value} to {var_name}", "Inserts a value at the start of the array, shifting the rest along.").param("var_name", "list", "Array", "Array variable.", "variable_reference:Array").param("value", "0", "Value", "Value to prepend.", "expression"))
	descriptors.append(F.expr("ArrayPopBack", "Pop Back", "{var_name}.pop_back()", "Variables: Array", "{var_name}.pop_back()", "Removes and returns the last item of the array.").param("var_name", "list", "Array", "Array variable (removes + returns last).", "variable_reference:Array"))
	descriptors.append(F.expr("ArrayPopFront", "Pop Front", "{var_name}.pop_front()", "Variables: Array", "{var_name}.pop_front()", "Removes and returns the first item of the array.").param("var_name", "list", "Array", "Array variable (removes + returns first).", "variable_reference:Array"))
	descriptors.append(F.act("ArrayAppendArray", "Append Array", "{var_name}.append_array({other})", "Variables: Array", "Append {other} to {var_name}", "Adds every item from another array onto the end of this one.").param("var_name", "list", "Array", "Destination array.", "variable_reference:Array").param("other", "[]", "Other", "Array whose items are appended.", "expression"))
	descriptors.append(F.expr("ArraySlice", "Slice", "{var_name}.slice({from}, {to})", "Variables: Array", "{var_name}.slice({from}, {to})", "Returns a sub-section of the array between the start and end indexes.").param("var_name", "list", "Array", "Array variable.", "variable_reference:Array").param("from", "0", "From", "Start index.", "expression").param("to", "1", "To", "End index (exclusive).", "expression"))
	descriptors.append(F.expr("ArrayJoin", "Join To Text", "{separator}.join({var_name})", "Variables: Array", "join {var_name} with {separator}", "Joins an array of strings into one text using a separator.").param("var_name", "list", "Array", "Array of strings.", "variable_reference:Array").param("separator", "\", \"", "Separator", "String between items.", "expression"))
	descriptors.append(F.expr("ArrayMax", "Array Max", "{var_name}.max()", "Variables: Array", "{var_name}.max()", "Returns the largest value found in the array.").param("var_name", "list", "Array", "Array variable.", "variable_reference:Array"))
	descriptors.append(F.expr("ArrayMin", "Array Min", "{var_name}.min()", "Variables: Array", "{var_name}.min()", "Returns the smallest value found in the array.").param("var_name", "list", "Array", "Array variable.", "variable_reference:Array"))
	descriptors.append(F.expr("ArrayDuplicate", "Copy Array", "{var_name}.duplicate()", "Variables: Array", "{var_name}.duplicate()", "Returns an independent copy of the array so edits don't affect the original.").param("var_name", "list", "Array", "Array variable to copy.", "variable_reference:Array"))
	descriptors.append(F.act("ArrayResize", "Resize Array", "{var_name}.resize({size})", "Variables: Array", "Resize {var_name} to {size}", "Changes the array's length, adding empty slots or trimming items.").param("var_name", "list", "Array", "Array variable.", "variable_reference:Array").param("size", "0", "Size", "New length.", "expression"))
	descriptors.append(F.act("ArrayFill", "Fill Array", "{var_name}.fill({value})", "Variables: Array", "Fill {var_name} with {value}", "Sets every slot in the array to the same value.").param("var_name", "list", "Array", "Array variable.", "variable_reference:Array").param("value", "0", "Value", "Value to fill every slot with.", "expression"))

	# ── More Dictionary helpers ──
	descriptors.append(F.expr("DictDuplicate", "Copy Dictionary", "{var_name}.duplicate()", "Variables: Dictionary", "{var_name}.duplicate()", "Returns an independent copy of the dictionary.").param("var_name", "dict", "Dictionary", "Dictionary variable to copy.", "variable_reference:Dictionary"))
	descriptors.append(F.cond("DictHasValue", "Has Value", "{var_name}.values().has({value})", "Variables: Dictionary", "{var_name} has value {value}", "True when the dictionary contains the given value anywhere.").param("var_name", "dict", "Dictionary", "Dictionary variable.", "variable_reference:Dictionary").param("value", "0", "Value", "Value to look for.", "expression"))

	# ── Vector helpers (Vector2/Vector3 manipulation) ──
	descriptors.append(F.expr("MakeVector2", "Make Vector2", "Vector2({x}, {y})", "Variables: Vector", "Vector2({x}, {y})", "Builds a Vector2 from separate x and y numbers, for positions or directions.").param("x", "0.0", "X", "X component.", "expression").param("y", "0.0", "Y", "Y component.", "expression"))
	descriptors.append(F.expr("MakeVector3", "Make Vector3", "Vector3({x}, {y}, {z})", "Variables: Vector", "Vector3({x}, {y}, {z})", "Builds a 3D point or direction from X, Y and Z numbers.").param("x", "0.0", "X", "X component.", "expression").param("y", "0.0", "Y", "Y component.", "expression").param("z", "0.0", "Z", "Z component.", "expression"))
	descriptors.append(F.expr("VectorLength", "Vector Length", "{vector}.length()", "Variables: Vector", "{vector}.length()", "Returns how long a vector is, e.g. a velocity's speed.").param("vector", "Vector2.ZERO", "Vector", "Vector expression.", "expression"))
	descriptors.append(F.expr("VectorNormalized", "Normalized", "{vector}.normalized()", "Variables: Vector", "{vector}.normalized()", "Returns the vector shrunk to length 1, keeping only its direction.").param("vector", "Vector2.ZERO", "Vector", "Vector expression.", "expression"))
	descriptors.append(F.expr("VectorDistanceTo", "Distance Between", "{a}.distance_to({b})", "Variables: Vector", "{a}.distance_to({b})", "Returns the straight-line distance between two points.").param("a", "Vector2.ZERO", "From", "First point.", "expression").param("b", "Vector2.ZERO", "To", "Second point.", "expression"))
	descriptors.append(F.expr("VectorDirectionTo", "Direction To", "{a}.direction_to({b})", "Variables: Vector", "{a}.direction_to({b})", "Returns a unit vector pointing from one point toward another, handy for aiming.").param("a", "Vector2.ZERO", "From", "Start point.", "expression").param("b", "Vector2.ZERO", "To", "Target point.", "expression"))
	descriptors.append(F.expr("VectorAngle", "Vector Angle", "{vector}.angle()", "Variables: Vector", "{vector}.angle()", "Returns a 2D vector's angle in radians, useful for facing direction.").param("vector", "Vector2.ZERO", "Vector", "Vector2 expression (radians).", "expression"))
	descriptors.append(F.expr("VectorDot", "Dot Product", "{a}.dot({b})", "Variables: Vector", "{a}.dot({b})", "Returns the dot product of two vectors, telling how aligned they are.").param("a", "Vector2.ZERO", "A", "First vector.", "expression").param("b", "Vector2.ZERO", "B", "Second vector.", "expression"))
	descriptors.append(F.expr("VectorRotated", "Rotated", "{vector}.rotated({radians})", "Variables: Vector", "{vector}.rotated({radians})", "Returns the vector turned by the given angle in radians.").param("vector", "Vector2.ZERO", "Vector", "Vector2 expression.", "expression").param("radians", "0.0", "Radians", "Rotation in radians.", "expression"))
	descriptors.append(F.expr("VectorLerp", "Vector Lerp", "{a}.lerp({b}, {weight})", "Variables: Vector", "{a}.lerp({b}, {weight})", "Returns a point blended between two vectors, great for smooth movement.").param("a", "Vector2.ZERO", "From", "Start vector.", "expression").param("b", "Vector2.ZERO", "To", "End vector.", "expression").param("weight", "0.5", "Weight", "0..1 blend.", "expression"))
	descriptors.append(F.expr("VectorLimitLength", "Clamp Length", "{vector}.limit_length({max_length})", "Variables: Vector", "{vector}.limit_length({max_length})", "Returns the vector capped to a maximum length, e.g. a speed limit.").param("vector", "Vector2.ZERO", "Vector", "Vector expression.", "expression").param("max_length", "1.0", "Max length", "Maximum magnitude.", "expression"))
	# ── Named parts: ONE verb for a pair, a triple, a colour and a record alike ──
	# Make Vector2/3 BUILD vectors and Length/Angle/Normalized/Direction To read DERIVED values; until
	# now nothing named a single component, so it was Get/Set Property with a typed-in `position.x`.
	# These read as a sentence instead: "the up/down part of velocity", "the see-through part of
	# modulate". The emitted access is a subscript with a quoted key, which Godot resolves as a
	# component on Vector2/Vector3/Color AND as a field on a Dictionary - so the same row also reads
	# and writes a record's named field, and a saved {"x": …, "y": …} position needs no special case.
	# A record key OUTSIDE the seven named parts stays with the shipped Get Key (with default) / Set
	# Key, which is where an arbitrary key (and its own missing-value fallback) belongs.
	# Why a subscript rather than the `.y` a hand would write: `{var_name}.{part} = {value}` is
	# character-for-character the Set Property catch-all, and being authored in an earlier module it
	# would out-rank it in the reverse-lift index and re-label EVERY hand-written `foo.bar = baz` as
	# Set Part Of. The bracket form ties with Set Key instead, which is authored earlier here and so
	# keeps winning; nothing that lifts today changes.
	# THE PRICE of that choice, stated plainly because it is a real one: the emitted `velocity["y"] =
	# 0.0` is character-for-character what Set Key emits, so REOPENING a .gd-backed sheet lifts the
	# row back as Set Key, not as Set Part Of. The code is byte-identical either way (the lossless
	# covenant is untouched) - what is lost on a reopen is the sentence, and that is the deliberate
	# trade for never mis-labelling somebody else's `save["gold"] = 5`. Pinned in fallbacks_test.
	# The target is a PROPERTY reference, not a sheet-variable dropdown: the headline targets are a
	# node's own members (`velocity`, `modulate`), which a closed variables dropdown cannot name at
	# all. The property field is an editable autocomplete over the host class, so a sheet variable is
	# still typed in the same cell.
	descriptors.append(F.expr("PartOf", "Part Of", "({value})[{part}]", "Variables: Vector", "the {part} part of {value}", "One named piece of a pair, a triple, a colour or a record: the up/down part of a velocity (the jump-or-fall test), the see-through part of a tint, the forward/back part of a 3D direction. Reads as a sentence instead of a typed-in .y. Pick a part the value actually has - a record that might be missing the field is the shipped Get Key (with default)'s job, because that one takes a fallback and this one does not.").param("value", "Vector2(1, 2)", "Of", "A Vector2, Vector3, Color or record to read one part of.", "expression").param_built(_part_param("Which named part to read.")))
	descriptors.append(F.act("SetPartOf", "Set Part Of", "{var_name}[{part}] = {value}", "Variables: Vector", "set the {part} part of {var_name} to {value}", "Changes one named part and leaves the rest alone: zero the vertical speed on landing and keep the horizontal, flatten a 3D direction to the ground plane, fade only the see-through part of a tint. Writing a part a record does not have yet ADDS it.").param("var_name", "self.position", "Variable or property", "What to change one part of: a node's own member (velocity, modulate, position) picked from the list, or the name of a sheet variable holding a Vector, Color or record.", "property_reference").param_built(_part_param("Which named part to write.")).param("value", "0.0", "To", "The new value for that one part.", "expression"))

	# ── String helpers (the common manipulations; the long tail stays one fx away) ──
	descriptors.append(F.cond("StringContains", "Text Contains", "{text}.contains({needle})", "Variables: String", "{text} contains {needle}", "True when the text contains the given substring somewhere inside it.").param("text", "\"\"", "Text", "Text to search.", "expression").param("needle", "\"\"", "Needle", "Substring to find.", "expression"))
	descriptors.append(F.cond("StringBeginsWith", "Text Begins With", "{text}.begins_with({prefix})", "Variables: String", "{text} begins with {prefix}", "True when the text starts with the given prefix.").param("text", "\"\"", "Text", "Text to test.", "expression").param("prefix", "\"\"", "Prefix", "Expected prefix.", "expression"))
	descriptors.append(F.cond("StringEndsWith", "Text Ends With", "{text}.ends_with({suffix})", "Variables: String", "{text} ends with {suffix}", "True when the text ends with the given suffix.").param("text", "\"\"", "Text", "Text to test.", "expression").param("suffix", "\"\"", "Suffix", "Expected suffix.", "expression"))
	descriptors.append(F.expr("StringSplit", "Split Text", "{text}.split({separator})", "Variables: String", "{text}.split({separator})", "Returns the text chopped into a list wherever the separator appears.").param("text", "\"\"", "Text", "Text to split.", "expression").param("separator", "\",\"", "Separator", "Delimiter.", "expression"))
	descriptors.append(F.expr("StringToInt", "Text To Int", "{text}.to_int()", "Variables: String", "{text}.to_int()", "Returns the text parsed into a whole number.").param("text", "\"0\"", "Text", "Text to parse.", "expression"))
	descriptors.append(F.expr("StringToFloat", "Text To Float", "{text}.to_float()", "Variables: String", "{text}.to_float()", "Returns the text parsed into a decimal number.").param("text", "\"0.0\"", "Text", "Text to parse.", "expression"))
	descriptors.append(F.expr("StringPadZeros", "Pad Number", "str({number}).pad_zeros({digits})", "Variables: String", "pad {number} to {digits} digits", "Returns the number padded with leading zeros, e.g. for scores like 007.").param("number", "0", "Number", "Number to pad.", "expression").param("digits", "2", "Digits", "Minimum digit count.", "expression"))
	descriptors.append(F.expr("StringRepeat", "Repeat Text", "{text}.repeat({count})", "Variables: String", "{text} x {count}", "Returns the text repeated the given number of times.").param("text", "\"#\"", "Text", "Text to repeat.", "expression").param("count", "3", "Count", "Number of repetitions.", "expression"))

	# ── AnimationTree (event-sheet-style state machines / blends) ──
	descriptors.append(F.act("SetAnimationTreeActive", "Set AnimationTree Active", "active = {active}", "Animation", "Set tree active {active}", "Turns this AnimationTree's playback on or off.", "AnimationTree").param_choice("active", "true", "Active", "Enable the animation tree.", ["true", "false"]))
	descriptors.append(F.act("TravelToState", "Travel To State", "get(\"parameters/playback\").travel({state})", "Animation", "Travel to animation state {state}", "Tells the state machine to transition to the named animation state. This is the tree's ROOT state machine: a machine nested inside another one is not reached.", "AnimationTree").param("state", "\"idle\"", "State", "State-machine node to travel to. The list is the tree's own states.", "animation_state"))
	descriptors.append(F.act("SetTreeParam", "Set Blend", "set({path}, {value})", "Animation", "Set blend {path} to {value}", "Sets an AnimationTree parameter like a blend amount, condition or timescale.", "AnimationTree").param("path", "\"parameters/TimeScale/scale\"", "Param Path", "AnimationTree parameter path (blend amount / condition / timescale).").param("value", "1.0", "Value", "Value (number / Vector2 / bool).", "expression"))
	descriptors.append(F.cond("IsTreeActive", "Is Tree Active", "active", "Animation", "Is tree active", "True when this AnimationTree is currently active and playing.", "AnimationTree"))
	descriptors.append(F.cond("IsInState", "Is In State", "get(\"parameters/playback\").get_current_node() == {state}", "Animation", "Is in state {state}", "True when the state machine is currently in the named animation state.", "AnimationTree").param("state", "\"idle\"", "State", "State-machine node name. The list is the tree's own states.", "animation_state"))
	descriptors.append(F.expr("GetCurrentState", "Current State", "get(\"parameters/playback\").get_current_node()", "Animation", "current state", "Returns the name of the state machine's current animation state.", "AnimationTree"))
	descriptors.append(F.expr("GetTreeParam", "Tree Parameter", "get({path})", "Animation", "param {path}", "Returns the current value of an AnimationTree parameter.", "AnimationTree").param("path", "\"parameters/TimeScale/scale\"", "Param Path", "AnimationTree parameter path."))


	# The difficulty curve as a value: start, drift per minute, hard limit - drops into any
	# number param so a spawner literally accelerates over the run. Zeroed by Start Ramp Clock
	# (otherwise minutes count from engine start).
	descriptors.append(F.expr("RampedValue", "Ramped", "clampf({start} + {per_minute} * (float(Time.get_ticks_msec()) / 60000.0 - float(get_meta(&\"__ramp_zero\", 0.0))), minf({start}, {limit}), maxf({start}, {limit}))", "Math & Random", "ramped from {start} by {per_minute}/min, limit {limit}", "A value that drifts over time and stops at a limit - 'Every Ramped(2, -0.3, 0.5) seconds' is a spawner that speeds up as the run goes on. Call Start Ramp Clock when the run begins.").param("start", "2.0", "Start", "The value at minute zero.", "expression").param("per_minute", "-0.3", "Per Minute", "Drift per minute - negative ramps down.", "expression").param("limit", "0.5", "Limit", "The value never passes this.", "expression"))
	descriptors.append(F.act("StartRampClock", "Start Ramp Clock", "set_meta(&\"__ramp_zero\", float(Time.get_ticks_msec()) / 60000.0)", "Time", "start the ramp clock", "Marks minute zero for this node's Ramped values - call it when the run actually starts, not in menus."))
	# Tiles as a unit: distances in tile counts, sized by ONE project setting - so 'within
	# Tiles(3)' reads the way a grid game thinks.
	descriptors.append(F.expr("TilesUnit", "Tiles", "({count} * float(ProjectSettings.get_setting(\"eventforge/tile_size\", 16.0)))", "Math & Random", "Tiles({count})", "A distance in tiles: Tiles(3) is three tiles in pixels, sized by the eventforge/tile_size project setting (default 16). Set it once and every distance can speak in tiles.").param("count", "3", "Tiles", "How many tiles.", "expression"))
	return descriptors


## The named-part dropdown Part Of and Set Part Of share. `display_option_labels` is what keeps the
## GDScript out of the sentence: the row emits `velocity["y"]` and READS "the Y (up / down) part of
## velocity", because the emitted value here is always exactly one of the seven option keys.
static func _part_param(description: String) -> ACEParam:
	var parameter: ACEParam = F.make_param("part", "String", "\"y\"", "Part", description, "", PART_OPTIONS)
	parameter.display_option_labels = true
	return parameter
