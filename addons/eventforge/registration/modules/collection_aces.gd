# EventForge module - Collections (rich variables)
#
# Curated Dictionary/Array/JSON vocabulary - every op a direct GDScript one-liner.
# Module contract: see ace_factory.gd - ace_ids/templates are API (compatibility
# covenant); this file only changes where the descriptors are AUTHORED.
@tool
class_name EventForgeCollectionACEs
extends RefCounted

const F := preload("res://addons/eventforge/registration/ace_factory.gd")

## The named parts a pair, a triple, a colour or a record can be read and written by, shared by
## Part Of and Set Part Of so the two sides can never drift apart. The keys are QUOTED strings
## because the emitted access is a subscript (`velocity["y"]`, `save["score"]`): Godot resolves a
## string subscript as a COMPONENT on Vector2/Vector3/Color and as a FIELD on a Dictionary, which is
## what lets one verb speak about all four. The labels carry the plain-English half ("the up/down
## part" rather than ".y"). An option value can never contain a {param} placeholder - substitution
## is a single left-to-right pass, so a placeholder arriving FROM an option would be emitted
## literally into the user's GDScript.
## The warning the type-guarded fallbacks all owe the author, in the ROW's own help rather than only
## in a code comment: their guard re-reads the value expression, so a value that CHANGES something
## each time it is read (a method that consumes, deals or advances) runs twice per row.
const DOUBLE_READ_NOTE := "The value is read twice in the emitted line, so keep it a plain read and not something that changes the game."

const PART_OPTIONS: Array = [
	{"key": "\"x\"", "label": "X (left / right)"},
	{"key": "\"y\"", "label": "Y (up / down)"},
	{"key": "\"z\"", "label": "Z (forward / back)"},
	{"key": "\"r\"", "label": "Red"},
	{"key": "\"g\"", "label": "Green"},
	{"key": "\"b\"", "label": "Blue"},
	{"key": "\"a\"", "label": "Alpha (see-through)"}
]


static func get_descriptors() -> Array[ACEDescriptor]:
	var descriptors: Array[ACEDescriptor] = []

	# ── Collections (rich variables): curated Dictionary / Array / JSON vocabulary ──
	# Event sheets ship these as capability addons; here every op is a direct GDScript one-liner
	# (parity-safe) and the templates double as GDScript teachers. The long tail stays
	# one fx away. Variable params use "variable_reference:<Type>" so dropdowns offer
	# only matching (or Variant/untyped) variables.
	# Dictionary
	descriptors.append(F.act("DictSetKey", "Set Key", "{var_name}[{key}] = {value}", "Variables: Dictionary", "Set {var_name}[{key}] to {value}", "Stores a value under a key in a dictionary variable, adding or overwriting it.").param("var_name", "dict", "Dictionary", "Dictionary variable to write into.", "variable_reference:Dictionary").param("key", "\"key\"", "Key", "Key expression.", "expression").param("value", "0", "Value", "Value expression.", "expression"))
	descriptors.append(F.act("DictDeleteKey", "Delete Key", "{var_name}.erase({key})", "Variables: Dictionary", "Delete key {key} from {var_name}", "Removes a key and its value from a dictionary variable.").param("var_name", "dict", "Dictionary", "Dictionary variable.", "variable_reference:Dictionary").param("key", "\"key\"", "Key", "Key to remove.", "expression"))
	descriptors.append(F.act("DictClear", "Clear Dictionary", "{var_name}.clear()", "Variables: Dictionary", "Clear {var_name}", "Empties a dictionary variable, removing every key and value.").param("var_name", "dict", "Dictionary", "Dictionary variable.", "variable_reference:Dictionary"))
	descriptors.append(F.act("DictMerge", "Merge Dictionary", "{var_name}.merge({other}, true)", "Variables: Dictionary", "Merge {other} into {var_name}", "Copies another dictionary's keys into this one, overwriting any clashes.").param("var_name", "dict", "Dictionary", "Destination dictionary.", "variable_reference:Dictionary").param("other", "{}", "Other", "Dictionary to merge in (overwrites).", "expression"))
	descriptors.append(F.cond("DictHasKey", "Has Key", "{var_name}.has({key})", "Variables: Dictionary", "{var_name} has key {key}", "True when the dictionary contains the given key.").param("var_name", "dict", "Dictionary", "Dictionary variable.", "variable_reference:Dictionary").param("key", "\"key\"", "Key", "Key to test.", "expression"))
	descriptors.append(F.cond("DictHasAllKeys", "Has All Keys", "{var_name}.has_all({keys})", "Variables: Dictionary", "{var_name} has all {keys}", "True when the dictionary contains every key in the given list.").param("var_name", "dict", "Dictionary", "Dictionary variable.", "variable_reference:Dictionary").param("keys", "[\"a\", \"b\"]", "Keys", "Array of keys that must all be present.", "expression"))
	descriptors.append(F.cond("DictIsEmpty", "Dictionary Is Empty", "{var_name}.is_empty()", "Variables: Dictionary", "{var_name} is empty", "True when the dictionary has no keys at all.").param("var_name", "dict", "Dictionary", "Dictionary variable.", "variable_reference:Dictionary"))
	descriptors.append(F.expr("DictGet", "Get Key (with default)", "{var_name}.get({key}, {default})", "Variables: Dictionary", "{var_name}.get({key})", "Reads a key's value, returning your fallback when the key is missing.").param("var_name", "dict", "Dictionary", "Dictionary variable.", "variable_reference:Dictionary").param("key", "\"key\"", "Key", "Key to read.", "expression").param("default", "0", "Default", "Fallback when the key is missing.", "expression"))
	descriptors.append(F.expr("DictSize", "Dictionary Size", "{var_name}.size()", "Variables: Dictionary", "{var_name}.size()", "Gives how many keys the dictionary currently holds.").param("var_name", "dict", "Dictionary", "Dictionary variable.", "variable_reference:Dictionary"))
	descriptors.append(F.expr("DictKeys", "Dictionary Keys", "{var_name}.keys()", "Variables: Dictionary", "{var_name}.keys()", "Gives a list of all the dictionary's keys.").param("var_name", "dict", "Dictionary", "Dictionary variable.", "variable_reference:Dictionary"))
	descriptors.append(F.expr("DictValues", "Dictionary Values", "{var_name}.values()", "Variables: Dictionary", "{var_name}.values()", "Gives a list of all the dictionary's values.").param("var_name", "dict", "Dictionary", "Dictionary variable.", "variable_reference:Dictionary"))
	# Array
	descriptors.append(F.act("ArrayAppend", "Push Back", "{var_name}.append({value})", "Variables: Array", "Push back {value} to {var_name}", "Adds a value to the end of an array variable.").param("var_name", "list", "Array", "Array variable.", "variable_reference:Array").param("value", "0", "Value", "Value to append.", "expression"))
	descriptors.append(F.act("ArrayInsert", "Insert At", "{var_name}.insert({index}, {value})", "Variables: Array", "Insert {value} at {index} in {var_name}", "Inserts a value into an array at a specific position.").param("var_name", "list", "Array", "Array variable.", "variable_reference:Array").param("index", "0", "Index", "Insertion index.", "expression").param("value", "0", "Value", "Value to insert.", "expression"))
	descriptors.append(F.act("ArrayRemoveAt", "Delete At", "{var_name}.remove_at({index})", "Variables: Array", "Delete at {index} in {var_name}", "Removes the item at a specific position in an array.").param("var_name", "list", "Array", "Array variable.", "variable_reference:Array").param("index", "0", "Index", "Index to remove.", "expression"))
	descriptors.append(F.act("ArrayErase", "Delete Value", "{var_name}.erase({value})", "Variables: Array", "Delete value {value} from {var_name}", "Removes the first item in the array that matches a given value.").param("var_name", "list", "Array", "Array variable.", "variable_reference:Array").param("value", "0", "Value", "First matching value to remove.", "expression"))
	descriptors.append(F.act("ArrayClear", "Clear Array", "{var_name}.clear()", "Variables: Array", "Clear {var_name}", "Empties an array, removing every item.").param("var_name", "list", "Array", "Array variable.", "variable_reference:Array"))
	descriptors.append(F.act("ArraySort", "Sort Array", "{var_name}.sort()", "Variables: Array", "Sort {var_name}", "Sorts an array's items into ascending order.").param("var_name", "list", "Array", "Array variable.", "variable_reference:Array"))
	descriptors.append(F.act("ArrayShuffle", "Shuffle Array", "{var_name}.shuffle()", "Variables: Array", "Shuffle {var_name}", "Randomly reorders the items in an array.").param("var_name", "list", "Array", "Array variable.", "variable_reference:Array"))
	descriptors.append(F.cond("ArrayContains", "Contains", "{var_name}.has({value})", "Variables: Array", "{var_name} contains {value}", "True when the array holds the given value somewhere.").param("var_name", "list", "Array", "Array variable.", "variable_reference:Array").param("value", "0", "Value", "Value to look for.", "expression"))
	descriptors.append(F.cond("ArrayIsEmpty", "Array Is Empty", "{var_name}.is_empty()", "Variables: Array", "{var_name} is empty", "True when the array has no items at all.").param("var_name", "list", "Array", "Array variable.", "variable_reference:Array"))
	descriptors.append(F.expr("ArrayAt", "Value At", "{var_name}[{index}]", "Variables: Array", "{var_name}[{index}]", "Gives the item stored at a specific position in the array.").param("var_name", "list", "Array", "Array variable.", "variable_reference:Array").param("index", "0", "Index", "Index to read.", "expression"))
	descriptors.append(F.expr("ArraySize", "Array Size", "{var_name}.size()", "Variables: Array", "{var_name}.size()", "Gives how many items the array currently holds.").param("var_name", "list", "Array", "Array variable.", "variable_reference:Array"))
	descriptors.append(F.expr("ArrayPickRandom", "Pick Random", "{var_name}.pick_random()", "Variables: Array", "random of {var_name}", "Gives one random item picked from the array.").param("var_name", "list", "Array", "Array variable.", "variable_reference:Array"))
	# JSON moved to its own module (json_aces.gd / EventForgeJsonACEs) so it is its own thing.

	# Time (System: Wait - handlers are implicit coroutines, await is safe anywhere)
	descriptors.append(F.act("Wait", "Wait", "await get_tree().create_timer({seconds}).timeout", "Time", "Wait {seconds} seconds", "Pauses this event for a number of seconds before continuing.").param("seconds", "1.0", "Seconds", "How long to wait before the next action runs.", "expression"))
	descriptors.append(F.act("AwaitSignal", "Wait For Signal", "await {signal_expression}", "Time", "Wait for {signal_expression}", "Pauses this event until a chosen signal fires, like a timer finishing.").param("signal_expression", "get_tree().process_frame", "Signal", "Signal to wait for (e.g. $Timer.timeout).", "expression"))
	# Frame budgeting (ADVANCED - frame-spreading): hand-roll loop spreading.
	# The handler becomes an implicit coroutine, so use these ONLY inside a one-shot trigger
	# (On Ready / On Signal / a custom function) with a run-once guard - NEVER inside a re-firing On
	# Process, where overlapping suspended runs would duplicate work. For the easy path use the Time Slicer pack.
	descriptors.append(F.act("AwaitNextFrame", "Await Next Frame", "await get_tree().process_frame", "Performance", "Wait one tick", "Pauses this event until the next game frame, to spread work out."))
	descriptors.append(F.act("BeginFrameBudget", "Begin Frame Budget", "var __ace_budget_end := Time.get_ticks_usec() + int({ms} * 1000.0)", "Performance", "begin {ms}ms frame budget", "Starts a per-frame time budget for the loop that follows, to avoid stutter.").param("ms", "8.0", "Budget (ms)", "Per-frame millisecond budget for the loop that follows (pair with Await If Over Budget in the SAME handler).", "expression"))
	descriptors.append(F.act("AwaitIfOverBudget", "Await If Over Budget", "if Time.get_ticks_usec() >= __ace_budget_end:\n\t__ace_budget_end = Time.get_ticks_usec() + int({ms} * 1000.0)\n\tawait get_tree().process_frame", "Performance", "await if over {ms}ms budget", "Yields to the next frame only if this frame's time budget is used up.").param("ms", "8.0", "Budget (ms)", "Re-arm budget after yielding (match Begin Frame Budget). Drop at the bottom of a loop body to self-pace it.", "expression"))
	descriptors.append(F.act("CallAfterDelay", "Call After Delay", "get_tree().create_timer({seconds}).timeout.connect({callable})", "Time", "Call {callable} after {seconds}s", "Schedules a method to run later without pausing this event.").param("seconds", "1.0", "Seconds", "Delay before the call fires (does not suspend this event).", "expression").param("callable", "queue_free", "Callable", "Method/Callable to invoke after the delay (e.g. queue_free, _on_done).", "expression"))
	# Repeat With Delay: the drip-feed loop. Written by hand this is a for loop with an await inside,
	# which is exactly the shape beginners get wrong; as one row it stays honest about suspending -
	# the handler becomes a coroutine for the whole burst, same contract as Wait.
	descriptors.append(F.act("RepeatWithDelay", "Repeat With Delay", "for __rep_{uid}: int in maxi({times}, 0):\n\t{do}\n\tawait get_tree().create_timer(maxf({delay}, 0.001)).timeout", "Time", "{times} times, {delay}s apart: {do}", "Runs one statement several times with a pause between each - burst fire, drip-spawns, a ticking countdown. It suspends this event the same way Wait does, so pair it with Once At A Time (Single Flight) when the trigger can fire again mid-burst.").param("times", "5", "Times", "How many repeats to run.", "expression").param("delay", "0.1", "Seconds Apart", "Pause between repeats.", "expression").param("do", "print(\"beat\")", "Do", "One call or statement, run each repeat.", "expression"))
	# ── The waits that can end two ways ───────────────────────────────────────────────────
	# Wait pauses for a clock and Wait For Signal for one signal; these three wait for a CHECK, for
	# ALL of several signals, or for the FIRST of them. Each one ends either way, so each writes its
	# verdict into node metadata keyed by the NAME you give it (1 = succeeded, 2 = timed out, unset =
	# never ran), and the next row reads it back with the ordinary conditions Wait Succeeded / Wait
	# Timed Out. Same store as the cooldowns, so a wait started in one event is readable in another.
	# A timeout ALSO reports the failure on the sheet's verb_failed signal when the sheet declares
	# one, so a loading screen owned by another event can handle it as an On Failure Of trigger.
	# Wait Until POLLS: where a pack already emits a signal for what you are waiting on (Run In
	# Background's On Done, Time Slicer's On Drained), wait for that signal instead - and use Wait
	# For All Of / Wait For Any Of to COMBINE those signals rather than replace them.
	descriptors.append(F.act("WaitUntil", "Wait Until", "var __wait_end_{uid}: int = Time.get_ticks_msec() + int(maxf({seconds}, 0.0) * 1000.0)\nvar __wait_ok_{uid}: bool = true\nwhile not ({check}):\n\tif {seconds} > 0.0 and Time.get_ticks_msec() >= __wait_end_{uid}:\n\t\t__wait_ok_{uid} = false\n\t\tbreak\n\tawait get_tree().process_frame\nset_meta(&\"__ef_wait_\" + str({wait_name}).to_utf8_buffer().hex_encode(), 1 if __wait_ok_{uid} else 2)\nif not __wait_ok_{uid} and has_signal(&\"verb_failed\"):\n\temit_signal(&\"verb_failed\", str({wait_name}), \"timed out after \" + str({seconds}) + \"s\")", "Time", "wait [b]{wait_name}[/b] until [b]{check}[/b], give up after [b]{seconds}[/b]s", "Pauses this event until a check comes true, or until the give-up time passes. Read which happened on the next row with Wait Succeeded / Wait Timed Out, naming this wait. It polls once a frame, so prefer Wait For Signal when a real signal exists for what you are waiting on.").param("wait_name", "\"loading\"", "Named", "A name for this wait, so Wait Succeeded / Wait Timed Out can say which one they mean.", "expression").param("check", "true", "Until", "The check to wait for, tested once a frame.", "expression").param("seconds", "5.0", "Give Up After", "Seconds before giving up. 0 waits forever.", "expression"))
	descriptors.append(F.act("WaitForAllOf", "Wait For All Of", "var __join_left_{uid}: Array[int] = [0]\nvar __join_conns_{uid}: Array = []\nfor __sig_{uid}: Signal in {signals}:\n\tvar __arity_{uid}: int = 0\n\tfor __info_{uid}: Dictionary in __sig_{uid}.get_object().get_signal_list():\n\t\tif str(__info_{uid}.get(\"name\", \"\")) == str(__sig_{uid}.get_name()):\n\t\t\t__arity_{uid} = (__info_{uid}.get(\"args\", []) as Array).size()\n\t__join_left_{uid}[0] += 1\n\tvar __cb_{uid}: Callable = func() -> void: __join_left_{uid}[0] -= 1\n\tif __arity_{uid} > 0:\n\t\t__cb_{uid} = __cb_{uid}.unbind(__arity_{uid})\n\t__sig_{uid}.connect(__cb_{uid}, CONNECT_ONE_SHOT)\n\t__join_conns_{uid}.append([__sig_{uid}, __cb_{uid}])\nvar __join_end_{uid}: int = Time.get_ticks_msec() + int(maxf({seconds}, 0.0) * 1000.0)\nvar __join_ok_{uid}: bool = true\nwhile __join_left_{uid}[0] > 0:\n\tif {seconds} > 0.0 and Time.get_ticks_msec() >= __join_end_{uid}:\n\t\t__join_ok_{uid} = false\n\t\tbreak\n\tawait get_tree().process_frame\nfor __conn_{uid}: Array in __join_conns_{uid}:\n\tif is_instance_valid((__conn_{uid}[0] as Signal).get_object()) and (__conn_{uid}[0] as Signal).is_connected(__conn_{uid}[1] as Callable):\n\t\t(__conn_{uid}[0] as Signal).disconnect(__conn_{uid}[1] as Callable)\nset_meta(&\"__ef_wait_\" + str({wait_name}).to_utf8_buffer().hex_encode(), 1 if __join_ok_{uid} else 2)\nif not __join_ok_{uid} and has_signal(&\"verb_failed\"):\n\temit_signal(&\"verb_failed\", str({wait_name}), \"timed out after \" + str({seconds}) + \"s\")", "Time", "wait [b]{wait_name}[/b] for ALL of [b]{signals}[/b], give up after [b]{seconds}[/b]s", "Pauses this event until every signal in the list has fired at least once, or until the give-up time passes. It connects them ALL up front, one-shot, so nothing can fire into the gap between two waits - the bug a hand-written chain of awaits always has. An empty list succeeds at once.").param("wait_name", "\"gate\"", "Named", "A name for this wait, so Wait Succeeded / Wait Timed Out can say which one they mean.", "expression").param("signals", "[]", "Signals", "The signals to join, as a list: [$Door.opened, $Camera.arrived].", "expression").param("seconds", "8.0", "Give Up After", "Seconds before giving up. 0 waits forever.", "expression"))
	descriptors.append(F.act("WaitForAnyOf", "Wait For Any Of", "var __any_won_{uid}: Array[String] = [\"\"]\nvar __any_conns_{uid}: Array = []\nfor __sig_{uid}: Signal in {signals}:\n\tvar __arity_{uid}: int = 0\n\tfor __info_{uid}: Dictionary in __sig_{uid}.get_object().get_signal_list():\n\t\tif str(__info_{uid}.get(\"name\", \"\")) == str(__sig_{uid}.get_name()):\n\t\t\t__arity_{uid} = (__info_{uid}.get(\"args\", []) as Array).size()\n\tvar __owner_{uid}: Object = __sig_{uid}.get_object()\n\tvar __won_{uid}: String = ((__owner_{uid} as Node).name + \".\" if __owner_{uid} is Node else \"\") + str(__sig_{uid}.get_name())\n\tvar __cb_{uid}: Callable = func() -> void: __any_won_{uid}[0] = __won_{uid} if __any_won_{uid}[0] == \"\" else __any_won_{uid}[0]\n\tif __arity_{uid} > 0:\n\t\t__cb_{uid} = __cb_{uid}.unbind(__arity_{uid})\n\t__sig_{uid}.connect(__cb_{uid}, CONNECT_ONE_SHOT)\n\t__any_conns_{uid}.append([__sig_{uid}, __cb_{uid}])\nvar __any_end_{uid}: int = Time.get_ticks_msec() + int(maxf({seconds}, 0.0) * 1000.0)\nwhile __any_won_{uid}[0] == \"\":\n\tif {seconds} > 0.0 and Time.get_ticks_msec() >= __any_end_{uid}:\n\t\tbreak\n\tawait get_tree().process_frame\nfor __conn_{uid}: Array in __any_conns_{uid}:\n\tif is_instance_valid((__conn_{uid}[0] as Signal).get_object()) and (__conn_{uid}[0] as Signal).is_connected(__conn_{uid}[1] as Callable):\n\t\t(__conn_{uid}[0] as Signal).disconnect(__conn_{uid}[1] as Callable)\nset_meta(&\"__ef_first_\" + str({wait_name}).to_utf8_buffer().hex_encode(), __any_won_{uid}[0])\nset_meta(&\"__ef_wait_\" + str({wait_name}).to_utf8_buffer().hex_encode(), 1 if __any_won_{uid}[0] != \"\" else 2)\nif __any_won_{uid}[0] == \"\" and has_signal(&\"verb_failed\"):\n\temit_signal(&\"verb_failed\", str({wait_name}), \"timed out after \" + str({seconds}) + \"s\")", "Time", "wait [b]{wait_name}[/b] for ANY of [b]{signals}[/b]", "Pauses this event until the first of several signals fires, then carries on - a race, or a sudden-death timer. Read which one won with First To Finish, naming this wait: it answers \"Node.signal\", so racing $Player.died against $Boss.died still tells you which one it was. Every signal is connected one-shot up front, so the winner is whichever really fired first, and the losers are disconnected when the race ends.").param("wait_name", "\"race\"", "Named", "A name for this wait, so First To Finish and the outcome conditions can say which one they mean.", "expression").param("signals", "[]", "Signals", "The signals to race, as a list: [$Player.died, $Boss.died].", "expression").param("seconds", "0.0", "Give Up After", "Seconds before giving up. 0 waits forever.", "expression"))
	descriptors.append(F.cond("WaitSucceeded", "Wait Succeeded", "int(get_meta(&\"__ef_wait_\" + str({wait_name}).to_utf8_buffer().hex_encode(), 0)) == 1", "Run Context", "wait [b]{wait_name}[/b] succeeded", "True when the named wait ended because what it was waiting for happened. A wait that has never run is neither succeeded nor timed out, so nothing fires before the wait does.").param("wait_name", "\"loading\"", "Named", "The name the wait row used.", "expression"))
	descriptors.append(F.cond("WaitTimedOut", "Wait Timed Out", "int(get_meta(&\"__ef_wait_\" + str({wait_name}).to_utf8_buffer().hex_encode(), 0)) == 2", "Run Context", "wait [b]{wait_name}[/b] timed out", "True when the named wait gave up instead of finishing - the recovery branch for a load that never reported in. The same timeout also reports on verb_failed, so another event can handle it as On Failure Of.").param("wait_name", "\"loading\"", "Named", "The name the wait row used.", "expression"))
	descriptors.append(F.expr("FirstToFinish", "First To Finish", "str(get_meta(&\"__ef_first_\" + str({wait_name}).to_utf8_buffer().hex_encode(), \"\"))", "Run Context", "first to finish ( [b]{wait_name}[/b] )", "Which signal a Wait For Any Of was watching finished first, written as \"Node.signal\" (the node's name, a dot, the signal's name), or empty text when it timed out. The node is part of the answer on purpose: a race between $Player.died and $Boss.died is two signals with the same name, and only the owner tells them apart. Compare it in a condition cell to branch on the winner.").param("wait_name", "\"race\"", "Named", "The name the Wait For Any Of row used.", "expression"))
	# ── Retry: the loop that stops the moment it works ────────────────────────────────
	# Repeat With Delay always burns its whole count and has no idea whether the thing worked. This
	# is the loop developers actually write: iteration is a LOOP ROW (a looping condition, so the
	# canvas nesting is the emitted nesting), success is an ordinary nested condition whose action is
	# Stop Retrying, and giving up is the sibling condition Retries Exhausted.
	#
	# The shared record is a THREE-state number on the node, not a flag, because a flag cannot tell
	# "this retry has never run" apart from "it ran and nobody stopped it" - and a give-up branch that
	# fires before a single attempt has happened is worse than having none. 0 or missing = never ran,
	# 1 = the loop started, 2 = a Stop Retrying ended it. Retries Exhausted answers 1 and CONSUMES the
	# record, so the next run of the loop starts clean with nothing to reset beforehand.
	#
	# The name is hex-encoded into the metadata key, the same guard every name-keyed family in this
	# vocabulary uses: Object.set_meta REFUSES a key that is not a valid identifier, so a retry called
	# "save game" would silently store nothing and every read would answer the default forever.
	descriptors.append(F.cond("RetryUpTo", "Retry Up To N Times", "__retry_begin_{uid}(str({retry_name}), int({times}))", "Loops", "retry [b]{retry_name}[/b] up to [b]{times}[/b] times", "Runs this event's actions over and over, up to a number of attempts, so a nested Stop Retrying can end it the moment the thing works. With no waiting inside it stays instant, which makes it the procedural-placement loop as much as the disk retry. Read the try number with Retry Attempt Number.").param("retry_name", "\"save\"", "Named", "A name for this retry, matching its Stop Retrying and Retries Exhausted rows.", "expression").param("times", "5", "Times", "Most attempts before giving up.", "expression").looping("attempt").stateful("func __retry_begin_{uid}(key: String, times: int) -> Array:\n\tset_meta(StringName(\"__ef_retry_\" + key.to_utf8_buffer().hex_encode()), 1)\n\treturn range(maxi(times, 1))"))
	descriptors.append(F.expr("RetryAttemptNumber", "Retry Attempt Number", "({loop_var} + 1)", "Loops", "retry attempt number", "Which try this is, counting from 1 - the number you put in the log line or the HUD. Only readable inside a Retry Up To N Times loop, and it reads that loop's own variable, so change the cell if you renamed it.").param("loop_var", "attempt", "Loop Variable", "The retry loop's own variable. Leave it as attempt unless you renamed the loop variable on the Retry Up To N Times row.", "expression"))
	descriptors.append(F.act("StopRetrying", "Stop Retrying", "set_meta(&\"__ef_retry_\" + str({retry_name}).to_utf8_buffer().hex_encode(), 2)\nbreak", "Loops", "stop retrying [b]{retry_name}[/b]", "Ends the retry loop right now because the attempt worked, and records that it worked so Retries Exhausted below stays false. Put it under the condition that means success.").param("retry_name", "\"save\"", "Name", "The name the Retry Up To N Times row uses.", "expression"))
	descriptors.append(F.cond("RetriesExhausted", "Retries Exhausted", "__exhausted_{uid}(str({retry_name}))", "Loops", "retries for [b]{retry_name}[/b] exhausted", "True when the retry loop above ran out of tries without a Stop Retrying - the give-up branch. Put it in a sibling row directly beneath the retry loop, using the same name; a retry that has never run is not exhausted, so nothing fires before the loop does. Reading it clears the record, so the next run starts clean. When the retry WAITS between tries (Wait Before Next Try) the loop is still running while the rows beneath it are reached, so report that give-up with Report Failure on the last attempt and handle it in an On Failure Of event instead.").param("retry_name", "\"save\"", "Name", "The name the Retry Up To N Times row uses.", "expression").stateful("func __exhausted_{uid}(key: String) -> bool:\n\tvar meta_key: StringName = StringName(\"__ef_retry_\" + key.to_utf8_buffer().hex_encode())\n\tvar state: int = int(get_meta(meta_key, 0))\n\tset_meta(meta_key, 0)\n\treturn state == 1"))
