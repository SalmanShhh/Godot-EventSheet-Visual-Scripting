	descriptors.append(F.expr("Snapped", "Snap To Step", "snappedf({value}, {step})", "Math & Random", "snap {value} to {step}", "Rounds a value to the nearest step, useful for snapping to a grid.").param("value", "0.0", "Value", "Value to snap.", "expression").param("step", "1.0", "Step", "Snap increment (e.g. grid size).", "expression"))
	descriptors.append(F.expr("InverseLerp", "Inverse Lerp", "inverse_lerp({from}, {to}, {value})", "Math & Random", "inverse lerp {value}", "Returns where a value sits within a range as a 0-to-1 fraction.").param("from", "0.0", "From", "Range start.", "expression").param("to", "1.0", "To", "Range end.", "expression").param("value", "0.5", "Value", "Value in the range.", "expression"))
	descriptors.append(F.expr("Smoothstep", "Smoothstep", "smoothstep({from}, {to}, {value})", "Math & Random", "smoothstep({from}, {to}, {value})", "Eases a value between two edges with a smooth S-curve instead of a straight line.").param("from", "0.0", "From", "Edge 0.", "expression").param("to", "1.0", "To", "Edge 1.", "expression").param("value", "0.5", "Value", "Value to ease.", "expression"))
	descriptors.append(F.expr("SmoothLerp", "Smooth Lerp", "lerpf({from}, {to}, smoothstep(0.0, 1.0, {weight}))", "Math & Random", "smooth lerp {from} -> {to}", "Blends between two values like Lerp, but eases the 0-to-1 weight with a smooth S-curve first, so the motion starts and ends gently instead of at a constant speed.").param("from", "0.0", "From", "Start value.", "expression").param("to", "1.0", "To", "End value.", "expression").param("weight", "0.5", "Weight", "0..1 progress (eased with an S-curve before blending).", "expression"))
	descriptors.append(F.expr("Atan2", "Angle Of (atan2)", "atan2({y}, {x})", "Math & Random", "atan2({y}, {x})", "Returns the angle (radians) of the direction (x, y), correct in all four quadrants - the standard way to turn a velocity or offset into a heading.").param("y", "0.0", "Y", "Vertical component.", "expression").param("x", "0.0", "X", "Horizontal component.", "expression"))
	descriptors.append(F.expr("PingPong", "Ping-Pong", "pingpong({value}, {length})", "Math & Random", "pingpong({value}, {length})", "Bounces a value back and forth between 0 and a length, great for looping motion.").param("value", "0.0", "Value", "Input value (often a timer).", "expression").param("length", "1.0", "Length", "Bounce length.", "expression"))
	descriptors.append(F.expr("AngleDifference", "Angle Difference", "angle_difference({from}, {to})", "Math & Random", "angle diff {from} -> {to}", "Returns the shortest signed turn from one angle to another, in radians.").param("from", "0.0", "From", "From angle (radians).", "expression").param("to", "0.0", "To", "To angle (radians).", "expression"))
	descriptors.append(F.expr("RotateTowardAngle", "Rotate Toward (angle)", "rotate_toward({from}, {to}, {delta})", "Math & Random", "rotate {from} toward {to}", "Steps an angle toward a target by a limited amount, for smooth turning.").param("from", "0.0", "From", "Current angle (radians).", "expression").param("to", "0.0", "To", "Target angle (radians).", "expression").param("delta", "0.1", "Delta", "Max step (radians).", "expression"))
	descriptors.append(F.expr("LerpAngle", "Lerp Angle", "lerp_angle({from}, {to}, {weight})", "Math & Random", "lerp angle {from} -> {to}", "Blends between two angles by a 0..1 weight, taking the shortest path.").param("from", "0.0", "From", "From angle (radians).", "expression").param("to", "0.0", "To", "To angle (radians).", "expression").param("weight", "0.5", "Weight", "0..1 blend.", "expression"))
	descriptors.append(F.expr("DegToRad", "Degrees To Radians", "deg_to_rad({degrees})", "Math & Random", "deg2rad({degrees})", "Converts an angle from degrees into radians, which Godot uses internally.").param("degrees", "90.0", "Degrees", "Angle in degrees.", "expression"))
	descriptors.append(F.expr("RadToDeg", "Radians To Degrees", "rad_to_deg({radians})", "Math & Random", "rad2deg({radians})", "Converts an angle from radians back into easy-to-read degrees.").param("radians", "0.0", "Radians", "Angle in radians.", "expression"))
	descriptors.append(F.expr("PosMod", "Positive Modulo", "posmod({a}, {b})", "Math & Random", "posmod({a}, {b})", "Returns a modulo result that stays positive, handy for wrapping indexes.").param("a", "0", "A", "Dividend (int).", "expression").param("b", "1", "B", "Divisor (int).", "expression"))
	descriptors.append(F.cond("IsEqualApprox", "Is Equal (approx)", "is_equal_approx({a}, {b})", "Math & Random", "{a} ≈ {b}", "True when two numbers are nearly equal, avoiding tiny floating-point errors.").param("a", "0.0", "A", "First value.", "expression").param("b", "0.0", "B", "Second value.", "expression"))
	descriptors.append(F.cond("IsZeroApprox", "Is Zero (approx)", "is_zero_approx({value})", "Math & Random", "{value} ≈ 0", "True when a value is essentially zero, ignoring tiny rounding differences.").param("value", "0.0", "Value", "Value to test.", "expression"))
	descriptors.append(F.act("SeedRandom", "Seed Random", "seed({value})", "Math & Random", "seed RNG with {value}", "Sets the random seed so the same number gives a repeatable random sequence.").param("value", "0", "Seed", "Integer seed (same seed = same sequence).", "expression"))
	descriptors.append(F.act("RandomizeSeed", "Randomize Seed", "randomize()", "Math & Random", "randomize seed", "Reseeds randomness from the clock so each playthrough differs."))

	# Color math - hit flashes, fades, and tints without dropping to GDScript. The colour params
	# are full expressions (a literal, `modulate`, or another colour ACE), so they compose.
	descriptors.append(F.expr("ColorLighten", "Lighten Color", "({color}).lightened({amount})", "Color", "lighten {color} by {amount}", "Returns the colour shifted toward white by the given amount.").param("color", "Color(1, 1, 1, 1)", "Color", "Base colour.", "color").param("amount", "0.2", "Amount", "0..1 toward white.", "expression"))
	descriptors.append(F.expr("ColorDarken", "Darken Color", "({color}).darkened({amount})", "Color", "darken {color} by {amount}", "Returns the colour shifted toward black by the given amount.").param("color", "Color(1, 1, 1, 1)", "Color", "Base colour.", "color").param("amount", "0.2", "Amount", "0..1 toward black.", "expression"))
	descriptors.append(F.expr("ColorLerp", "Lerp Color", "({from}).lerp({to}, {weight})", "Color", "lerp {from} -> {to}", "Blends two colours by a 0..1 weight for smooth colour fades.").param("from", "Color(1, 1, 1, 1)", "From", "Start colour.", "color").param("to", "Color(1, 0, 0, 1)", "To", "End colour.", "color").param("weight", "0.5", "Weight", "0..1 blend.", "expression"))
	descriptors.append(F.expr("ColorWithAlpha", "Color With Alpha", "Color({color}, {alpha})", "Color", "{color} @ alpha {alpha}", "Returns the colour with a new transparency, for fade-in or fade-out effects.").param("color", "Color(1, 1, 1, 1)", "Color", "Base colour.", "color").param("alpha", "0.5", "Alpha", "New alpha 0..1.", "expression"))
	descriptors.append(F.expr("ColorFromHSV", "Color From HSV", "Color.from_hsv({h}, {s}, {v}, {a})", "Color", "hsv({h}, {s}, {v})", "Builds a colour from hue, saturation, value and alpha components.").param("h", "0.0", "Hue", "0..1.", "expression").param("s", "1.0", "Saturation", "0..1.", "expression").param("v", "1.0", "Value", "0..1.", "expression").param("a", "1.0", "Alpha", "0..1.", "expression"))
	descriptors.append(F.expr("ColorFromHex", "Color From Hex", "Color.html({hex})", "Color", "color {hex}", "Builds a colour from an HTML hex string like #ff8800.").param("hex", "\"#ff8800\"", "Hex", "HTML colour string.", "expression"))
	descriptors.append(F.expr("ColorInverted", "Invert Color", "({color}).inverted()", "Color", "invert {color}", "Returns the opposite colour, useful for highlight or negative effects.").param("color", "Color(1, 1, 1, 1)", "Color", "Colour to invert.", "color"))

	# ── Variable easing / flipping (the two beginner patterns that always come out wrong by hand) ──
	# Move Toward is the frame-rate INDEPENDENT damping form: the exponential decay means the same
	# Speed lands the same distance per SECOND no matter the frame rate, unlike the naive
	# `lerp(a, b, 0.1)` written straight into a per-frame event.
	descriptors.append(F.act("SmoothMoveToward", "Move Toward (smooth)", "{var_name} = lerp({var_name}, {target}, 1.0 - exp(-maxf({speed}, 0.0) * get_process_delta_time()))", "Variables", "Move {var_name} toward {target} at speed {speed}", "Eases a variable smoothly toward a target instead of snapping to it. Works on numbers, Vector2/Vector3 and Colors alike (lerp is generic). It is frame-rate independent - the exponential form behaves the same at 30 and 144 fps.").param("var_name", "value", "Variable", "Variable to ease.", "variable_reference").param("target", "1.0", "Toward", "The value to approach.", "expression").param("speed", "8.0", "Speed", "How fast it closes the gap - higher is snappier, around 8 feels like a firm camera follow.", "expression"))
	descriptors.append(F.act("ToggleVar", "Toggle boolean", "{var_name} = not {var_name}", "Variables", "Toggle {var_name}", "Flips a true/false variable to its opposite - on becomes off, off becomes on.").param("var_name", "enabled_flag", "Variable", "Boolean variable to flip.", "variable_reference"))
	descriptors.append(F.expr("AsClockTime", "As Clock Time", "(\"%02d:%02d\" % [int(maxf({seconds}, 0.0)) / 60, int(maxf({seconds}, 0.0)) % 60])", "Text", "as clock time ({seconds})", "Turns a number of seconds into minutes:seconds text - 90 seconds reads \"01:30\". For countdown timers, lap times and speedrun clocks.").param("seconds", "90.0", "Seconds", "A duration in seconds.", "expression"))
	# Charge Toward: the hold-to-charge meter. Filling by "reach the maximum in N seconds" (rather than
	# "add X per frame") means the tuning number is the one the designer actually thinks in, and the
	# clamp is baked in so the meter can never overfill however long the button is held.
	descriptors.append(F.act("ChargeToward", "Charge Toward", "{var_name} = minf({var_name} + (maxf({maximum}, 0.0) / maxf({seconds}, 0.001)) * get_process_delta_time(), maxf({maximum}, 0.0))", "Variables", "charge {var_name} to {maximum} over {seconds}s", "Fills a variable while the event runs, reaching the maximum after the given seconds - a hold-to-charge meter. Put it under a while-held input condition; it clamps itself at the top, and the release event just reads the value.").param("var_name", "power", "Variable", "The meter to fill.", "variable_reference").param("maximum", "100.0", "Up To", "The full value the meter tops out at.", "expression").param("seconds", "1.5", "Over Seconds", "How long a full charge takes from empty.", "expression"))
	descriptors.append(F.expr("ProgressOf", "Progress Of", "clampf(inverse_lerp({from}, {to}, {value}), 0.0, 1.0)", "Math & Random", "progress of {value} from {from} to {to}", "Gives how far a value has come through a range, as 0 to 1 - feed it straight into a bar's scale, an alpha, or a colour lerp. This is the inverse_lerp nobody finds, with the clamp already applied.").param("value", "5.0", "Value", "The current value.", "expression").param("from", "0.0", "From", "The value that counts as empty.", "expression").param("to", "10.0", "To", "The value that counts as full.", "expression"))
	descriptors.append(F.expr("PercentOf", "Percent Of", "(clampf(inverse_lerp({from}, {to}, {value}), 0.0, 1.0) * 100.0)", "Math & Random", "percent of {value} from {from} to {to}", "The same reading as Progress Of, but as 0 to 100 - the number you show in text, like \"73%\" health.").param("value", "5.0", "Value", "The current value.", "expression").param("from", "0.0", "From", "The value that counts as empty.", "expression").param("to", "10.0", "To", "The value that counts as full.", "expression"))

	# ── Type-guarded fallbacks: turn "whatever this is" into something a typed variable can take ──
	# Everything LOADED rather than typed arrives as a value that might be the wrong shape, or missing
	# outright: a JSON field, a save slot, a Dictionary read, a method that can return null, a value
	# another sheet handed over. Each of these hands the value back only when it really is that kind of
	# thing, and your own default otherwise, so ONE row replaces a guard row plus a conversion.
	# Three deliberate details, each learned from what GDScript actually accepts:
	#   - the guard is `typeof(x) == TYPE_*`, never `x is String`. The analyzer REFUSES to compile
	#     `i is String` once it knows `i` is an int ("Expression is of type int so it can't be of type
	#     String"), so an `is` guard would turn "pointed the row at the wrong variable" into a build
	#     break. typeof compiles against any type and simply lands on the fallback at runtime.
	#   - a trailing `and {value}` reads "and it is not empty": Godot treats an empty String, Array or
	#     Dictionary as false. `.is_empty()` and a `!= ""` comparison are both unusable here for the
	#     same analyzer reason - each is a parse error against a value of a known other type.
	#   - a zero is NOT missing. Number Or keeps 0 and Value Or keeps 0 and "" alike; only the
	#     emptiness of a text/list/record counts as nothing.
	# The value expression is read two or three times in the emitted line, so keep it a READ (a
	# variable, a .get()), never something that changes the game.
	descriptors.append(F.expr("NumberOr", "Number Or", "({value} if typeof({value}) in [TYPE_INT, TYPE_FLOAT] else {fallback})", "Variables", "{value} as a number, or {fallback}", "The value when it really is a number, or your own default when it is missing, null, text, or anything else. A zero counts as a real number and is kept. Use it to put a loaded value straight into a whole-number or decimal variable without a guard row first. " + DOUBLE_READ_NOTE).param("value", "0", "Value", "The untyped value to check - a save slot read, a JSON field, a Dictionary key.", "expression").param("fallback", "0", "Or", "What you get back when it is not a number.", "expression"))
	descriptors.append(F.expr("TextOr", "Text Or", "({value} if (typeof({value}) == TYPE_STRING and {value}) else {fallback})", "Variables", "{value} as text, or {fallback}", "The value when it really is text with something in it, or your own default when it is missing, null, blank, or another kind of value. The classic use is a saved player name that falls back to \"Player\". " + DOUBLE_READ_NOTE).param("value", "\"\"", "Value", "The untyped value to check - a save slot read, a JSON field, a Dictionary key.", "expression").param("fallback", "\"Player\"", "Or", "What you get back when it is not text, or is blank.", "expression"))
	# TYPE_PACKED_BYTE_ARRAY is the FIRST of the packed families and TYPE_MAX sits past the last, so
	# `typeof(x) >= TYPE_PACKED_BYTE_ARRAY` is "x is one of the packed arrays" without naming nine
	# constants. It earns its place because Split Text hands back a PackedStringArray: without it the
	# single most natural way to build a list here fell straight through to the fallback.
	descriptors.append(F.expr("ListOr", "List Or", "({value} if ((typeof({value}) == TYPE_ARRAY or typeof({value}) >= TYPE_PACKED_BYTE_ARRAY) and {value}) else {fallback})", "Variables", "{value} as a list, or {fallback}", "The value when it really is a list with items in it, or your own default when it is missing, null, empty, or another kind of value. A Split Text result counts as a list. Safe to feed straight into a For Each. " + DOUBLE_READ_NOTE).param("value", "[]", "Value", "The untyped value to check - a loaded inventory, a JSON array, a Split Text result, a Dictionary key.", "expression").param("fallback", "[]", "Or", "What you get back when it is not a list, or is empty.", "expression"))
	descriptors.append(F.expr("RecordOr", "Record Or", "({value} if (typeof({value}) == TYPE_DICTIONARY and {value}) else {fallback})", "Variables", "{value} as a record, or {fallback}", "The value when it really is a record (a dictionary) with keys in it, or your own default when it is missing, null, empty, or another kind of value. Pair it with Get Key so a whole missing settings block reads as defaults. " + DOUBLE_READ_NOTE).param("value", "{}", "Value", "The untyped value to check - a loaded settings block, a JSON object, a Dictionary key.", "expression").param("fallback", "{}", "Or", "What you get back when it is not a record, or is empty.", "expression"))
	descriptors.append(F.expr("ValueOr", "Value Or", "({value} if {value} != null else {fallback})", "Variables", "{value}, or {fallback} when it is nothing", "The value unless it is null, in which case your own default. This one guards nothing else: a zero, a blank text and an empty list all count as real values here. Use it for a method that can hand back null. " + DOUBLE_READ_NOTE).param("value", "null", "Value", "Anything that might be null - a method result, a freed reference, a missing key.", "expression").param("fallback", "0", "Or", "What you get back when it is null.", "expression"))

	# Expressions
	descriptors.append(F.expr("GetVar", "Get Variable", "{var_name}", "Variables", "{var_name}", "Returns the current value stored in the named variable.").param("var_name", "var", "Variable", "Variable to read.", "variable_reference"))
	descriptors.append(F.expr("GetDelta", "Get Delta", "delta", "General Expressions", "delta", "Returns the seconds since last frame, used to make motion frame-rate independent."))
