	descriptors.append(F.expr("LerpValue", "Lerp", "lerpf({from}, {to}, {weight})", "Math & Random", "lerp({from}, {to}, {weight})", "Blends between two values by a 0-to-1 weight, for smooth interpolation.").param("from", "0.0", "From", "Start value.", "expression").param("to", "1.0", "To", "End value.", "expression").param("weight", "0.5", "Weight", "0..1 blend.", "expression"))
