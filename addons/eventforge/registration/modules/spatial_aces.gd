	descriptors.append(F.cond("IsToTheLeftOfObject3D", "Is To The Left Of", "to_local({point}).x < 0.0", PAGE_SEE, "[i]{point}[/i] is [b]to the left of[/b] it", "Asks whether a place is off this object's left side - the twin of Is To The Right Of.", "Node3D").param("point", "Vector3.ZERO", "Point", "The place being asked about.", "expression"))


## Angle and distance, both ways: the point an angle and a distance name, a ring of things placed
## evenly around a circle, and the pair of locals that reads a place back as an angle and a distance.
static func _append_polar(descriptors: Array[ACEDescriptor]) -> void:
	descriptors.append(F.expr("PointAtAngle", "Point At Angle", "Vector2.from_angle(deg_to_rad({angle})) * {distance}", "Math & Random", "the point at angle {angle}, distance {distance}", "The point an angle and a distance name. Add it to a centre for a place on a circle; grow the distance every tick and it draws a spiral.").param("angle", "0.0", "Angle", "The angle, in degrees.", "expression").param("distance", "100.0", "Distance", "How far out to go.", "expression"))
	descriptors.append(F.act("CreateAroundCircle", "Create Evenly Around A Circle", "for __ring_{uid} in {count}:\n" + "\tvar __ring_angle_{uid} := TAU * float(__ring_{uid}) / float({count})\n" + "\tvar __ring_node_{uid} = load({scene}).instantiate()\n" + "\tadd_child(__ring_node_{uid})\n" + "\t__ring_node_{uid}.position = {centre}" + " + Vector2(cos(__ring_angle_{uid}), sin(__ring_angle_{uid})) * {radius}", "Scene", "Create [b]{count}[/b] of {scene} evenly around a circle of [i]{radius}[/i]", "Places a number of copies evenly around a circle - the bullet-hell ring, the radial menu, the circle of pillars.").param("count", "8", "How many", "How many to place.", "expression").param("scene", "\"res://bullet.tscn\"", "Scene", "The scene to place.", "scene_path").param("centre", "Vector2.ZERO", "Centre", "The middle of the circle.", "expression").param("radius", "120.0", "Radius", "How far out from the centre they sit.", "expression"))
	descriptors.append(F.act("StoreAsAngleAndDistance", "Store As Angle And Distance", "var {angle_name} := {from}.angle_to_point({to})\n" + "var {distance_name} := {from}.distance_to({to})", "Math & Random", "Store [i]{from}[/i] to [i]{to}[/i] as [b]{angle_name}[/b] and [b]{distance_name}[/b]", "Reads a place back the other way - as the angle from one point to another and how far apart they are, both named in one drop.").param("from", "Vector2.ZERO", "From", "The place to measure from.", "expression").param("to", "Vector2(100, 0)", "To", "The place to measure to.", "expression").param("angle_name", "aim_angle", "Angle name", "What to call the angle.", "expression").param("distance_name", "aim_distance", "Distance name", "What to call the distance.", "expression"))
