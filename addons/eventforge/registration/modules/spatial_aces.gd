	descriptors.append(F.cond("IsInFrontOfObject3D", "Is In Front Of", "to_local({point}).z < 0.0", PAGE_SEE, "[i]{point}[/i] is [b]in front of[/b] it", "Asks whether a place is in front of this object, whichever way it happens to be turned.", "Node3D").param("point", "Vector3.ZERO", "Point", "The place being asked about.", "expression"))
