	descriptors.append(F.cond("IsWithinAngleOfFacing3D", "Is Within Angle Of Facing", "{forward}.dot({direction}) > cos(deg_to_rad({angle}))", PAGE_SEE, "Is within [b]{angle}[/b]° of facing [i]{direction}[/i]", "Asks whether something is inside the cone this object is looking down - a vision cone, a backstab check, an aim assist.", "Node3D").param("forward", "-basis.z", "Facing", "The way this object faces. Its own forward, unless you say otherwise.", "expression").param("direction", "Vector3.FORWARD", "Toward", "The direction to the thing being looked for - Direction To gives you one.", "expression").param("angle", "45.0", "Within", "Half the width of the cone, in degrees. 45 is a 90-degree field of view.", "expression"))
