# EventForge module - System (event-sheet System parity)
#
# Time/engine, display, text expressions, comparisons, shader/date/platform info,
# stateful Every X Seconds and the multi-line Spawn Scene At.
# Module contract: see ace_factory.gd - ace_ids/templates are API (compatibility
# covenant); this file only changes where the descriptors are AUTHORED.
@tool
class_name EventForgeSystemACEs
extends RefCounted

const F := preload("res://addons/eventforge/registration/ace_factory.gd")


static func get_descriptors() -> Array[ACEDescriptor]:
	var descriptors: Array[ACEDescriptor] = []

	# ── Event-sheet System coverage: time/engine, display, text expressions, comparisons ──
	descriptors.append(F.act("SetTimeScale", "Set Time Scale", "Engine.time_scale = {scale}", "Time", "Set time scale to {scale}", "Speeds up or slows the whole game; use for slow-motion or pausing.").param("scale", "1.0", "Scale", "1 = normal, 0.5 = slow motion, 0 = paused physics/process.", "expression"))
	descriptors.append(F.expr("GetTimeScale", "Time Scale", "Engine.time_scale", "Time", "time scale", "Gives the current game speed (1 = normal, below 1 = slow motion)."))
	descriptors.append(F.expr("GetGameTime", "Game Time", "(Time.get_ticks_msec() / 1000.0)", "Time", "game time (seconds)", "Gives seconds elapsed since the game started, handy for timers."))
	descriptors.append(F.expr("GetFps", "FPS", "Engine.get_frames_per_second()", "Time", "fps", "Gives the current frames per second, useful for performance checks."))
	descriptors.append(F.expr("GetFrameCount", "Frame Count", "Engine.get_process_frames()", "Time", "frame count", "Gives how many frames have run since startup."))
	descriptors.append(F.act("SetFullscreen", "Set Fullscreen Mode", "DisplayServer.window_set_mode({mode})", "Display", "Set window mode to {mode}", "Switches the game window between windowed, fullscreen and other display modes.").param_choice("mode", "DisplayServer.WINDOW_MODE_FULLSCREEN", "Mode", "Window mode.", ["DisplayServer.WINDOW_MODE_FULLSCREEN", "DisplayServer.WINDOW_MODE_EXCLUSIVE_FULLSCREEN", "DisplayServer.WINDOW_MODE_WINDOWED", "DisplayServer.WINDOW_MODE_MAXIMIZED"]))
	descriptors.append(F.act("SetWindowSize", "Set Window Size", "DisplayServer.window_set_size({size})", "Display", "Set window size to {size}", "Resizes the game window to a chosen pixel width and height.").param("size", "Vector2i(1280, 720)", "Size", "Window size in pixels.", "expression"))
	descriptors.append(F.expr("GetWindowWidth", "Window Width", "DisplayServer.window_get_size().x", "Display", "window width", "Gives the current window width in pixels."))
	descriptors.append(F.expr("GetWindowHeight", "Window Height", "DisplayServer.window_get_size().y", "Display", "window height", "Gives the current window height in pixels."))
	# Text (event-sheet System string expressions -> direct String methods)
	# The beginner text-building hero: {name} placeholders, no printf codes to learn ("%d" never
	# appears). Compiles to String.format with a Dictionary - plain GDScript, zero runtime.
	descriptors.append(F.expr("TextFromPattern", "Text From Pattern", "{pattern}.format({values})", "Text", "text from {pattern}", "Builds text by filling {name} slots in a pattern - \"{player} scored {score}!\" becomes \"Ada scored 300!\". The friendly way to mix words and values, no format codes.").param("pattern", "\"{score} points\"", "Pattern", "Text with {name} slots, e.g. \"{player} scored {score}!\".", "expression").param("values", "{\"score\": 100}", "Values", "What fills the slots: {\"name\": value, ...} - e.g. {\"player\": player_name, \"score\": score}.", "expression").featured())
	descriptors.append(F.expr("TextTokenAt", "Token At", "{text}.get_slice({separator}, {index})", "Text", "tokenat({text}, {index})", "Splits text by a separator and gives the chosen piece, like a CSV column.").param("text", "text", "Text", "Source string.", "expression").param("separator", "\",\"", "Separator", "Token separator.", "expression").param("index", "0", "Index", "Token index.", "expression"))
	descriptors.append(F.expr("TextTokenCount", "Token Count", "{text}.get_slice_count({separator})", "Text", "tokencount({text})", "Gives how many pieces text breaks into when split by a separator.").param("text", "text", "Text", "Source string.", "expression").param("separator", "\",\"", "Separator", "Token separator.", "expression"))
	descriptors.append(F.expr("TextFind", "Find In Text", "{text}.find({needle})", "Text", "find({needle})", "Gives where a substring first appears in text, or -1 if it's missing.").param("text", "text", "Text", "Source string.", "expression").param("needle", "\"a\"", "Find", "Substring to find (-1 when missing).", "expression"))
	descriptors.append(F.expr("TextLeft", "Left", "{text}.left({count})", "Text", "left({text}, {count})", "Gives the first few characters from the start of some text.").param("text", "text", "Text", "Source string.", "expression").param("count", "3", "Count", "Characters from the left.", "expression"))
	descriptors.append(F.expr("TextRight", "Right", "{text}.right({count})", "Text", "right({text}, {count})", "Gives the last few characters from the end of some text.").param("text", "text", "Text", "Source string.", "expression").param("count", "3", "Count", "Characters from the right.", "expression"))
	descriptors.append(F.expr("TextMid", "Mid", "{text}.substr({from}, {count})", "Text", "mid({text}, {from}, {count})", "Gives a chunk of text starting at a position for a set length.").param("text", "text", "Text", "Source string.", "expression").param("from", "0", "From", "Start index.", "expression").param("count", "3", "Count", "Length.", "expression"))
	descriptors.append(F.expr("TextUpper", "Uppercase", "{text}.to_upper()", "Text", "uppercase({text})", "Gives the text converted to all uppercase letters.").param("text", "text", "Text", "Source string.", "expression"))
	descriptors.append(F.expr("TextLower", "Lowercase", "{text}.to_lower()", "Text", "lowercase({text})", "Gives the text converted to all lowercase letters.").param("text", "text", "Text", "Source string.", "expression"))
	descriptors.append(F.expr("TextLength", "Text Length", "{text}.length()", "Text", "len({text})", "Gives how many characters are in some text.").param("text", "text", "Text", "Source string.", "expression"))
	descriptors.append(F.expr("TextReplace", "Replace In Text", "{text}.replace({what}, {with})", "Text", "replace({text})", "Gives the text with every match of one substring swapped for another.").param("text", "text", "Text", "Source string.", "expression").param("what", "\"a\"", "Find", "Substring to replace.", "expression").param("with", "\"b\"", "With", "Replacement.", "expression"))
	descriptors.append(F.expr("TextTrim", "Trim", "{text}.strip_edges()", "Text", "trim({text})", "Gives the text with leading and trailing whitespace removed.").param("text", "text", "Text", "Source string.", "expression"))
	descriptors.append(F.expr("TextZeroPad", "Zero Pad", "(\"%0*d\" % [{digits}, {value}])", "Text", "zeropad({value}, {digits})", "Gives a number padded with leading zeros to a fixed width, like 007.").param("digits", "3", "Digits", "Total width.", "expression").param("value", "7", "Value", "Integer to pad.", "expression"))
	descriptors.append(F.expr("ToText", "To Text", "str({value})", "Text", "str({value})", "Gives any value as text, for joining into messages and labels.").param("value", "42", "Value", "Any value to turn into text.", "expression"))

	# Math expressions (the everyday number toolkit - degree-based trig included so angles read
	# the way sheet authors expect, no radians required)
	descriptors.append(F.expr("MathAbs", "Absolute Value", "absf({value})", "Math & Random", "abs({value})", "Gives the number without its sign: abs(-5) is 5.").param("value", "-5.0", "Value", "Number to strip the sign from.", "expression"))
	descriptors.append(F.expr("MathSqrt", "Square Root", "sqrt({value})", "Math & Random", "sqrt({value})", "Gives the square root of a number.").param("value", "9.0", "Value", "Number to take the root of.", "expression"))
	descriptors.append(F.expr("MathPow", "Power", "pow({base}, {exponent})", "Math & Random", "{base} ^ {exponent}", "Gives a number raised to a power: 2 ^ 8 is 256.").param("base", "2.0", "Base", "The number to raise.", "expression").param("exponent", "8.0", "Exponent", "The power to raise it to.", "expression"))
	descriptors.append(F.expr("MathExp", "Exponential", "exp({value})", "Math & Random", "exp({value})", "Gives e raised to a power, the natural growth curve.").param("value", "1.0", "Value", "The exponent for e.", "expression"))
	descriptors.append(F.expr("MathPi", "Pi", "PI", "Math & Random", "pi", "Gives the circle constant 3.14159…"))
	descriptors.append(F.expr("SinDegrees", "Sin (degrees)", "sin(deg_to_rad({degrees}))", "Math & Random", "sin({degrees})", "Gives the sine of an angle given in degrees - waves, bobbing, circular motion.").param("degrees", "90.0", "Degrees", "Angle in degrees.", "expression"))
	descriptors.append(F.expr("CosDegrees", "Cos (degrees)", "cos(deg_to_rad({degrees}))", "Math & Random", "cos({degrees})", "Gives the cosine of an angle given in degrees.").param("degrees", "0.0", "Degrees", "Angle in degrees.", "expression"))
	descriptors.append(F.expr("TanDegrees", "Tan (degrees)", "tan(deg_to_rad({degrees}))", "Math & Random", "tan({degrees})", "Gives the tangent of an angle given in degrees.").param("degrees", "45.0", "Degrees", "Angle in degrees.", "expression"))
	descriptors.append(F.expr("ToInteger", "To Integer", "int({value})", "Math & Random", "int({value})", "Gives the value as a whole number: int(\"42\") is 42, int(3.9) is 3.").param("value", "\"42\"", "Value", "Text or number to convert.", "expression"))
	descriptors.append(F.expr("ToDecimal", "To Decimal", "float({value})", "Math & Random", "float({value})", "Gives the value as a decimal number: float(\"3.5\") is 3.5.").param("value", "\"3.5\"", "Value", "Text or number to convert.", "expression"))

	# System actions (engine/frame control + the screenshot verb)
	descriptors.append(F.act("TakeScreenshot", "Take Screenshot", "get_viewport().get_texture().get_image().save_png({path})", "General Actions", "Take screenshot to {path}", "Saves what's on screen right now as a PNG file.").param("path", "\"user://screenshot.png\"", "Path", "Where to save the PNG (user:// is the writable folder).", "expression"))
	descriptors.append(F.act("SetMaxFps", "Set Max FPS", "Engine.max_fps = int({fps})", "Time", "Set max fps to {fps}", "Caps how many frames per second the game renders - save battery or steady the pace.").param("fps", "60", "FPS", "Frame cap (0 = uncapped).", "expression"))
	descriptors.append(F.act("SetPhysicsRate", "Set Physics Rate", "Engine.physics_ticks_per_second = int({fps})", "Time", "Set physics rate to {fps}", "Changes how often physics steps per second (default 60).").param("fps", "60", "Ticks", "Physics updates per second.", "expression"))
	descriptors.append(F.act("SetRandomSeed", "Set Random Seed", "seed(int({seed}))", "Math & Random", "Set random seed to {seed}", "Pins the global randomness so a run replays identically - daily challenges, replays, tests.").param("seed", "12345", "Seed", "Any integer - the same seed replays the same randomness.", "expression"))

	# System conditions (angle tests, value-type tests, fullscreen state)
	descriptors.append(F.cond("IsWithinAngle", "Is Within Angle", "absf(rad_to_deg(angle_difference(deg_to_rad({angle}), deg_to_rad({target})))) <= {within}", "Math & Random", "[b]{angle}[/b] is within [b]{within}[/b] of [i]{target}[/i]", "True when two angles are close, taking wrap-around into account (350 is within 20 of 10).").param("angle", "0.0", "Angle", "The angle to test (degrees).", "expression").param("within", "10.0", "Within", "Allowed difference in degrees.", "expression").param("target", "90.0", "Of Angle", "The angle to compare against (degrees).", "expression"))
	descriptors.append(F.cond("IsClockwiseFrom", "Is Clockwise From", "angle_difference(deg_to_rad({from}), deg_to_rad({angle})) >= 0.0", "Math & Random", "{angle} is clockwise from {from}", "True when the shortest turn from the reference angle to this one is clockwise (in 2D screen space, where +Y points down).").param("angle", "45.0", "Angle", "The angle to test (degrees).", "expression").param("from", "0.0", "From", "The reference angle (degrees).", "expression"))
	descriptors.append(F.cond("ValueIsNumber", "Value Is A Number", "(typeof({value}) == TYPE_FLOAT or typeof({value}) == TYPE_INT)", "Math & Random", "{value} is a number", "True when the value holds a number - guard untyped variables and loaded JSON before math.").param("value", "0", "Value", "The value to type-test.", "expression"))
	descriptors.append(F.cond("ValueIsText", "Value Is Text", "typeof({value}) == TYPE_STRING", "Text", "{value} is text", "True when the value holds text - guard untyped variables and loaded JSON before string work.").param("value", "\"text\"", "Value", "The value to type-test.", "expression"))
	descriptors.append(F.cond("IsNaNValue", "Is NaN", "is_nan({value})", "Math & Random", "{value} is NaN", "True when a calculation broke and produced not-a-number (like dividing zero by zero).").param("value", "0.0", "Value", "The number to test.", "expression"))
	descriptors.append(F.cond("IsFullscreen", "Is Fullscreen", "(DisplayServer.window_get_mode() == DisplayServer.WINDOW_MODE_FULLSCREEN or DisplayServer.window_get_mode() == DisplayServer.WINDOW_MODE_EXCLUSIVE_FULLSCREEN)", "Display", "is fullscreen", "True while the game window is in fullscreen mode - pair with Set Fullscreen Mode for a toggle."))

	# Shader params (event-sheet effects -> Godot materials), date & time, platform info
	descriptors.append(F.act("SetShaderParameter", "Set Effect Parameter", "material.set_shader_parameter(&{param}, {value})", "Effects", "Set effect parameter {param} to {value}", "Feeds a value into one of an effect's parameters to drive it at runtime.", "CanvasItem").param("param", "\"strength\"", "Parameter", "The effect parameter's name.").param("value", "1.0", "Value", "Value expression.", "expression"))
	descriptors.append(F.expr("GetDatetimeString", "Date & Time Text", "Time.get_datetime_string_from_system()", "Time", "datetime string", "Gives the system's current date and time as readable text."))
	descriptors.append(F.expr("GetUnixTime", "Date: Now", "Time.get_unix_time_from_system()", "Time", "Date.Now", "Gives the current Unix timestamp in seconds, useful for saving real-world time."))
	# ── the Date object ──────────────────────────────────────────────────────────────────────────
	# The calendar and the wall clock, one expression per field, so a clock label is written the way
	# it reads: `Date.Hour & ":" & Date.Minute`. Each one asks the system clock afresh, which is what
	# a row that shows the time needs; a whole timestamp to compare against is Date.Now.
	descriptors.append(F.expr("DateHour", "Date: Hour", "Time.get_datetime_dict_from_system().hour", "Time", "Date.Hour", "The hour on the system clock right now, 0 to 23."))
	descriptors.append(F.expr("DateMinute", "Date: Minute", "Time.get_datetime_dict_from_system().minute", "Time", "Date.Minute", "The minute on the system clock right now, 0 to 59."))
	descriptors.append(F.expr("DateSecond", "Date: Second", "Time.get_datetime_dict_from_system().second", "Time", "Date.Second", "The second on the system clock right now, 0 to 59."))
	descriptors.append(F.expr("DateYear", "Date: Year", "Time.get_datetime_dict_from_system().year", "Time", "Date.Year", "The year on the system calendar right now."))
	descriptors.append(F.expr("DateMonth", "Date: Month", "Time.get_datetime_dict_from_system().month", "Time", "Date.Month", "The month on the system calendar right now, 1 to 12."))
	descriptors.append(F.expr("DateDay", "Date: Day", "Time.get_datetime_dict_from_system().day", "Time", "Date.Day", "The day of the month on the system calendar right now, 1 to 31."))
	descriptors.append(F.expr("DateWeekday", "Date: Weekday", "Time.get_datetime_dict_from_system().weekday", "Time", "Date.Weekday", "Which day of the week it is right now, 0 for Sunday through 6 for Saturday - what a daily-reward or weekend-bonus row asks."))
	descriptors.append(F.expr("GetOSName", "OS Name", "OS.get_name()", "Platform", "os name", "Gives the name of the operating system the game is running on."))
	# Feature tags upgraded from a fixed 8-entry dropdown to an editable suggest combo: the
	# full curated tag set is one pick away, and a CUSTOM tag (export presets can define
	# any) is typeable - same ace_id, same template, same quoted-value shape, so every
	# existing sheet compiles and lifts unchanged.
	descriptors.append(F.cond("HasOSFeature", "Platform Has Feature", "OS.has_feature({feature})", "Platform", "platform has {feature}", "True when the current platform supports the given feature tag - mobile, web, editor, debug/release, a specific OS, or any custom tag your export preset defines.").param_suggesting("feature", "\"mobile\"", "Feature", "Feature tag to test - pick a common one or type a custom tag from your export preset.", [ "\"mobile\"", "\"pc\"", "\"web\"", "\"android\"", "\"ios\"", "\"windows\"", "\"linux\"", "\"macos\"", "\"editor\"", "\"debug\"", "\"release\"", "\"template\"", "\"template_debug\"", "\"template_release\"", "\"movie\"", "\"threads\"", "\"touchscreen\"", "\"etc2\"", "\"s3tc\"" ], "feature_tag"))
	# Stateful conditions (the Every X seconds pattern): each applied instance owns a member;
	# the prelude accumulates frame time (get_process_delta_time, defined on any Node) before the
	# if, on_true rebases inside it. Compiles under any trigger; best used under a per-frame one.
	descriptors.append(F.cond("EveryXSeconds", "Every X Seconds", "__every_{uid} >= maxf({seconds}, 0.001)", "Time", "Every {seconds} seconds", "True once each time the chosen number of seconds passes, for repeating timers.").param("seconds", "1.0", "Seconds", "Interval between runs (needs a per-frame trigger).", "expression").stateful("var __every_{uid}: float = 0.0", "__every_{uid} += get_process_delta_time()", "__every_{uid} = fmod(__every_{uid}, maxf({seconds}, 0.001))"))
	# Every X To Y Seconds: the varied-cadence sibling of Every X Seconds. Two members per instance -
	# the accumulator and the interval that was rolled for THIS wait - so the helper can fire and
	# immediately re-roll the next gap. The -1 sentinel means "no interval rolled yet", which keeps the
	# very first wait random too instead of always using the minimum.
	descriptors.append(F.cond("EveryRandomSeconds", "Every X To Y Seconds", "__everyr_{uid}(maxf({min_seconds}, 0.001), maxf({max_seconds}, 0.001))", "Time", "Every {min_seconds} to {max_seconds} seconds", "True once each time a random wait between the two lengths passes - spawner and idle-chatter cadence that never looks metronomic. Needs a per-frame trigger, like Every X Seconds; each firing re-rolls the next wait.").param("min_seconds", "2.0", "From", "Shortest wait between runs.", "expression").param("max_seconds", "5.0", "To", "Longest wait between runs.", "expression").stateful("var __everyr_time_{uid}: float = 0.0\nvar __everyr_next_{uid}: float = -1.0\n\nfunc __everyr_{uid}(min_seconds: float, max_seconds: float) -> bool:\n\tif __everyr_next_{uid} < 0.0:\n\t\t__everyr_next_{uid} = randf_range(min_seconds, maxf(max_seconds, min_seconds))\n\tif __everyr_time_{uid} < __everyr_next_{uid}:\n\t\treturn false\n\t__everyr_time_{uid} = 0.0\n\t__everyr_next_{uid} = randf_range(min_seconds, maxf(max_seconds, min_seconds))\n\treturn true", "__everyr_time_{uid} += get_process_delta_time()"))
	# Trigger Once: run the event only on the FIRST tick of each stretch where the row's OTHER conditions
	# hold, re-arming once they go false again. .evaluated_last() HOISTS the term to the end of the emitted
	# `and` chain no matter which condition cell it sits in, so short-circuiting guarantees it is reached
	# exactly when everything else is true - which makes "was I reached on the previous tick?" exactly the
	# question "were the other conditions already true last tick?". The prelude ages a per-instance tick
	# counter every tick; the helper reads it and zeroes it the moment the term is reached, so a gap wider
	# than one tick is the rising edge. On its own (no other conditions) it fires exactly once.
	descriptors.append(F.cond("TriggerOnce", "Trigger Once", "__trigger_once_{uid}()", "Run Context", "Trigger once while true", "True only on the first tick each time the event's other conditions become true, and again after they have gone false. Works in any condition slot.").stateful("var __once_{uid}: int = 1\n\nfunc __trigger_once_{uid}() -> bool:\n\tvar ticks_since_last: int = __once_{uid}\n\t__once_{uid} = 0\n\treturn ticks_since_last > 1", "__once_{uid} += 1").evaluated_last())
	# Has Changed: the "value watcher" edge gate. A per-instance previous-value slot plus a helper
	# that compares and rebases in one call, so the term is a plain bool expression usable in any
	# condition cell. The first tick after the row starts running only SEEDS the slot (returns false),
	# which is why a value that starts different from null does not fire spuriously on frame one.
	descriptors.append(F.cond("HasChanged", "Has Changed", "__has_changed_{uid}({value})", "Run Context", "{value} has changed", "True on any tick where the watched value differs from the tick before (needs a per-frame trigger).").param("value", "0", "Value", "The value to watch - true on the tick it becomes different.", "expression").stateful("var __changed_prev_{uid}: Variant = null\nvar __changed_seen_{uid}: bool = false\n\nfunc __has_changed_{uid}(current: Variant) -> bool:\n\tif not __changed_seen_{uid}:\n\t\t__changed_seen_{uid} = true\n\t\t__changed_prev_{uid} = current\n\t\treturn false\n\tif current == __changed_prev_{uid}:\n\t\treturn false\n\t__changed_prev_{uid} = current\n\treturn true"))
	# Cooldowns: named, stateless, and shared across every row on the host - the deadline lives in
	# node metadata keyed by name, so Start Cooldown here and Cooldown Is Ready in a different event
	# (or a different sheet on the same node) agree without any wiring. No members, no {uid}.
	descriptors.append(F.act("StartCooldown", "Start Cooldown", "set_meta(&\"__ef_cool_\" + str({name}), Time.get_ticks_msec() + int(maxf({seconds}, 0.0) * 1000.0))", "Time", "start cooldown {name} for {seconds}s", "Starts (or restarts) a named cooldown that lasts the given number of seconds.").param("name", "\"dash\"", "Name", "Cooldown name - any label you also use in Cooldown Is Ready.", "expression").param("seconds", "1.0", "Seconds", "How long the cooldown lasts.", "expression"))
	descriptors.append(F.cond("CooldownReady", "Cooldown Is Ready", "Time.get_ticks_msec() >= int(get_meta(&\"__ef_cool_\" + str({name}), 0))", "Time", "cooldown {name} is ready", "True when the named cooldown has finished. A cooldown that was never started counts as ready, so the first use is always allowed.").param("name", "\"dash\"", "Name", "Cooldown name, matching a Start Cooldown action.", "expression"))
	descriptors.append(F.expr("CooldownTimeLeft", "Cooldown Time Left", "(maxf(0.0, float(int(get_meta(&\"__ef_cool_\" + str({name}), 0)) - Time.get_ticks_msec()) / 1000.0))", "Time", "cooldown {name} time left", "Gives the seconds left on a named cooldown, or 0 when it is ready - handy for a HUD readout.").param("name", "\"dash\"", "Name", "Cooldown name, matching a Start Cooldown action.", "expression"))
	# Input buffering: the same name-keyed metadata trick as the cooldowns above, read the other way
	# round - a deadline in the FUTURE means the press still counts. Stateless and shared across the
	# host, so the buffer is written in the input event and read wherever the act actually happens.
	descriptors.append(F.act("BufferPress", "Buffer Press", "set_meta(&\"__ef_buffer_\" + str({name}), Time.get_ticks_msec() + int(maxf({seconds}, 0.0) * 1000.0))", "Time", "buffer press {name} for {seconds}s", "Remembers a press for a fraction of a second, so an input made slightly too early still counts. Record it when the button goes down, check Press Is Buffered where the act happens, then Clear Buffer.").param("name", "\"jump\"", "Name", "Buffer name - any label you also use in Press Is Buffered.", "expression").param("seconds", "0.12", "Seconds", "How long the press stays remembered.", "expression"))
	descriptors.append(F.cond("PressIsBuffered", "Press Is Buffered", "Time.get_ticks_msec() <= int(get_meta(&\"__ef_buffer_\" + str({name}), 0))", "Time", "press {name} is buffered", "True while a recently buffered press is still valid - the player pressed jump just before landing, and it should still fire.").param("name", "\"jump\"", "Name", "Buffer name, matching a Buffer Press action.", "expression"))
	descriptors.append(F.act("ClearBuffer", "Clear Buffer", "set_meta(&\"__ef_buffer_\" + str({name}), 0)", "Time", "clear buffered press {name}", "Forgets a buffered press. Consume the buffer right after acting on it so one press never fires twice.").param("name", "\"jump\"", "Name", "Buffer name, matching a Buffer Press action.", "expression"))
	# Was Recently True: coyote time, said plainly. The helper stamps the moment the watched value was
	# last true and answers "recently?" for the window after it - so "is_on_floor() was true within
	# 0.1s" IS the forgiving jump, with no hand-rolled timer member in the sheet.
	descriptors.append(F.cond("WasRecentlyTrue", "Was Recently True", "__recent_{uid}(bool({value}), maxf({window}, 0.0))", "Run Context", "{value} was true within {window}s", "True while the watched condition is true, and for a moment after it stops. This is coyote time: \"is_on_floor() was true within 0.1s\" lets a player jump just after walking off a ledge. Needs a per-frame trigger so the moment gets stamped.").param("value", "true", "Value", "The condition to remember, e.g. is_on_floor().", "expression").param("window", "0.1", "For Seconds", "How long after it goes false it still counts.", "expression").stateful("var __recent_at_{uid}: int = -1000000\n\nfunc __recent_{uid}(current: bool, window: float) -> bool:\n\tif current:\n\t\t__recent_at_{uid} = Time.get_ticks_msec()\n\t\treturn true\n\treturn Time.get_ticks_msec() - __recent_at_{uid} <= int(window * 1000.0)"))
	# Group population edges: one member remembers last tick's count, so the helper can answer "did
	# this group just empty / just fill?" - the wave director's two triggers. The -1 start means a group
	# that is already empty on the first tick does NOT count as having just emptied.
	#
