	descriptors.append(F.cond("OnGroupEmptied", "On Group Emptied", "__group_emptied_{uid}({group})", "Run Context", "on group {group} emptied", "True on the single tick a watched group's last member leaves or dies - the wave director's trigger, without counting nodes by hand. A group that is already empty at startup never fires it. Needs a per-frame trigger.").param("group", "\"enemies\"", "Group", "Group to watch.", "group_reference").stateful("var __gcount_{uid}: int = -1\n\nfunc __group_emptied_{uid}(group_name: String) -> bool:\n\tvar count: int = get_tree().get_nodes_in_group(group_name).size()\n\tvar previous: int = __gcount_{uid}\n\t__gcount_{uid} = count\n\treturn previous > 0 and count == 0"))
