	descriptors.append(F.cond("ShapeCast3DIsColliding", "ShapeCast Is Colliding (3D)", "is_colliding()", CAT_3D, "ShapeCast is colliding", "True when the swept shape is touching anything along its path.", "ShapeCast3D").featured())
	descriptors.append(F.act("ShapeCast3DForceUpdate", "Force ShapeCast Update (3D)", "force_shapecast_update()", CAT_3D, "Force shapecast update", "Re-runs the sweep immediately instead of waiting for the next physics frame - do this after moving or re-aiming it in the same frame you read it.", "ShapeCast3D"))
	descriptors.append(F.act("ShapeCast3DSetTarget", "Point ShapeCast At (3D)", "target_position = {reach}", CAT_3D, "Point shapecast at {reach}", "Aims the sweep and sets its length, measured from the shapecast itself.", "ShapeCast3D").param("reach", "Vector3(0, 0, -10)", "Target", "How far and in which direction to sweep, RELATIVE to the ShapeCast3D node.", "expression"))
	descriptors.append(F.act("ShapeCast3DSetEnabled", "Enable ShapeCast (3D)", "enabled = {on}", CAT_3D, "Set shapecast enabled to {on}", "Turns the sweep on or off.", "ShapeCast3D").param_choice("on", "true", "Enabled", "true to sweep every physics frame.", ["true", "false"]))
	descriptors.append(F.expr("ShapeCast3DCount", "ShapeCast Hit Count (3D)", "get_collision_count()", CAT_3D, "shapecast hit count", "How many objects the sweep is touching. Unlike a plain ray, a shapecast can report several at once.", "ShapeCast3D"))
	descriptors.append(F.expr("ShapeCast3DColliderAt", "ShapeCast Collider At (3D)", "get_collider({index})", CAT_3D, "shapecast collider at {index}", "Returns one of the objects the sweep is touching, by position in the hit list.", "ShapeCast3D").param("index", "0", "Index", "Which hit to read, starting at 0 (see ShapeCast Hit Count).", "expression"))
	descriptors.append(F.expr("ShapeCast3DPointAt", "ShapeCast Hit Point At (3D)", "get_collision_point({index})", CAT_3D, "shapecast hit point at {index}", "The world point where one of the sweep's hits touches.", "ShapeCast3D").param("index", "0", "Index", "Which hit to read, starting at 0.", "expression"))
	descriptors.append(F.expr("ShapeCast3DNormalAt", "ShapeCast Hit Normal At (3D)", "get_collision_normal({index})", CAT_3D, "shapecast hit normal at {index}", "The surface direction at one of the sweep's hits - bounce and slide maths start here.", "ShapeCast3D").param("index", "0", "Index", "Which hit to read, starting at 0.", "expression"))
	descriptors.append(F.expr("ShapeCast3DSafeFraction", "ShapeCast Safe Fraction (3D)", "get_closest_collision_safe_fraction()", CAT_3D, "shapecast safe fraction", "How far along the sweep the shape can travel WITHOUT touching anything, from 0 (blocked immediately) to 1 (path is clear). Multiply the target by it to stop just short of the wall.", "ShapeCast3D"))
	descriptors.append(F.expr("ShapeCast3DUnsafeFraction", "ShapeCast Unsafe Fraction (3D)", "get_closest_collision_unsafe_fraction()", CAT_3D, "shapecast unsafe fraction", "How far along the sweep the shape is first touching something, from 0 to 1 - the contact point to the safe fraction's stopping point.", "ShapeCast3D"))
	descriptors.append(F.act("ShapeCast3DSetMask", "Set ShapeCast Mask (3D)", "collision_mask = {mask}", CAT_3D, "Set shapecast mask to {mask}", "Chooses which collision layers the sweep can see.", "ShapeCast3D").param("mask", "1", "Mask", "Collision mask as a number - each layer is a bit.", "expression"))
	descriptors.append(F.act("ShapeCast3DSetMargin", "Set ShapeCast Margin (3D)", "margin = {margin}", CAT_3D, "Set shapecast margin to {margin}", "Pads the swept shape slightly. A small margin makes contact detection steadier when the shape slides along a surface.", "ShapeCast3D").param("margin", "0.0", "Margin", "Extra padding around the shape, in metres.", "expression"))
	descriptors.append(F.act("ShapeCast3DSetMaxResults", "Set ShapeCast Max Results (3D)", "max_results = {max_results}", CAT_3D, "Set shapecast max results to {max_results}", "Caps how many objects one sweep will report, which bounds its cost in a crowd.", "ShapeCast3D").param("max_results", "32", "Max Results", "Most hits to collect in one sweep.", "expression"))
	descriptors.append(F.act("ShapeCast3DAddException", "Ignore Node In ShapeCast (3D)", "add_exception({node})", CAT_3D, "Ignore {node} in shapecast", "Makes the sweep pass straight through one specific object.", "ShapeCast3D").param_typed("Node", "node", "get_parent() as CollisionObject3D", "Node", "The object the sweep should pass through. Must be a CollisionObject3D.", "expression"))
	descriptors.append(F.act("ShapeCast3DClearExceptions", "Clear ShapeCast Exceptions (3D)", "clear_exceptions()", CAT_3D, "Clear shapecast exceptions", "Forgets every ignored object, so the sweep hits everything on its mask again.", "ShapeCast3D"))


# ── 5. One-off 2D space-state queries: cast from anywhere, no node required. Cast Ray Into fires
# ONCE and stores the result, so asking for the point AND the collider is a single cast. ──
static func _add_world_queries_2d(descriptors: Array[ACEDescriptor]) -> void:
	descriptors.append(F.act("CastRayInto2D", "Cast Ray Into (2D)", "var __rq_{uid} := PhysicsRayQueryParameters2D.create({from}, {to}, {mask}, {exclude})\n__rq_{uid}.collide_with_areas = {hit_areas}\n{into} = get_world_2d().direct_space_state.intersect_ray(__rq_{uid})", CAT_2D, "Cast ray {from} -> {to} into {into}", "Fires one ray through the world and stores everything it learned in a variable. Use this instead of the single-shot expressions when you want more than one fact about the hit - they each re-cast the ray.", "Node2D").param("into", "hit", "Into Variable", "Variable receiving the hit as a Dictionary (empty when the ray hit nothing). Read it with the Ray Result ACEs.", "variable_reference").param("from", "global_position", "From", "World point the ray starts at (Vector2 expression).", "expression").param("to", "global_position + Vector2(0, 100)", "To", "World point the ray ends at (Vector2 expression).", "expression").param("mask", "4294967295", "Mask", "Collision layers to test against. The default sees every layer.", "expression").param("exclude", "[]", "Ignore", "Array of physics RIDs to skip, e.g. [get_rid()] to ignore yourself.", "expression").param_choice("hit_areas", "false", "Detect Areas", "true to notice Area2D nodes as well as bodies.", ["true", "false"]).featured())
	descriptors.append(F.expr("WorldRaycastNormal2D", "World Raycast Normal (2D)", "get_world_2d().direct_space_state.intersect_ray(PhysicsRayQueryParameters2D.create({from}, {to})).get(\"normal\", Vector2.ZERO)", CAT_2D, "world raycast normal {from} -> {to}", "The surface direction where a one-off ray hits, or a zero vector when it hits nothing.", "Node2D").param("from", "Vector2(0, 0)", "From", "Ray start (Vector2 expression).", "expression").param("to", "Vector2(0, 0)", "To", "Ray end (Vector2 expression).", "expression"))
