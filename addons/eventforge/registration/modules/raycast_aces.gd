# ── 7. Reading a stored cast result. Cast Ray Into hands back the raw Dictionary Godot produced;
# these name its keys so a sheet never has to know them, and read a variable rather than re-casting. ──
static func _add_ray_result_readers(descriptors: Array[ACEDescriptor]) -> void:
	descriptors.append(F.cond("RayResultHit2D", "Ray Result Hit Something (2D)", "not {result}.is_empty()", CAT_2D, "{result} hit something", "True when the stored cast found something. An empty result means the ray reached its end without touching anything.", "Node2D").param("result", "hit", "Result", "The variable a Cast Ray Into filled.", "variable_reference").featured())
	descriptors.append(F.expr("RayResultCollider2D", "Ray Result Collider (2D)", "{result}.get(\"collider\", null)", CAT_2D, "{result} collider", "The object the stored cast hit, or nothing when it hit thin air.", "Node2D").param("result", "hit", "Result", "The variable a Cast Ray Into filled.", "variable_reference"))
	descriptors.append(F.expr("RayResultPoint2D", "Ray Result Point (2D)", "{result}.get(\"position\", Vector2.ZERO)", CAT_2D, "{result} point", "Where in the world the stored cast struck - spawn the impact spark here.", "Node2D").param("result", "hit", "Result", "The variable a Cast Ray Into filled.", "variable_reference"))
	descriptors.append(F.expr("RayResultNormal2D", "Ray Result Normal (2D)", "{result}.get(\"normal\", Vector2.ZERO)", CAT_2D, "{result} normal", "Which way the surface faces at the hit - reflect the velocity around it to bounce, or align a decal to it.", "Node2D").param("result", "hit", "Result", "The variable a Cast Ray Into filled.", "variable_reference"))
	descriptors.append(F.expr("RayResultShape2D", "Ray Result Shape Index (2D)", "{result}.get(\"shape\", -1)", CAT_2D, "{result} shape index", "Which of the hit object's collision shapes was struck, as an index - tell a headshot from a body shot.", "Node2D").param("result", "hit", "Result", "The variable a Cast Ray Into filled.", "variable_reference"))
	descriptors.append(F.cond("RayResultInGroup2D", "Ray Result Is In Group (2D)", "({result}.get(\"collider\", null) != null and {result}[\"collider\"].is_in_group({group}))", CAT_2D, "{result} is in {group}", "True when the stored cast hit something belonging to a group, checking for nothing-hit first so it is safe on a clear ray.", "Node2D").param("result", "hit", "Result", "The variable a Cast Ray Into filled.", "variable_reference").param("group", "\"enemies\"", "Group", "Group name to test the hit object against.", "expression"))
	descriptors.append(F.cond("RayResultHit3D", "Ray Result Hit Something (3D)", "not {result}.is_empty()", CAT_3D, "{result} hit something", "True when the stored cast found something. An empty result means the ray reached its end without touching anything.", "Node3D").param("result", "hit", "Result", "The variable a Cast Ray Into filled.", "variable_reference").featured())
	descriptors.append(F.expr("RayResultCollider3D", "Ray Result Collider (3D)", "{result}.get(\"collider\", null)", CAT_3D, "{result} collider", "The object the stored cast hit, or nothing when it hit thin air.", "Node3D").param("result", "hit", "Result", "The variable a Cast Ray Into filled.", "variable_reference"))
	descriptors.append(F.expr("RayResultPoint3D", "Ray Result Point (3D)", "{result}.get(\"position\", Vector3.ZERO)", CAT_3D, "{result} point", "Where in the world the stored cast struck - spawn the impact effect or bullet hole here.", "Node3D").param("result", "hit", "Result", "The variable a Cast Ray Into filled.", "variable_reference"))
	descriptors.append(F.expr("RayResultNormal3D", "Ray Result Normal (3D)", "{result}.get(\"normal\", Vector3.ZERO)", CAT_3D, "{result} normal", "Which way the surface faces at the hit - reflect the velocity around it to bounce, or lay a decal flat against it.", "Node3D").param("result", "hit", "Result", "The variable a Cast Ray Into filled.", "variable_reference"))
	descriptors.append(F.expr("RayResultShape3D", "Ray Result Shape Index (3D)", "{result}.get(\"shape\", -1)", CAT_3D, "{result} shape index", "Which of the hit object's collision shapes was struck, as an index - tell a headshot from a body shot.", "Node3D").param("result", "hit", "Result", "The variable a Cast Ray Into filled.", "variable_reference"))
	descriptors.append(F.expr("RayResultFaceIndex3D", "Ray Result Face Index (3D)", "{result}.get(\"face_index\", -1)", CAT_3D, "{result} face index", "Which triangle of a concave mesh was hit, as an index (-1 for other shape types) - for reading per-face surface data like footstep materials.", "Node3D").param("result", "hit", "Result", "The variable a Cast Ray Into filled.", "variable_reference"))
	descriptors.append(F.cond("RayResultInGroup3D", "Ray Result Is In Group (3D)", "({result}.get(\"collider\", null) != null and {result}[\"collider\"].is_in_group({group}))", CAT_3D, "{result} is in {group}", "True when the stored cast hit something belonging to a group, checking for nothing-hit first so it is safe on a clear ray.", "Node3D").param("result", "hit", "Result", "The variable a Cast Ray Into filled.", "variable_reference").param("group", "\"enemies\"", "Group", "Group name to test the hit object against.", "expression"))


# ── 8. Camera picking: the screen-to-world ray. Mouse Ray Origin/Direction already gave the two
# halves; these do the whole job, so "what is under the cursor" is one row instead of vector maths. ──
static func _add_camera_picking(descriptors: Array[ACEDescriptor]) -> void:
	descriptors.append(F.act("CastMouseRayInto3D", "Cast Ray From Mouse Into (3D)", "var __cam_{uid} := get_viewport().get_camera_3d()\nvar __mouse_{uid} := get_viewport().get_mouse_position()\nvar __from_{uid} := __cam_{uid}.project_ray_origin(__mouse_{uid})\nvar __to_{uid} := __from_{uid} + __cam_{uid}.project_ray_normal(__mouse_{uid}) * {distance}\nvar __rq_{uid} := PhysicsRayQueryParameters3D.create(__from_{uid}, __to_{uid}, {mask}, {exclude})\n__rq_{uid}.collide_with_areas = {hit_areas}\n{into} = get_world_3d().direct_space_state.intersect_ray(__rq_{uid})", CAT_3D, "Cast ray from mouse into {into}", "Shoots a ray from the camera through the mouse cursor and stores what it finds - the whole of click-to-select in 3D, in one row. Needs an active Camera3D.", "Node3D").param("into", "hit", "Into Variable", "Variable receiving the hit as a Dictionary (empty when nothing is under the cursor). Read it with the Ray Result ACEs.", "variable_reference").param("distance", "1000.0", "Distance", "How far into the scene to reach, in metres.", "expression").param("mask", "4294967295", "Mask", "Collision layers to test against. The default sees every layer.", "expression").param("exclude", "[]", "Ignore", "Array of physics RIDs to skip.", "expression").param_choice("hit_areas", "false", "Detect Areas", "true to notice Area3D nodes as well as bodies.", ["true", "false"]).featured())
	descriptors.append(F.cond("MouseRayHits3D", "Mouse Ray Hits Something (3D)", "not get_world_3d().direct_space_state.intersect_ray(PhysicsRayQueryParameters3D.create(get_viewport().get_camera_3d().project_ray_origin(get_viewport().get_mouse_position()), get_viewport().get_camera_3d().project_ray_origin(get_viewport().get_mouse_position()) + get_viewport().get_camera_3d().project_ray_normal(get_viewport().get_mouse_position()) * {distance})).is_empty()", CAT_3D, "mouse ray hits something within {distance}", "True when the cursor is over something solid. Casts on the spot - for more than a yes/no answer, use Cast Ray From Mouse Into and read the result.", "Node3D").param("distance", "1000.0", "Distance", "How far into the scene to reach, in metres.", "expression"))
	descriptors.append(F.expr("MouseRayCollider3D", "Mouse Ray Collider (3D)", "get_world_3d().direct_space_state.intersect_ray(PhysicsRayQueryParameters3D.create(get_viewport().get_camera_3d().project_ray_origin(get_viewport().get_mouse_position()), get_viewport().get_camera_3d().project_ray_origin(get_viewport().get_mouse_position()) + get_viewport().get_camera_3d().project_ray_normal(get_viewport().get_mouse_position()) * {distance})).get(\"collider\", null)", CAT_3D, "mouse ray collider within {distance}", "The object under the mouse cursor, or nothing when the cursor is over empty space.", "Node3D").param("distance", "1000.0", "Distance", "How far into the scene to reach, in metres.", "expression"))
	descriptors.append(F.expr("MouseRayPoint3D", "Mouse Ray Point (3D)", "get_world_3d().direct_space_state.intersect_ray(PhysicsRayQueryParameters3D.create(get_viewport().get_camera_3d().project_ray_origin(get_viewport().get_mouse_position()), get_viewport().get_camera_3d().project_ray_origin(get_viewport().get_mouse_position()) + get_viewport().get_camera_3d().project_ray_normal(get_viewport().get_mouse_position()) * {distance})).get(\"position\", Vector3.ZERO)", CAT_3D, "mouse ray point within {distance}", "The world point the cursor is pointing at - where to place a build ghost, a move order marker, or a decal.", "Node3D").param("distance", "1000.0", "Distance", "How far into the scene to reach, in metres.", "expression"))
