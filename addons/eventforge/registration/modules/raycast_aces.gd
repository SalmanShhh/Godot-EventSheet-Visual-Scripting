# ── 5. One-off 2D space-state queries: cast from anywhere, no node required. Cast Ray Into fires
# ONCE and stores the result, so asking for the point AND the collider is a single cast. ──
static func _add_world_queries_2d(descriptors: Array[ACEDescriptor]) -> void:
	descriptors.append(F.make_descriptor("Core", "CastRayInto2D", "Cast Ray Into (2D)", ACEDescriptor.ACEType.ACTION, "var __rq_{uid} := PhysicsRayQueryParameters2D.create({from}, {to}, {mask}, {exclude})\n__rq_{uid}.collide_with_areas = {hit_areas}\n{into} = get_world_2d().direct_space_state.intersect_ray(__rq_{uid})", "", [F.make_param("into", "String", "hit", "Into Variable", "Variable receiving the hit as a Dictionary (empty when the ray hit nothing). Read it with the Ray Result ACEs.", "variable_reference"), F.make_param("from", "String", "global_position", "From", "World point the ray starts at (Vector2 expression).", "expression"), F.make_param("to", "String", "global_position + Vector2(0, 100)", "To", "World point the ray ends at (Vector2 expression).", "expression"), F.make_param("mask", "String", "4294967295", "Mask", "Collision layers to test against. The default sees every layer.", "expression"), F.make_param("exclude", "String", "[]", "Ignore", "Array of physics RIDs to skip, e.g. [get_rid()] to ignore yourself.", "expression"), F.make_param("hit_areas", "String", "false", "Detect Areas", "true to notice Area2D nodes as well as bodies.", "", ["true", "false"])], CAT_2D, "Cast ray {from} -> {to} into {into}", "Node2D")
		.described("Fires one ray through the world and stores everything it learned in a variable. Use this instead of the single-shot expressions when you want more than one fact about the hit - they each re-cast the ray.").featured())
	descriptors.append(F.make_descriptor("Core", "WorldRaycastNormal2D", "World Raycast Normal (2D)", ACEDescriptor.ACEType.EXPRESSION, "get_world_2d().direct_space_state.intersect_ray(PhysicsRayQueryParameters2D.create({from}, {to})).get(\"normal\", Vector2.ZERO)", "", [F.make_param("from", "String", "Vector2(0, 0)", "From", "Ray start (Vector2 expression).", "expression"), F.make_param("to", "String", "Vector2(0, 0)", "To", "Ray end (Vector2 expression).", "expression")], CAT_2D, "world raycast normal {from} -> {to}", "Node2D")
		.described("The surface direction where a one-off ray hits, or a zero vector when it hits nothing."))
	descriptors.append(F.make_descriptor("Core", "QueryBodiesUnderMouse2D", "Query Bodies Under Mouse (2D)", ACEDescriptor.ACEType.ACTION, "var __pq_{uid} := PhysicsPointQueryParameters2D.new()\n__pq_{uid}.position = get_global_mouse_position()\n__pq_{uid}.collide_with_areas = {hit_areas}\n{into} = []\nfor __hit_{uid} in get_world_2d().direct_space_state.intersect_point(__pq_{uid}, {max_results}):\n\t{into}.append(__hit_{uid}.get(\"collider\"))", "", [F.make_param("into", "String", "picked", "Into Variable", "Variable receiving the Array of objects under the cursor.", "variable_reference"), F.make_param("hit_areas", "String", "true", "Detect Areas", "true to notice Area2D nodes as well as bodies.", "", ["true", "false"]), F.make_param("max_results", "String", "32", "Max Results", "Most objects to collect.", "expression")], CAT_2D, "Query bodies under mouse into {into}", "Node2D")
		.described("Collects everything the mouse cursor is over into a variable - click-to-select for 2D games, without any coordinate maths.").featured())
	descriptors.append(F.make_descriptor("Core", "CastCircleMotion2D", "Cast Circle Motion Into (2D)", ACEDescriptor.ACEType.ACTION, "var __cs_{uid} := CircleShape2D.new()\n__cs_{uid}.radius = {radius}\nvar __sq_{uid} := PhysicsShapeQueryParameters2D.new()\n__sq_{uid}.shape = __cs_{uid}\n__sq_{uid}.transform = Transform2D(0.0, {from})\n__sq_{uid}.motion = {motion}\n__sq_{uid}.collision_mask = {mask}\nvar __cm_{uid} := get_world_2d().direct_space_state.cast_motion(__sq_{uid})\n{into} = __cm_{uid}[0] if __cm_{uid}.size() > 0 else 1.0", "", [F.make_param("into", "String", "travel", "Into Variable", "Variable receiving how much of the move is clear, from 0 to 1.", "variable_reference"), F.make_param("from", "String", "global_position", "From", "Where the circle starts (Vector2 expression).", "expression"), F.make_param("motion", "String", "Vector2(0, 100)", "Motion", "The move to test, as an offset from the start.", "expression"), F.make_param("radius", "String", "16.0", "Radius", "Circle radius in pixels.", "expression"), F.make_param("mask", "String", "4294967295", "Mask", "Collision layers to test against.", "expression")], CAT_2D, "Cast circle motion {motion} into {into}", "Node2D")
		.described("Asks how far a circle could travel before something stops it, as a fraction of the move (1 means the whole path is clear). Multiply the motion by it to move right up to the obstacle."))


# ── 6. One-off 3D space-state queries: the 3D world had no point or volume query at all, and its
# one-off ray could only report hit/point - not what it hit, or which way the surface faces. ──
