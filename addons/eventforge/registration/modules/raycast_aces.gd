		.described("Fires one ray through the world and stores everything it learned in a variable. Use this instead of the single-shot expressions when you want more than one fact about the hit - they each re-cast the ray.").featured())
	descriptors.append(F.make_descriptor("Core", "WorldRaycastCollider3D", "World Raycast Collider (3D)", ACEDescriptor.ACEType.EXPRESSION, "get_world_3d().direct_space_state.intersect_ray(PhysicsRayQueryParameters3D.create({from}, {to})).get(\"collider\", null)", "", [F.make_param("from", "String", "Vector3(0, 0, 0)", "From", "Ray start (Vector3 expression).", "expression"), F.make_param("to", "String", "Vector3(0, 0, 0)", "To", "Ray end (Vector3 expression).", "expression")], CAT_3D, "world raycast collider {from} -> {to}", "Node3D")
		.described("The object a one-off ray hits, or nothing when the path is clear."))
