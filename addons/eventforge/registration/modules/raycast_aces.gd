		.described("The surface direction where a one-off ray hits, or a zero vector when it hits nothing - what you reflect a bounce around."))
	descriptors.append(F.make_descriptor("Core", "QueryBodiesAtPoint3D", "Query Bodies At Point (3D)", ACEDescriptor.ACEType.ACTION, "var __pq_{uid} := PhysicsPointQueryParameters3D.new()\n__pq_{uid}.position = {point}\n__pq_{uid}.collide_with_areas = {hit_areas}\n{into} = []\nfor __hit_{uid} in get_world_3d().direct_space_state.intersect_point(__pq_{uid}, {max_results}):\n\t{into}.append(__hit_{uid}.get(\"collider\"))", "", [F.make_param("into", "String", "data", "Into Variable", "Variable receiving the Array of overlapping objects.", "variable_reference"), F.make_param("point", "String", "global_position", "Point", "World position to test (Vector3 expression).", "expression"), F.make_param("hit_areas", "String", "false", "Detect Areas", "true to notice Area3D nodes as well as bodies.", "", ["true", "false"]), F.make_param("max_results", "String", "32", "Max Results", "Most objects to collect.", "expression")], CAT_OVERLAP_3D, "query bodies at {point} into {into}", "Node3D")
		.described("Collects every physics object at a world point into a variable - like tapping the world with a finger."))
	descriptors.append(F.make_descriptor("Core", "QueryBodiesInSphere3D", "Query Bodies In Sphere (3D)", ACEDescriptor.ACEType.ACTION, "var __ss_{uid} := SphereShape3D.new()\n__ss_{uid}.radius = {radius}\nvar __sq_{uid} := PhysicsShapeQueryParameters3D.new()\n__sq_{uid}.shape = __ss_{uid}\n__sq_{uid}.transform = Transform3D(Basis(), {center})\n__sq_{uid}.collision_mask = {mask}\n{into} = []\nfor __hit_{uid} in get_world_3d().direct_space_state.intersect_shape(__sq_{uid}, {max_results}):\n\t{into}.append(__hit_{uid}.get(\"collider\"))", "", [F.make_param("into", "String", "data", "Into Variable", "Variable receiving the Array of overlapping objects.", "variable_reference"), F.make_param("center", "String", "global_position", "Center", "Sphere center in world space (Vector3 expression).", "expression"), F.make_param("radius", "String", "5.0", "Radius", "Sphere radius in metres.", "expression"), F.make_param("mask", "String", "4294967295", "Mask", "Collision layers to test against.", "expression"), F.make_param("max_results", "String", "32", "Max Results", "Most objects to collect.", "expression")], CAT_OVERLAP_3D, "query bodies within {radius} of {center} into {into}", "Node3D")
		.described("Collects every physics object inside a sphere into a variable - explosion radii, pickup magnets, proximity checks.").featured())
	descriptors.append(F.make_descriptor("Core", "QueryBodiesInBox3D", "Query Bodies In Box (3D)", ACEDescriptor.ACEType.ACTION, "var __bs_{uid} := BoxShape3D.new()\n__bs_{uid}.size = {size}\nvar __sq_{uid} := PhysicsShapeQueryParameters3D.new()\n__sq_{uid}.shape = __bs_{uid}\n__sq_{uid}.transform = Transform3D(Basis(), {center})\n__sq_{uid}.collision_mask = {mask}\n{into} = []\nfor __hit_{uid} in get_world_3d().direct_space_state.intersect_shape(__sq_{uid}, {max_results}):\n\t{into}.append(__hit_{uid}.get(\"collider\"))", "", [F.make_param("into", "String", "data", "Into Variable", "Variable receiving the Array of overlapping objects.", "variable_reference"), F.make_param("center", "String", "global_position", "Center", "Box center in world space (Vector3 expression).", "expression"), F.make_param("size", "String", "Vector3(4, 4, 4)", "Size", "Full width, height and depth of the box.", "expression"), F.make_param("mask", "String", "4294967295", "Mask", "Collision layers to test against.", "expression"), F.make_param("max_results", "String", "32", "Max Results", "Most objects to collect.", "expression")], CAT_OVERLAP_3D, "query bodies in box {size} at {center} into {into}", "Node3D")
		.described("Collects every physics object inside a box into a variable - room triggers, rectangular blast zones, selection volumes."))
