		.described("Asks how far a sphere could travel before something stops it, as a fraction of the move (1 means the whole path is clear) - the reliable way to move a fast object without tunnelling through walls."))


# ── 7. Reading a stored cast result. Cast Ray Into hands back the raw Dictionary Godot produced;
# these name its keys so a sheet never has to know them, and read a variable rather than re-casting. ──
static func _add_ray_result_readers(descriptors: Array[ACEDescriptor]) -> void:
	descriptors.append(F.make_descriptor("Core", "RayResultHit2D", "Ray Result Hit Something (2D)", ACEDescriptor.ACEType.CONDITION, "not {result}.is_empty()", "", [F.make_param("result", "String", "hit", "Result", "The variable a Cast Ray Into filled.", "variable_reference")], CAT_2D, "{result} hit something", "Node2D")
		.described("True when the stored cast found something. An empty result means the ray reached its end without touching anything.").featured())
	descriptors.append(F.make_descriptor("Core", "RayResultCollider2D", "Ray Result Collider (2D)", ACEDescriptor.ACEType.EXPRESSION, "{result}.get(\"collider\", null)", "", [F.make_param("result", "String", "hit", "Result", "The variable a Cast Ray Into filled.", "variable_reference")], CAT_2D, "{result} collider", "Node2D")
		.described("The object the stored cast hit, or nothing when it hit thin air."))
	descriptors.append(F.make_descriptor("Core", "RayResultPoint2D", "Ray Result Point (2D)", ACEDescriptor.ACEType.EXPRESSION, "{result}.get(\"position\", Vector2.ZERO)", "", [F.make_param("result", "String", "hit", "Result", "The variable a Cast Ray Into filled.", "variable_reference")], CAT_2D, "{result} point", "Node2D")
		.described("Where in the world the stored cast struck - spawn the impact spark here."))
	descriptors.append(F.make_descriptor("Core", "RayResultNormal2D", "Ray Result Normal (2D)", ACEDescriptor.ACEType.EXPRESSION, "{result}.get(\"normal\", Vector2.ZERO)", "", [F.make_param("result", "String", "hit", "Result", "The variable a Cast Ray Into filled.", "variable_reference")], CAT_2D, "{result} normal", "Node2D")
		.described("Which way the surface faces at the hit - reflect the velocity around it to bounce, or align a decal to it."))
	descriptors.append(F.make_descriptor("Core", "RayResultShape2D", "Ray Result Shape Index (2D)", ACEDescriptor.ACEType.EXPRESSION, "{result}.get(\"shape\", -1)", "", [F.make_param("result", "String", "hit", "Result", "The variable a Cast Ray Into filled.", "variable_reference")], CAT_2D, "{result} shape index", "Node2D")
		.described("Which of the hit object's collision shapes was struck, as an index - tell a headshot from a body shot."))
	descriptors.append(F.make_descriptor("Core", "RayResultInGroup2D", "Ray Result Is In Group (2D)", ACEDescriptor.ACEType.CONDITION, "({result}.get(\"collider\", null) != null and {result}[\"collider\"].is_in_group({group}))", "", [F.make_param("result", "String", "hit", "Result", "The variable a Cast Ray Into filled.", "variable_reference"), F.make_param("group", "String", "\"enemies\"", "Group", "Group name to test the hit object against.", "expression")], CAT_2D, "{result} is in {group}", "Node2D")
		.described("True when the stored cast hit something belonging to a group, checking for nothing-hit first so it is safe on a clear ray."))
	descriptors.append(F.make_descriptor("Core", "RayResultHit3D", "Ray Result Hit Something (3D)", ACEDescriptor.ACEType.CONDITION, "not {result}.is_empty()", "", [F.make_param("result", "String", "hit", "Result", "The variable a Cast Ray Into filled.", "variable_reference")], CAT_3D, "{result} hit something", "Node3D")
		.described("True when the stored cast found something. An empty result means the ray reached its end without touching anything.").featured())
	descriptors.append(F.make_descriptor("Core", "RayResultCollider3D", "Ray Result Collider (3D)", ACEDescriptor.ACEType.EXPRESSION, "{result}.get(\"collider\", null)", "", [F.make_param("result", "String", "hit", "Result", "The variable a Cast Ray Into filled.", "variable_reference")], CAT_3D, "{result} collider", "Node3D")
		.described("The object the stored cast hit, or nothing when it hit thin air."))
	descriptors.append(F.make_descriptor("Core", "RayResultPoint3D", "Ray Result Point (3D)", ACEDescriptor.ACEType.EXPRESSION, "{result}.get(\"position\", Vector3.ZERO)", "", [F.make_param("result", "String", "hit", "Result", "The variable a Cast Ray Into filled.", "variable_reference")], CAT_3D, "{result} point", "Node3D")
		.described("Where in the world the stored cast struck - spawn the impact effect or bullet hole here."))
	descriptors.append(F.make_descriptor("Core", "RayResultNormal3D", "Ray Result Normal (3D)", ACEDescriptor.ACEType.EXPRESSION, "{result}.get(\"normal\", Vector3.ZERO)", "", [F.make_param("result", "String", "hit", "Result", "The variable a Cast Ray Into filled.", "variable_reference")], CAT_3D, "{result} normal", "Node3D")
		.described("Which way the surface faces at the hit - reflect the velocity around it to bounce, or lay a decal flat against it."))
	descriptors.append(F.make_descriptor("Core", "RayResultShape3D", "Ray Result Shape Index (3D)", ACEDescriptor.ACEType.EXPRESSION, "{result}.get(\"shape\", -1)", "", [F.make_param("result", "String", "hit", "Result", "The variable a Cast Ray Into filled.", "variable_reference")], CAT_3D, "{result} shape index", "Node3D")
		.described("Which of the hit object's collision shapes was struck, as an index - tell a headshot from a body shot."))
	descriptors.append(F.make_descriptor("Core", "RayResultFaceIndex3D", "Ray Result Face Index (3D)", ACEDescriptor.ACEType.EXPRESSION, "{result}.get(\"face_index\", -1)", "", [F.make_param("result", "String", "hit", "Result", "The variable a Cast Ray Into filled.", "variable_reference")], CAT_3D, "{result} face index", "Node3D")
		.described("Which triangle of a concave mesh was hit, as an index (-1 for other shape types) - for reading per-face surface data like footstep materials."))
	descriptors.append(F.make_descriptor("Core", "RayResultInGroup3D", "Ray Result Is In Group (3D)", ACEDescriptor.ACEType.CONDITION, "({result}.get(\"collider\", null) != null and {result}[\"collider\"].is_in_group({group}))", "", [F.make_param("result", "String", "hit", "Result", "The variable a Cast Ray Into filled.", "variable_reference"), F.make_param("group", "String", "\"enemies\"", "Group", "Group name to test the hit object against.", "expression")], CAT_3D, "{result} is in {group}", "Node3D")
		.described("True when the stored cast hit something belonging to a group, checking for nothing-hit first so it is safe on a clear ray."))


# ── 8. Camera picking: the screen-to-world ray. Mouse Ray Origin/Direction already gave the two
# halves; these do the whole job, so "what is under the cursor" is one row instead of vector maths. ──
static func _add_camera_picking(descriptors: Array[ACEDescriptor]) -> void:
	descriptors.append(F.make_descriptor("Core", "CastMouseRayInto3D", "Cast Ray From Mouse Into (3D)", ACEDescriptor.ACEType.ACTION, "var __cam_{uid} := get_viewport().get_camera_3d()\nvar __mouse_{uid} := get_viewport().get_mouse_position()\nvar __from_{uid} := __cam_{uid}.project_ray_origin(__mouse_{uid})\nvar __to_{uid} := __from_{uid} + __cam_{uid}.project_ray_normal(__mouse_{uid}) * {distance}\nvar __rq_{uid} := PhysicsRayQueryParameters3D.create(__from_{uid}, __to_{uid}, {mask}, {exclude})\n__rq_{uid}.collide_with_areas = {hit_areas}\n{into} = get_world_3d().direct_space_state.intersect_ray(__rq_{uid})", "", [F.make_param("into", "String", "hit", "Into Variable", "Variable receiving the hit as a Dictionary (empty when nothing is under the cursor). Read it with the Ray Result ACEs.", "variable_reference"), F.make_param("distance", "String", "1000.0", "Distance", "How far into the scene to reach, in metres.", "expression"), F.make_param("mask", "String", "4294967295", "Mask", "Collision layers to test against. The default sees every layer.", "expression"), F.make_param("exclude", "String", "[]", "Ignore", "Array of physics RIDs to skip.", "expression"), F.make_param("hit_areas", "String", "false", "Detect Areas", "true to notice Area3D nodes as well as bodies.", "", ["true", "false"])], CAT_3D, "Cast ray from mouse into {into}", "Node3D")
		.described("Shoots a ray from the camera through the mouse cursor and stores what it finds - the whole of click-to-select in 3D, in one row. Needs an active Camera3D.").featured())
