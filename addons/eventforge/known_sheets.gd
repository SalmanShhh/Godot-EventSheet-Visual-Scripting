# Godot EventSheets - which `.gd` files the plugin KNOWS are event sheets.
#
# `.gd` is the default sheet format, and a sheet saved in it carries no marker: it is a plain script
# whose lines the importer lifts into rows. The Project Doctor reads a sheet row by row, which costs a
# full import per file, so on a project of thousands of hand-written scripts it must not do that to
# every one of them. It does it to the scripts the plugin has reason to call sheets:
#
#   * the file starts with the compiler's banner line, or
#   * it is open in a sheet tab right now, or
#   * the plugin has a record that it was saved from the event sheet editor.
#
# The record lives in the editor's per-project metadata (under `.godot`, per user): it adds no file to
# the project and nothing to version control. It is written whenever a sheet is saved from the sheet
# editor, pruned of paths that no longer exist, and follows a file through a rename or a move. It is
# seeded once from what already exists (the sheet backups, the saved tabs, the Recent list) so a user
# who already has sheets keeps their checks.
#
# DELIBERATELY NO `class_name`, so loading it compiles nothing more: reach it with a const preload.
@tool
extends RefCounted

const SECTION: String = "eventsheets"
const KEY: String = "known_sheets"
const SEEDED_KEY: String = "known_sheets_seeded"

## The compiler's banner: the first line of a compiled sheet.
const SHEET_BANNER: String = "# AUTO-GENERATED by EventForge"

## What the project metadata file is called, for a run with no editor to ask (the command line).
const METADATA_FILE: String = "res://.godot/editor/project_metadata.cfg"

## How long a script takes to open as a sheet and be checked row by row, for the sentence that says what the
## door will cost: the door took 97 seconds over a project of 2,008 scripts in the editor.
const SECONDS_PER_SCRIPT: float = 0.05

## Told when the FileSystem dock moves, renames or deletes a path, through the one
## funnel the record follows: the sheet editor sets this so its open tabs follow the same event. It receives the
## kind (moved, folder_moved, removed, folder_removed), then the path or paths. Empty when no editor is open.
static var path_listener: Callable = Callable()

## Headless twin of the editor's metadata, so every rule here is testable without an editor.
static var _memory: Array = []
static var _memory_seeded: bool = false


static func _in_editor() -> bool:
	return Engine.is_editor_hint() and Engine.has_singleton("EditorInterface")


static func _read() -> Array:
	if _in_editor():
		var stored: Variant = EditorInterface.get_editor_settings().get_project_metadata(SECTION, KEY, [])
		return (stored as Array).duplicate() if stored is Array else []
	return _memory.duplicate()


static func _write(paths: Array) -> void:
	paths.sort()
	if _in_editor():
		EditorInterface.get_editor_settings().set_project_metadata(SECTION, KEY, paths)
	else:
		_memory = paths.duplicate()


## Forgets everything held in memory. A test calls it; the editor's own record is never touched.
static func forget_memory() -> void:
	_memory = []
	_memory_seeded = false


## The recorded paths as {path: true}.
static func recorded() -> Dictionary:
	var found: Dictionary = {}
	for path: Variant in _read():
		found[str(path)] = true
	return found


## Records that a sheet was saved from the sheet editor. Writes only when the record changes, so a
## save of a sheet already known costs a lookup.
static func note_saved(path: String) -> void:
	var clean: String = path.simplify_path()
	if clean.is_empty() or clean.get_extension().to_lower() != "gd":
		return
	var paths: Array = _read()
	if paths.has(clean):
		return
	paths.append(clean)
	_write(paths)


## A file moved or renamed: the record follows it.
static func note_moved(old_path: String, new_path: String) -> void:
	_tell("moved", old_path, new_path)
	var from: String = old_path.simplify_path()
	var paths: Array = _read()
	if not paths.has(from):
		return
	paths.erase(from)
	var to: String = new_path.simplify_path()
	if to.get_extension().to_lower() == "gd" and not paths.has(to):
		paths.append(to)
	_write(paths)


## A whole folder moved or renamed: every recorded path under it follows.
static func note_folder_moved(old_folder: String, new_folder: String) -> void:
	_tell("folder_moved", old_folder, new_folder)
	var from: String = old_folder.simplify_path().trim_suffix("/") + "/"
	var to: String = new_folder.simplify_path().trim_suffix("/") + "/"
	var paths: Array = _read()
	var changed: bool = false
	for index: int in range(paths.size()):
		var path: String = str(paths[index])
		if path.begins_with(from):
			paths[index] = to + path.trim_prefix(from)
			changed = true
	if changed:
		_write(paths)


static func note_removed(path: String) -> void:
	_tell("removed", path)
	var paths: Array = _read()
	if paths.has(path.simplify_path()):
		paths.erase(path.simplify_path())
		_write(paths)


static func note_folder_removed(folder: String) -> void:
	_tell("folder_removed", folder)
	var prefix: String = folder.simplify_path().trim_suffix("/") + "/"
	var kept: Array = []
	var changed: bool = false
	for path: Variant in _read():
		if str(path).begins_with(prefix):
			changed = true
		else:
			kept.append(path)
	if changed:
		_write(kept)


static func _tell(kind: String, first: String, second: String = "") -> void:
	if path_listener.is_valid():
		path_listener.call(kind, first, second)


## Drops every recorded path whose file is no longer there. Returns how many it dropped.
static func prune() -> int:
	var kept: Array = []
	var dropped: int = 0
	for path: Variant in _read():
		if FileAccess.file_exists(str(path)):
			kept.append(path)
		else:
			dropped += 1
	if dropped > 0:
		_write(kept)
	return dropped


## Whether the file starts with the compiler's banner: it reads a few dozen bytes, not the file.
static func has_banner(script_path: String) -> bool:
	var file: FileAccess = FileAccess.open(script_path, FileAccess.READ)
	if file == null:
		return false
	# Compared as bytes: cutting a file mid-character and decoding the piece would print an error.
	return file.get_buffer(SHEET_BANNER.length()) == SHEET_BANNER.to_utf8_buffer()


## The paths among `candidates` that are known sheets, in the order given. `open_paths` are the sheet
## tabs open now. A banner is looked for only on a file the record and the tabs did not already name.
static func known_among(candidates: PackedStringArray, open_paths: PackedStringArray = PackedStringArray()) -> PackedStringArray:
	var open: Dictionary = {}
	for path: String in open_paths:
		open[path.simplify_path()] = true
	var record: Dictionary = recorded()
	var known: PackedStringArray = PackedStringArray()
	for path: String in candidates:
		if open.has(path) or record.has(path) or has_banner(path):
			known.append(path)
	return known


static func is_seeded() -> bool:
	if _in_editor():
		return bool(EditorInterface.get_editor_settings().get_project_metadata(SECTION, SEEDED_KEY, false))
	return _memory_seeded


## Fills the record ONCE from what already exists: the sheet backups (a folder per saved sheet, named
## by the path it holds), the saved tabs, the Recent list, and the tabs open now. Only paths among
## `candidates` (the project's own scripts) count. Returns how many it added; 0 and no change when it
## has already run.
static func seed_once(candidates: PackedStringArray, session_paths: PackedStringArray,
		recent_paths: PackedStringArray, open_paths: PackedStringArray, backup_folders: PackedStringArray) -> int:
	if is_seeded():
		return 0
	var wanted: Dictionary = {}
	for list: PackedStringArray in [session_paths, recent_paths, open_paths]:
		for path: String in list:
			wanted[path.simplify_path()] = true
	var folder_names: Dictionary = {}
	for folder: String in backup_folders:
		folder_names[folder] = true
	var paths: Array = _read()
	var have: Dictionary = {}
	for path: Variant in paths:
		have[str(path)] = true
	var added: int = 0
	for path: String in candidates:
		if have.has(path):
			continue
		if wanted.has(path) or folder_names.has(backup_folder_name(path)):
			paths.append(path)
			added += 1
	if added > 0:
		_write(paths)
	if _in_editor():
		EditorInterface.get_editor_settings().set_project_metadata(SECTION, SEEDED_KEY, true)
	else:
		_memory_seeded = true
	return added


## The folder name the sheet backups use for a path (one folder per file, the path flattened).
static func backup_folder_name(sheet_path: String) -> String:
	return sheet_path.replace("://", "_").replace("/", "_").replace(":", "_")


## The tabs the editor saved at its last close: the session store's file, read as plain data.
static func saved_tab_paths() -> PackedStringArray:
	var session: ConfigFile = ConfigFile.new()
	if session.load("user://eventsheets_session.cfg") != OK:
		return PackedStringArray()
	return PackedStringArray(session.get_value("session", "paths", PackedStringArray()))


## The folder names of the sheet backups.
static func backup_folders() -> PackedStringArray:
	if not DirAccess.dir_exists_absolute("user://eventsheet_backups"):
		return PackedStringArray()
	return PackedStringArray(DirAccess.get_directories_at("user://eventsheet_backups"))


## Loads the record from the project's metadata file, for a run with no editor to ask. Used by the
## command line's "only known sheets" mode.
static func load_from_project_file() -> int:
	var file: ConfigFile = ConfigFile.new()
	if file.load(METADATA_FILE) != OK:
		return 0
	var stored: Variant = file.get_value(SECTION, KEY, [])
	if stored is Array:
		_memory = (stored as Array).duplicate()
	_memory_seeded = bool(file.get_value(SECTION, SEEDED_KEY, false))
	return _memory.size()


## What the door costs, said once: the number of scripts and about how long. Pure, so a test pins it.
static func door_text(plain_count: int) -> String:
	var seconds: float = float(plain_count) * SECONDS_PER_SCRIPT
	var how_long: String = ""
	if seconds < 90.0:
		how_long = EventSheetL10n.translate("about %d seconds") % maxi(5, int(round(seconds / 5.0)) * 5)
	else:
		how_long = EventSheetL10n.translate("about %d minutes") % int(round(seconds / 60.0))
	return "%s (%s)" % [EventSheetL10n.translate("Check these %d scripts as sheets too") % plain_count, how_long]


## Sets `path_listener` on behalf of another script. A static variable assigned from outside its own script marks that script as
## edited, and Godot's scene save then rewrites every edited script (a reload each, seconds in all); a write made here does not.
static func set_path_listener(value: Callable) -> void:
	path_listener = value
