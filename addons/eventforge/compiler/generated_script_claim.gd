# Godot EventSheets - which scripts the plugin may write over.
#
# A sheet saved as a resource compiles to a script beside it. The plugin writes over such a script only
# when it can prove it wrote that script for this very sheet; a script written by hand, or by another
# sheet, is left exactly as it is. The proof is the compiler's own header: its banner on the first line
# and a "# Source:" line naming the sheet. Every plugin version has written that same header, so a script
# an older version wrote is recognised too. One function answers it for everyone who asks (the compiler's
# write, the rename that carries a script along); there is no second copy.
#
# Reach it by path (`load("res://addons/eventforge/compiler/generated_script_claim.gd")`); it has no
# class_name so loading it compiles nothing more.
@tool
extends RefCounted

## The compiler's banner: the first line of a script it wrote.
const BANNER: String = "# AUTO-GENERATED by EventForge"
## The line after the banner that names the sheet the script was written for.
const SOURCE_PREFIX: String = "# Source: "
## The script a resource sheet compiles to is named for the sheet, and sits beside it.
const SCRIPT_SUFFIX: String = "_generated.gd"
## How many lines at the top of a script the banner and the "# Source:" line live in.
const HEADER_LINES: int = 6


## The first lines of the file at `script_path`; empty when it cannot be opened.
static func _header_of(script_path: String) -> PackedStringArray:
	var lines: PackedStringArray = PackedStringArray()
	var file: FileAccess = FileAccess.open(script_path, FileAccess.READ)
	if file == null:
		return lines
	while lines.size() < HEADER_LINES and not file.eof_reached():
		lines.append(file.get_line())
	file.close()
	return lines


## The sheet a script's header names, or "" when the script has no compiler header.
static func source_of(script_path: String) -> String:
	var lines: PackedStringArray = _header_of(script_path)
	if lines.is_empty() or not lines[0].begins_with(BANNER):
		return ""
	for line: String in lines:
		if line.begins_with(SOURCE_PREFIX):
			return line.trim_prefix(SOURCE_PREFIX)
	return ""


## True when `script_path` is a script the compiler wrote for the sheet at `sheet_path`: it starts with the
## compiler's banner, and its "# Source:" line names exactly that sheet. A hand-written script that merely
## shares the name never passes.
static func is_output_of(script_path: String, sheet_path: String) -> bool:
	return not sheet_path.is_empty() and source_of(script_path) == sheet_path


## True when the compiler may write `script_path` for the sheet at `sheet_path`: there is no file yet, it
## is this sheet's own output, or it is the compiler's output for a sheet that is no longer there (the
## folder was moved outside Godot), which nothing else can claim.
static func may_write(script_path: String, sheet_path: String) -> bool:
	if not FileAccess.file_exists(script_path):
		return true
	if is_output_of(script_path, sheet_path):
		return true
	var named: String = source_of(script_path)
	return not named.is_empty() and named != sheet_path and not FileAccess.file_exists(named)


## True when `script_path` is one of the two scripts a resource sheet at `sheet_path` writes beside itself:
## the one named for it with the generated suffix, and the plain one the Run, Reload and Enable plugin
## buttons compile to.
static func is_companion_of(script_path: String, sheet_path: String) -> bool:
	if sheet_path.is_empty() or sheet_path.contains("::"):
		return false
	var base: String = sheet_path.get_basename()
	return script_path == base + SCRIPT_SUFFIX or script_path == base + ".gd"


## "" when the compiler may write `script_path` for the sheet at `sheet_path`, else one plain sentence
## that names the file, says nothing was written and what to do.
static func refusal(script_path: String, sheet_path: String) -> String:
	if may_write(script_path, sheet_path):
		return ""
	var owner_sheet: String = source_of(script_path)
	if owner_sheet.is_empty():
		return EventSheetL10n.translate("%s was not written: it is a script of your own, not one this sheet made, and writing it would replace your code. Rename the sheet or that script so the two names differ, then try again.") % script_path.get_file()
	return EventSheetL10n.translate("%s was not written: it belongs to the sheet %s. Rename one of the two sheets so their names differ, then try again.") % [script_path.get_file(), owner_sheet.get_file()]
