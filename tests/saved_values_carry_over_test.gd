# Values players already saved keep loading when the script around them changes: a renamed variable or
# class can keep loading its old name (a one-time fallback read in the generated block, read back by
# the byte-gated lift), the Doctor says when two scripts without a class_name share a saved name in
# "vars", and a script an older version wrote with Remember Between Runs is updated to Auto in one
# undo step - writing values with the old code and reading them with the new block.
#
# The Doctor walks every script in the project, this one included, so no fixture here spells a
# store into the shared "vars" section literally: the section always arrives through %s.
extends RefCounted

const SUPPORT := preload("res://tests/support.gd")
const PREFIX := "saved_values_carry_over_test"
const SaveChoices := preload("res://addons/eventforge/compiler/save_choices.gd")
const RecordingUndoManager := preload("res://tests/refactor_gestures_test.gd").RecordingUndoManager
const STORE: String = "user://remembered.cfg"

## A script as an older version wrote it: Remember Between Runs on coins and lives.
const OLDER: String = """class_name Player
extends Node2D

var coins: int = 0
var lives: int = 3

func _ready() -> void:
	print(coins)

@onready var __ef_remember_boot: bool = _ef_recall_remembered()

## Generated by Remember Between Runs: loads every remembered variable, then saves them back when this node leaves the tree (scene change or quit).
func _ef_recall_remembered() -> bool:
	var __remember_cfg: ConfigFile = ConfigFile.new()
	if __remember_cfg.load("user://remembered.cfg") == OK:
		coins = __remember_cfg.get_value("Player", "coins", coins)
		lives = __remember_cfg.get_value("Player", "lives", lives)
	tree_exiting.connect(_ef_store_remembered)
	return true

func _ef_store_remembered() -> void:
	var __remember_cfg: ConfigFile = ConfigFile.new()
	__remember_cfg.load("user://remembered.cfg")
	__remember_cfg.set_value("Player", "coins", coins)
	__remember_cfg.set_value("Player", "lives", lives)
	__remember_cfg.save("user://remembered.cfg")
"""

## The same script once Update to Auto has run: its own lines, then the Save choice block.
const UPDATED_TAIL: String = """func _ready() -> void:
	print(coins)

## Saved by each variable's Save choice (Save Studio > What gets saved) - change the choice, not these lines.
@onready var __ef_save_boot: bool = _ef_load_saved()

func _ef_load_saved() -> bool:
	add_to_group("persist")
	var __remember_cfg: ConfigFile = ConfigFile.new()
	if __remember_cfg.load("user://remembered.cfg") == OK:
		coins = __remember_cfg.get_value("Player", "coins", coins)
		lives = __remember_cfg.get_value("Player", "lives", lives)
	tree_exiting.connect(_ef_store_saved)
	return true
"""


static func run() -> bool:
	var kept: PackedByteArray = FileAccess.get_file_as_bytes(STORE) if FileAccess.file_exists(STORE) else PackedByteArray()
	var ok: bool = true
	ok = _a_renamed_variable_keeps_loading() and ok
	ok = _the_old_name_reads_back_byte_for_byte() and ok
	ok = _the_rename_receipt_offers_it() and ok
	ok = _the_class_rename_offers_it() and ok
	ok = _the_doctor_names_a_shared_vars_name() and ok
	ok = _the_older_style_updates_to_auto() and ok
	if kept.is_empty():
		DirAccess.remove_absolute(ProjectSettings.globalize_path(STORE))
	else:
		FileAccess.open(STORE, FileAccess.WRITE).store_buffer(kept)
	return ok


static func _sheet_with_old_names() -> EventSheetResource:
	var sheet: EventSheetResource = EventSheetResource.new()
	sheet.custom_class_name = "Player"
	sheet.host_class = "Node2D"
	sheet.variables = {
		"score": {"type": "int", "default": 0, "attributes": {"save": "auto", "saved_as": {"section": "", "key": "points"}}},
		"gold": {"type": "int", "default": 0, "attributes": {"save": "load", "saved_as": {"section": "vars", "key": "gold"}}},
		"stage": {"type": "int", "default": 1, "attributes": {"save": "manual", "saved_as": {"section": "", "key": "_level"}}},
		"spot": {"type": "Vector2", "default": Vector2.ZERO, "attributes": {"save": "auto"}},
	}
	return sheet


static func _write_store(values: Array) -> void:
	var cfg: ConfigFile = ConfigFile.new()
	for value: Array in values:
		cfg.set_value(value[0], value[1], value[2])
	cfg.save(STORE)


## The fallback is a read of the old key wrapped around the default, and it does what it says on a
## live object: the old key loads while the new one is missing, and the new one wins once it exists.
static func _a_renamed_variable_keeps_loading() -> bool:
	var output: String = SUPPORT.compile_output(_sheet_with_old_names(), "user://saved_values_carry_over.gd")
	var ok: bool = SUPPORT.pins(PREFIX, [
		["a renamed variable reads its old key once",
			output.contains("\t\tscore = __remember_cfg.get_value(\"Player\", \"score\", __remember_cfg.get_value(\"Player\", \"points\", score))\n"), true],
		["a renamed class reads its old section once",
			output.contains("\t\tgold = __remember_cfg.get_value(\"Player\", \"gold\", __remember_cfg.get_value(\"vars\", \"gold\", gold))\n"), true],
		["Load Game reads the old key of a renamed variable", output.contains("\tscore = int(state.get(\"score\", state.get(\"points\", score)))\n"), true],
		["and of a Manual one, without its underscore", output.contains("\tstage = int(state.get(\"stage\", state.get(\"level\", stage)))\n"), true],
		["a class rename leaves Load Game's keys alone", output.contains("\tgold = int(state.get(\"gold\", gold))\n"), true],
		["a variable that kept its name reads only its own", output.contains("\t\tspot = __remember_cfg.get_value(\"Player\", \"spot\", spot)\n"), true],
		["Save only drops the old name it can never read", _choice_drops_old_name("save"), false],
		["Never drops it too", _choice_drops_old_name(""), false],
		["Manual keeps it", _choice_drops_old_name("manual"), true],
	])
	var script: GDScript = GDScript.new()
	script.source_code = output
	ok = SUPPORT.check(PREFIX, "the emitted file parses", script.reload(), OK) and ok
	if not ok:
		return false
	_write_store([["Player", "points", 40], ["vars", "gold", 7], ["Player", "spot", Vector2(1, 2)]])
	var player: Node2D = script.new()
	player.call("_ef_load_saved")
	var first: Array = [player.get("score"), player.get("gold"), player.get("spot")]
	player.call("load_state", {"level": 3, "points": 9})
	var from_slot: Array = [player.get("stage"), player.get("score")]
	player.free()
	_write_store([["Player", "points", 40], ["Player", "score", 5], ["vars", "gold", 7], ["Player", "gold", 8]])
	var later: Node2D = script.new()
	later.call("_ef_load_saved")
	var second: Array = [later.get("score"), later.get("gold")]
	later.free()
	return SUPPORT.pins(PREFIX, [
		["values saved under the old names load", first, [40, 7, Vector2(1, 2)]],
		["a save slot written before the rename loads", from_slot, [3, 9]],
		["once the new name is saved it wins", second, [5, 8]],
	]) and ok


static func _choice_drops_old_name(choice: String) -> bool:
	var attributes: Dictionary = {"save": "auto", "saved_as": {"section": "", "key": "points"}}
	SaveChoices.set_choice(attributes, choice)
	return attributes.has("saved_as")


## Written into a script, the fallback reads back as the same attribute and the file saves byte for
## byte - the lift that cannot reproduce it would not fire.
static func _the_old_name_reads_back_byte_for_byte() -> bool:
	var hand_written: String = "class_name Player\nextends Node2D\n\nvar score: int = 0\nvar gold: int = 0\nvar stage: int = 1\n"
	var opened: EventSheetResource = SUPPORT.reopen(hand_written, false)
	var wanted: Dictionary = _sheet_with_old_names().variables
	for entry: Variant in opened.events:
		if entry is LocalVariable and wanted.has((entry as LocalVariable).name):
			(entry as LocalVariable).attributes = (wanted[(entry as LocalVariable).name]["attributes"] as Dictionary).duplicate(true)
	opened.external_source_path = "user://saved_values_carry_over_player.gd"
	var written: String = SUPPORT.compile_output(opened, "user://saved_values_carry_over_player.gd")
	var read_back: Dictionary = {}
	for entry: Variant in SUPPORT.reopen(written).events:
		if entry is LocalVariable:
			read_back[(entry as LocalVariable).name] = (entry as LocalVariable).attributes.get("saved_as", {})
	return SUPPORT.pins(PREFIX, [
		["the old names read back", read_back, {"score": {"section": "", "key": "points"}, "gold": {"section": "vars", "key": "gold"},
			"stage": {"section": "", "key": "level"}}],
		["reopen then save is byte-identical", SUPPORT.reemit(written, "user://saved_values_carry_over_player.gd"), written],
	])


static func _dock_on(sheet: EventSheetResource) -> EventSheetDock:
	var dock: EventSheetDock = EventSheetEditor.new() as EventSheetDock
	dock.set_undo_redo_manager(RecordingUndoManager.new())
	dock.setup(sheet)
	return dock


## The Rename receipt says, in plain words, what a rename does to values players saved, and the box
## it offers adds the fallback inside the rename's own undo step.
static func _the_rename_receipt_offers_it() -> bool:
	var sheet: EventSheetResource = EventSheetResource.new()
	sheet.variables = {"zq_points": {"type": "int", "default": 0, "attributes": {"save": "auto"}},
		"zq_timer": {"type": "float", "default": 0.0}}
	var dock: EventSheetDock = _dock_on(sheet)
	dock.open_rename_receipt("zq_timer")
	var receipt: RefCounted = dock._rename_receipt
	var never_shown: bool = receipt._saved_box.visible
	dock.open_rename_receipt("zq_points", "zq_score")
	var words: String = EventSheetRenameReceipt.left_behind_text(dock._current_sheet, "zq_points")
	var shown: Array = [receipt._saved_box.visible, receipt._saved_note.text == words, receipt._keep_old.text, receipt._keep_old.button_pressed]
	receipt._keep_old.button_pressed = true
	receipt.confirm()
	var renamed: Dictionary = dock._current_sheet.variables.get("zq_score", {})
	var ok: bool = SUPPORT.pins(PREFIX, [
		["a variable saved Never has nothing to say", never_shown, false],
		["the words", words,
			"Values players already saved under zq_points will not load after the rename: their save files keep them under the old name."],
		["a saved variable says it, and offers the box unticked", shown, [true, true, "Keep loading the old name", false]],
		["ticked, the renamed variable keeps loading the old name", (renamed.get("attributes", {}) as Dictionary).get("saved_as"),
			{"section": "", "key": "zq_points"}],
	])
	dock.free()
	# Unticked, the rename is only a rename.
	var plain: EventSheetResource = EventSheetResource.new()
	plain.variables = {"zq_points": {"type": "int", "default": 0, "attributes": {"save": "auto"}}}
	var plain_dock: EventSheetDock = _dock_on(plain)
	plain_dock.open_rename_receipt("zq_points", "zq_score")
	plain_dock._rename_receipt.confirm()
	ok = SUPPORT.check(PREFIX, "unticked, nothing is kept", plain_dock._current_sheet.variables["zq_score"]["attributes"],
		{"save": "auto"}) and ok
	plain_dock.free()
	return ok


## A class rename moves every Auto and Load only variable to a new section: the question says so, and
## the box keeps them loading from the old one, in the rename's one undo step.
static func _the_class_rename_offers_it() -> bool:
	var sheet: EventSheetResource = EventSheetResource.new()
	sheet.custom_class_name = "ZqHero"
	sheet.variables = {"coins": {"type": "int", "default": 0, "attributes": {"save": "auto"}},
		"spot": {"type": "Vector2", "default": Vector2.ZERO, "attributes": {"save": "manual"}}}
	var dock: EventSheetDock = _dock_on(sheet)
	var undo: RecordingUndoManager = RecordingUndoManager.new()
	dock.set_undo_redo_manager(undo)
	dock._head_actions.open_class_rename()
	var dialog: ConfirmationDialog = dock._head_actions._rename_dialog
	var boxes: Array = dialog.find_children("*", "CheckBox", true, false)
	for field: LineEdit in dialog.find_children("*", "LineEdit", true, false):
		if field.text == "ZqHero":
			field.text = "ZqKnight"
	(boxes[0] as CheckBox).button_pressed = true
	dialog.confirmed.emit()
	var ok: bool = SUPPORT.pins(PREFIX, [
		["only Auto and Load only variables live under the class's section",
			EventSheetHeadActions.values_under_section(sheet), PackedStringArray(["coins"])],
		["the words", EventSheetHeadActions.class_left_behind_text(PackedStringArray(["coins"]), "ZqHero"),
			"Values players already saved for coins will not load after the rename: their save files keep them under ZqHero."],
		["the question offers one box", boxes.map(func(box: CheckBox) -> String: return box.text), ["Keep loading the old name"]],
		["ticked, the class is renamed and coins keeps loading from the old section",
			[dock._current_sheet.custom_class_name, (dock._current_sheet.variables["coins"]["attributes"] as Dictionary).get("saved_as"),
				(dock._current_sheet.variables["spot"]["attributes"] as Dictionary).has("saved_as")],
			["ZqKnight", {"section": "ZqHero", "key": "coins"}, false]],
		["in one undo step", undo._stack.size(), 1],
	])
	dialog.free()
	dock.free()
	return ok


## Two scripts without a class_name saving one name into "vars" overwrite each other: a warning on
## each project script with the fix, and silence for a script with a class_name or a pack.
static func _the_doctor_names_a_shared_vars_name() -> bool:
	var unnamed: EventSheetResource = EventSheetResource.new()
	unnamed.host_class = "Node"
	unnamed.variables = {"score": {"type": "int", "default": 0, "attributes": {"save": "auto"}}}
	var emitted: String = SUPPORT.compile_output(unnamed, "user://saved_values_carry_over_unnamed.gd")
	var store: String = "\t__remember_cfg.set_value(\"%s\", \"%s\", 0)\n"
	var named: String = "class_name Hero\nextends Node\n" + store % ["vars", "score"]
	var findings: Array[Dictionary] = EventSheetProjectDoctor.shared_section_findings({
		"res://a.gd": PackedStringArray(["level", "score"]),
		"res://b.gd": PackedStringArray(["score"]),
		"res://c.gd": PackedStringArray(["volume"]),
		"res://eventsheet_addons/pack/pack.gd": PackedStringArray(["level"]),
	})
	return SUPPORT.pins(PREFIX, [
		["the compiler's own block is what it reads", EventSheetProjectDoctor.shared_section_keys(emitted), PackedStringArray(["score"])],
		["a script with a class_name has a section of its own", EventSheetProjectDoctor.shared_section_keys(named), PackedStringArray()],
		["one warning per project script that shares a name, never a pack",
			findings.map(func(finding: Dictionary) -> Array: return [finding["severity"], finding["check"], finding["path"]]),
			[["warning", "shared-save-section", "res://a.gd"], ["warning", "shared-save-section", "res://b.gd"]]],
		["the warning names the clash, the fix and what the fix costs", str(findings[0]["message"]) if not findings.is_empty() else "",
			"level, score are also saved by pack.gd, b.gd: scripts without a class_name share the \"vars\" section of user://remembered.cfg, so they overwrite each other's value. Give the script a class_name - its values then get a section of their own. Values players already saved under \"vars\" stop loading for it, unless Keep loading the old name is ticked when the class is named."],
	])


## The older Remember Between Runs code reads as remembered, not Never; Update to Auto rewrites it as
## the Auto block in one undo step; and values the old code wrote load through the new block.
static func _the_older_style_updates_to_auto() -> bool:
	var old_script: GDScript = GDScript.new()
	old_script.source_code = OLDER
	var ok: bool = SUPPORT.check(PREFIX, "the older script parses", old_script.reload(), OK)
	if not ok:
		return false
	if FileAccess.file_exists(STORE):
		DirAccess.remove_absolute(ProjectSettings.globalize_path(STORE))
	var old_player: Node2D = old_script.new()
	old_player.set("coins", 12)
	old_player.set("lives", 2)
	old_player.call("_ef_store_remembered")
	old_player.free()

	var dock: EventSheetDock = _dock_on(SUPPORT.reopen(OLDER))
	var undo: RecordingUndoManager = RecordingUndoManager.new()
	dock.set_undo_redo_manager(undo)
	var sheet: EventSheetResource = dock._current_sheet
	var before: Array = [EventSheetSaveStudio.older_style_remembered(sheet),
		EventSheetSaveStudio.savable_variables(sheet).map(func(variable: Dictionary) -> String: return variable["name"])]
	var updated: bool = dock._perform_undoable_sheet_edit("Update to Auto", func() -> bool:
		return EventSheetSaveStudio.update_to_auto(dock._current_sheet))
	dock._current_sheet.external_source_path = "user://saved_values_carry_over_older.gd"
	var output: String = SUPPORT.compile_output(dock._current_sheet, "user://saved_values_carry_over_older.gd")
	ok = SUPPORT.pins(PREFIX, [
		["the older code's variables are found, the boot member is not offered", before,
			[{"coins": ["Player", "coins"], "lives": ["Player", "lives"]}, ["coins", "lives"]]],
		["Update to Auto is one undo step", [updated, undo._stack.size()], [true, 1]],
		["the older code is gone and the Auto block holds the same keys", output.contains("_ef_recall_remembered"), false],
		["the script keeps its own lines and gets the block", output.contains(UPDATED_TAIL), true],
		["it reads back as Auto and saves byte for byte", [SaveChoices.choice_of(_row(SUPPORT.reopen(output), "coins").attributes),
			SUPPORT.reemit(output, "user://saved_values_carry_over_older.gd") == output], ["auto", true]],
		["nothing older is left to update", EventSheetSaveStudio.update_to_auto(dock._current_sheet), false],
	]) and ok
	var new_script: GDScript = GDScript.new()
	new_script.source_code = output
	ok = SUPPORT.check(PREFIX, "the updated script parses", new_script.reload(), OK) and ok
	if new_script.can_instantiate():
		var new_player: Node2D = new_script.new()
		new_player.call("_ef_load_saved")
		ok = SUPPORT.check(PREFIX, "values the old code saved load through the new block",
			[new_player.get("coins"), new_player.get("lives")], [12, 2]) and ok
		new_player.free()
	undo.undo()
	ok = SUPPORT.check(PREFIX, "Ctrl+Z puts the older code back", EventSheetSaveStudio.older_style_remembered(dock._current_sheet).size(), 2) and ok
	dock.free()
	# Values the old code kept under a class name the script no longer has are read from there.
	var renamed: EventSheetResource = SUPPORT.reopen(OLDER.replace("class_name Player", "class_name Knight"))
	EventSheetSaveStudio.update_to_auto(renamed)
	return SUPPORT.check(PREFIX, "a section the class has left is kept loading",
		_row(renamed, "coins").attributes, {"save": "auto", "saved_as": {"section": "Player", "key": "coins"}}) and ok


static func _row(sheet: EventSheetResource, variable_name: String) -> LocalVariable:
	for entry: Variant in sheet.events:
		if entry is LocalVariable and (entry as LocalVariable).name == variable_name:
			return entry
	return null
