[gd_scene format=3]

[ext_resource type="Script" path="res://tests/fixtures/opened_scene_level.gd" id="1_level"]
[ext_resource type="Script" path="res://tests/fixtures/opened_scene_player.gd" id="2_player"]
[ext_resource type="Script" path="res://tests/fixtures/opened_scene_hud.gd" id="3_hud"]

[node name="Level" type="Node2D"]
script = ExtResource("1_level")

[node name="Player" type="CharacterBody2D" parent="."]
script = ExtResource("2_player")

[node name="HUD" type="CanvasLayer" parent="."]
script = ExtResource("3_hud")

[node name="StartButton" type="Button" parent="."]

[node name="WaveTimer" type="Timer" parent="."]

[connection signal="pressed" from="StartButton" to="." method="_on_start_button_pressed"]

[connection signal="timeout" from="WaveTimer" to="HUD" method="_on_wave_timer_timeout"]
