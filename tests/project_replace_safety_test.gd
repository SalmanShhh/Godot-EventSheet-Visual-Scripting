# Godot EventSheets - Replace in Project tells sheets from scripts, writes only what is good, and can
# be put back whole.
extends RefCounted

const SUPPORT := preload("res://tests/support.gd")
const TEST_NAME := "project_replace_safety_test"
const REPLACE := "res://addons/eventsheet/editor/dock/project_replace.gd"


static func run() -> bool:
	var module: GDScript = load(REPLACE)
	var open_paths: Dictionary = {"res://open_one.gd": true}
	var by_hand: String = "extends Node\n\n\n# pace is tuned by design\nvar pace: int = 1\n"
	var marked: String = "# AUTO-GENERATED by EventForge v0\nextends Node\n\nvar pace: int = 1\n"
	var passed: bool = SUPPORT.pins(TEST_NAME, [
		["a .tres file is a sheet", module.kind_of("res://a.tres", "", {}), "sheet"],
		["a hand-written .gd is a script", module.kind_of("res://a.gd", by_hand, {}), "script"],
		["a .gd carrying the plugin's header is a sheet", module.kind_of("res://a.gd", marked, {}), "sheet"],
		["a hand-written .gd open in a tab stays a script", module.kind_of("res://open_one.gd", by_hand, open_paths), "script"],
		["a marked .gd open in a tab is a sheet", module.kind_of("res://open_one.gd", marked, open_paths), "sheet"],
		["a behaviour pack is a pack", module.kind_of("res://eventsheet_addons/x/x.gd", by_hand, {}), "pack"],
		["sheets start ticked", module.default_ticked("sheet"), true],
		["scripts start unticked", module.default_ticked("script"), false],
	])

	# The plan: one script and one sheet-marked file, each with a place to change.
	var found: Array = [
		{"path": "res://a.gd", "preview": "var pace: int = 1", "uid": "", "line": 5, "event": 0},
		{"path": "res://b.gd", "preview": "var pace: int = 1", "uid": "", "line": 4, "event": 0},
	]
	var script_a: String = SUPPORT.own_path("a.gd")
	var script_b: String = SUPPORT.own_path("b.gd")
	_write(script_a, by_hand)
	_write(script_b, marked)
	found[0]["path"] = script_a
	found[1]["path"] = script_b
	var entries: Array[Dictionary] = module.plan(found, "pace", "speed", {})
	var defaults: Array[Dictionary] = module.selected(entries, {})
	var both: Array[Dictionary] = module.selected(entries, {script_a: true})
	passed = SUPPORT.pins(TEST_NAME, [
		["the plan has one entry per file", entries.size(), 2],
		["the plan says which is the script", entries[0]["kind"], "script"],
		["the plan shows before and after", entries[0]["lines"][0]["after"], "var speed: int = 1"],
		["the defaults select only the sheet", defaults.size(), 1],
		["the defaults select the marked file", defaults[0]["path"], script_b],
		["ticking the script selects both", both.size(), 2],
		["the summary counts sheets and scripts apart", module.summary(entries, {}),
			"1 place(s) will change: 1 sheet(s) and 0 script(s) you wrote."],
	]) and passed

	# A press with the defaults writes only the sheet; the script is byte-identical afterwards.
	var bar: EventSheetFindBar = EventSheetFindBar.new()
	var rows: Callable = bar._replace_in_rows
	var outcome: Dictionary = module.apply_closed(defaults, "pace", "speed", rows)
	passed = SUPPORT.pins(TEST_NAME, [
		["the sheet file was written", (outcome["written"] as Array).size(), 1],
		["the hand-written script was not touched", FileAccess.get_file_as_string(script_a), by_hand],
		["the sheet file changed", FileAccess.get_file_as_string(script_b).contains("var speed"), true],
	]) and passed

	# Put them all back: the set restores exactly what it wrote, by hash.
	var before_hash: String = FileAccess.get_sha256(script_b)
	var set_id: String = str(outcome["id"])
	var restored: Dictionary = module.put_back(set_id)
	passed = SUPPORT.pins(TEST_NAME, [
		["a set was kept", set_id.is_empty(), false],
		["the one file was restored", restored["restored"], 1],
		["its text is as it was", FileAccess.get_file_as_string(script_b), marked],
		["the bytes differ from the written ones", FileAccess.get_sha256(script_b) == before_hash, false],
	]) and passed
	module.discard_set(set_id)

	# A file changed by hand since the replace is left alone by Put them all back.
	var second: Dictionary = module.apply_closed(module.selected(entries, {script_a: true}), "pace", "speed", rows)
	_write(script_a, "changed by hand\n")
	var third: Dictionary = module.put_back(str(second["id"]))
	passed = SUPPORT.pins(TEST_NAME, [
		["the file that was not changed is restored, the changed one is not", third["restored"], 1],
		["and is named", (third["changed_since"] as PackedStringArray).size() >= 1, true],
		["its newer text stays", FileAccess.get_file_as_string(script_a), "changed by hand\n"],
	]) and passed
	module.discard_set(str(second["id"]))

	# A replace that would leave a script that does not parse writes nothing and is counted.
	var broken_path: String = SUPPORT.own_path("broken.gd")
	_write(broken_path, "extends Node\n\n\nfunc go() -> int:\n\treturn 1\n")
	var broken_entries: Array[Dictionary] = module.plan([{"path": broken_path, "preview": "return 1",
		"uid": "", "line": 5, "event": 0}], "return 1", "return (", {})
	var refused: Dictionary = module.apply_closed(module.selected(broken_entries, {broken_path: true}), "return 1", "return (", rows)
	passed = SUPPORT.pins(TEST_NAME, [
		["a script that would stop parsing is skipped", (refused["skipped"] as PackedStringArray).size(), 1],
		["and nothing is written", (refused["written"] as Array).size(), 0],
		["and the file is unchanged", FileAccess.get_file_as_string(broken_path).contains("return 1"), true],
		["and no set is kept", str(refused["id"]), ""],
	]) and passed

	# A closed .tres sheet is written through the saver and still loads as a sheet.
	var sheet_path: String = SUPPORT.own_path("pace.tres")
	var sheet: EventSheetResource = EventSheetResource.new()
	var comment: CommentRow = CommentRow.new()
	comment.text = "pace of the walker"
	sheet.events = [comment] as Array[Resource]
	ResourceSaver.save(sheet, sheet_path)
	var sheet_entries: Array[Dictionary] = module.plan([{"path": sheet_path, "preview": "pace of the walker",
		"uid": "", "line": 0, "event": 0}], "pace", "speed", {})
	var sheet_outcome: Dictionary = module.apply_closed(module.selected(sheet_entries, {}), "pace", "speed", rows)
	var reloaded: EventSheetResource = ResourceLoader.load(sheet_path, "", ResourceLoader.CACHE_MODE_IGNORE) as EventSheetResource
	passed = SUPPORT.pins(TEST_NAME, [
		["the sheet was written", (sheet_outcome["written"] as Array).size(), 1],
		["it still loads as a sheet", reloaded != null, true],
		["and says the new word", (reloaded.events[0] as CommentRow).text, "speed of the walker"],
	]) and passed
	module.discard_set(str(sheet_outcome["id"]))

	# A hand-written script that is merely open in a tab stays a script, unticked; ticking it still
	# sends the change through that tab (the entry says it is open).
	var open_script: String = SUPPORT.own_path("open_script.gd")
	_write(open_script, by_hand)
	var open_entries: Array[Dictionary] = module.plan([{"path": open_script, "preview": "var pace: int = 1",
		"uid": "", "line": 0, "event": 1}], "pace", "speed", {open_script: true})
	passed = SUPPORT.pins(TEST_NAME, [
		["an open hand-written script is listed as a script", open_entries[0]["kind"], "script"],
		["and knows it is open in a tab", open_entries[0]["open"], true],
		["and is not selected by the defaults", module.selected(open_entries, {}).size(), 0],
		["ticking it selects it", module.selected(open_entries, {open_script: true}).size(), 1],
	]) and passed

	# What Put them all back will restore, said in words: how many files, and when.
	var wording_path: String = SUPPORT.own_path("wording.gd")
	_write(wording_path, marked)
	var wording_entries: Array[Dictionary] = module.plan([{"path": wording_path, "preview": "var pace: int = 1",
		"uid": "", "line": 4, "event": 0}], "pace", "speed", {})
	var wording_outcome: Dictionary = module.apply_closed(module.selected(wording_entries, {}), "pace", "speed", rows)
	var told_back: String = module.newest_set_line()
	passed = SUPPORT.pins(TEST_NAME, [
		["the line names how many files it puts back", told_back.contains("1 file(s)"), true],
		["and the time they were written", told_back.contains(str(wording_outcome["id"]).substr(9, 2) + ":" + str(wording_outcome["id"]).substr(11, 2)), true],
	]) and passed

	# The window says what it lists (scripts as well as sheets), and opens wide enough for a real line.
	var host: Control = Control.new()
	var finder: EventSheetProjectFind = EventSheetProjectFind.new(host)
	finder._build_project_find()
	var results: Tree = finder._project_find_results
	passed = SUPPORT.pins(TEST_NAME, [
		["the window is not titled for sheets alone", finder._project_find_window.title, "Find and replace in the project"],
		["the first column is File, not Sheet", results.get_column_title(0), "File"],
		["the window opens at least a real project line wide", finder._wanted_size().x >= 1000, true],
		["and can be made smaller than it opens", finder._project_find_window.min_size.x < finder._wanted_size().x, true],
		["the way back is hidden while nothing is kept", finder._project_put_back_row.visible == (not module.newest_set_line().is_empty()), true],
	]) and passed
	host.free()
	return passed


static func _write(path: String, text: String) -> void:
	var handle: FileAccess = FileAccess.open(path, FileAccess.WRITE)
	handle.store_string(text)
	handle.close()
