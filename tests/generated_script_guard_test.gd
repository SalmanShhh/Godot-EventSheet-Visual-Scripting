# Godot EventSheets - a script the plugin did not write for this sheet is never written over.
#
# A sheet saved as a resource (a .tres) compiles to a script beside it. That script used to be written
# without a look at what already sat there, so a hand-written script that happened to carry the name was
# gone after one Save, with no copy. These pin every way a compile can reach such a file: the compiler,
# the public API, the export pass and the helper the editor uses to say what happened. The only script
# the plugin writes over is one that is provably its own output for the same sheet.
@tool
class_name GeneratedScriptGuardTest
extends RefCounted

const SUPPORT := preload("res://tests/support.gd")
const TEST_NAME := "generated_script_guard_test"
const HAND_WRITTEN := "extends Node\n\n\nfunc _ready() -> void:\n\tprint(\"my own code\")\n"


static func run() -> bool:
	var passed: bool = _compiler_refuses_a_hand_written_script()
	passed = _compiler_refuses_another_sheets_script() and passed
	passed = _compiler_still_writes_its_own_script() and passed
	passed = _old_banners_are_recognised() and passed
	passed = _a_script_of_a_sheet_that_is_gone_is_taken_over() and passed
	passed = _the_run_now_script_beside_the_sheet_is_guarded() and passed
	passed = _public_api_reports_the_refusal() and passed
	passed = _export_pass_does_not_write_over() and passed
	passed = _save_as_script_and_pack_writes_are_the_callers_own_choice() and passed
	passed = _the_one_proof() and passed
	return passed


static func _write(path: String, text: String) -> String:
	DirAccess.make_dir_recursive_absolute(path.get_base_dir())
	var file: FileAccess = FileAccess.open(path, FileAccess.WRITE)
	file.store_string(text)
	file.close()
	return path


static func _read(path: String) -> String:
	return FileAccess.get_file_as_string(path) if FileAccess.file_exists(path) else "<missing>"


## A resource sheet that lives at `path`, with one comment so its script is not empty.
static func _sheet_at(path: String) -> EventSheetResource:
	var sheet: EventSheetResource = EventSheetResource.new()
	var comment: CommentRow = CommentRow.new()
	comment.text = "hello"
	sheet.events.append(comment)
	sheet.take_over_path(path)
	return sheet


static func _header(sheet_path: String, version: String = "0.20.0") -> String:
	return "# AUTO-GENERATED by EventForge v%s\n# Source: %s\n# DO NOT EDIT - this file is regenerated on every compile.\n\nextends Node\n" % [version, sheet_path]


static func _compiler_refuses_a_hand_written_script() -> bool:
	var sheet_path: String = SUPPORT.own_path("guard_hand/door.tres")
	var script_path: String = _write(SUPPORT.own_path("guard_hand/door_generated.gd"), HAND_WRITTEN)
	var result: Dictionary = EventSheetCompiler.compile(_sheet_at(sheet_path), "")
	var errors: Array = result.get("errors", [])
	return SUPPORT.pins(TEST_NAME, [
		["the hand-written script keeps every byte", _read(script_path), HAND_WRITTEN],
		["the compile says it did not write", result.get("success"), false],
		["one plain sentence says why", errors.size(), 1],
		["the sentence names the file", str(errors[0]).contains("door_generated.gd") if not errors.is_empty() else false, true],
		["the result still carries the text", str(result.get("output", "")).length() > 0, true],
		["no copy was made beside it", FileAccess.file_exists(SUPPORT.own_path("guard_hand/door_generated2.gd")), false],
	])


static func _compiler_refuses_another_sheets_script() -> bool:
	var sheet_path: String = SUPPORT.own_path("guard_other/door.tres")
	var other_sheet: String = _write(SUPPORT.own_path("guard_other/gate.tres"), "[gd_resource]\n")
	var theirs: String = _header(other_sheet)
	var script_path: String = _write(SUPPORT.own_path("guard_other/door_generated.gd"), theirs)
	var result: Dictionary = EventSheetCompiler.compile(_sheet_at(sheet_path), "")
	return SUPPORT.pins(TEST_NAME, [
		["a script another sheet wrote is left as it was", _read(script_path), theirs],
		["and the compile says it did not write", result.get("success"), false],
	])


static func _compiler_still_writes_its_own_script() -> bool:
	var sheet_path: String = SUPPORT.own_path("guard_own/door.tres")
	var script_path: String = SUPPORT.own_path("guard_own/door_generated.gd")
	var first: Dictionary = EventSheetCompiler.compile(_sheet_at(sheet_path), "")
	var second: Dictionary = EventSheetCompiler.compile(_sheet_at(sheet_path), "")
	return SUPPORT.pins(TEST_NAME, [
		["a first compile writes the script", first.get("success"), true],
		["the script holds the compile's text", _read(script_path), str(first.get("output", ""))],
		["a second compile over its own output succeeds", second.get("success"), true],
	])


static func _old_banners_are_recognised() -> bool:
	var rows: Array = []
	var index: int = 0
	for version: String in ["0.1.0", "0.9.3", "0.14.0"]:
		var sheet_path: String = SUPPORT.own_path("guard_old_%d/door.tres" % index)
		var script_path: String = _write(SUPPORT.own_path("guard_old_%d/door_generated.gd" % index), _header(sheet_path, version))
		var result: Dictionary = EventSheetCompiler.compile(_sheet_at(sheet_path), "")
		rows.append(["a script an older plugin %s wrote is taken over" % version, result.get("success"), true])
		rows.append(["and it now holds this compile", _read(script_path), str(result.get("output", ""))])
		index += 1
	return SUPPORT.pins(TEST_NAME, rows)


static func _a_script_of_a_sheet_that_is_gone_is_taken_over() -> bool:
	# The script says another sheet wrote it, but that sheet is not there any more (the folder was moved
	# outside Godot). Nothing else can claim the file, so it is still the plugin's own to refresh.
	var sheet_path: String = SUPPORT.own_path("guard_gone/door.tres")
	var script_path: String = _write(SUPPORT.own_path("guard_gone/door_generated.gd"), _header(SUPPORT.own_path("guard_gone_old_place/door.tres")))
	var result: Dictionary = EventSheetCompiler.compile(_sheet_at(sheet_path), "")
	return SUPPORT.pins(TEST_NAME, [
		["the plugin's script of a vanished sheet is refreshed", result.get("success"), true],
		["and says the sheet it is now for", _read(script_path).contains("# Source: %s" % sheet_path), true],
	])


static func _the_run_now_script_beside_the_sheet_is_guarded() -> bool:
	# Run now, Reload and Enable plugin compile a resource sheet to `<name>.gd` beside it.
	var sheet_path: String = SUPPORT.own_path("guard_run/door.tres")
	var script_path: String = _write(SUPPORT.own_path("guard_run/door.gd"), HAND_WRITTEN)
	var result: Dictionary = EventSheetCompiler.compile(_sheet_at(sheet_path), script_path)
	return SUPPORT.pins(TEST_NAME, [
		["a hand-written script of the sheet's name keeps every byte", _read(script_path), HAND_WRITTEN],
		["and the compile says it did not write", result.get("success"), false],
	])


static func _public_api_reports_the_refusal() -> bool:
	var sheet_path: String = SUPPORT.own_path("guard_api/door.tres")
	var script_path: String = _write(SUPPORT.own_path("guard_api/door_generated.gd"), HAND_WRITTEN)
	var result: Dictionary = EventSheets.compile(_sheet_at(sheet_path))
	return SUPPORT.pins(TEST_NAME, [
		["the public compile leaves the file", _read(script_path), HAND_WRITTEN],
		["and reports failure the way it always does", result.get("success"), false],
		["with the sentence in errors", (result.get("errors", []) as Array).size(), 1],
		["and the text still in output", str(result.get("output", "")).length() > 0, true],
	])


static func _export_pass_does_not_write_over() -> bool:
	var folder: String = SUPPORT.own_folder("guard_export")
	var sheet: EventSheetResource = _sheet_at(folder + "/door.tres")
	sheet.take_over_path("")
	ResourceSaver.save(sheet, folder + "/door.tres")
	var script_path: String = _write(folder + "/door_generated.gd", HAND_WRITTEN)
	var report: Dictionary = EventSheetExportIntegrityPlugin.recompile_all_sheets(folder)
	return SUPPORT.pins(TEST_NAME, [
		["an export keeps the hand-written script", _read(script_path), HAND_WRITTEN],
		["and counts the sheet as one it could not write", report.get("failed"), 1],
	])


static func _save_as_script_and_pack_writes_are_the_callers_own_choice() -> bool:
	# A path the caller names for a script that IS the sheet (Save As script, a pack, a new sheet's
	# own file) is the caller's decision and is written as asked.
	var sheet_path: String = SUPPORT.own_path("guard_choice/door.tres")
	var script_path: String = _write(SUPPORT.own_path("guard_choice/door.gd"), HAND_WRITTEN)
	var result: Dictionary = EventSheetCompiler.compile(_sheet_at(sheet_path), script_path, true)
	return SUPPORT.pins(TEST_NAME, [
		["a banner-less write to a named path goes through", result.get("success"), true],
		["and writes the compile", _read(script_path), str(result.get("output", ""))],
	])


static func _the_one_proof() -> bool:
	var sheet_path: String = "res://x/a.tres"
	var proof: GDScript = load("res://addons/eventforge/compiler/generated_script_claim.gd")
	var script_path: String = _write(SUPPORT.own_path("guard_proof/a_generated.gd"), _header(sheet_path))
	var hand_path: String = _write(SUPPORT.own_path("guard_proof/b_generated.gd"), HAND_WRITTEN)
	return SUPPORT.pins(TEST_NAME, [
		["its own output is proven", proof.is_output_of(script_path, sheet_path), true],
		["another sheet's is not", proof.is_output_of(script_path, "res://x/b.tres"), false],
		["a hand-written script is not", proof.is_output_of(hand_path, sheet_path), false],
		["a file that is not there is not", proof.is_output_of(SUPPORT.own_path("guard_proof/none.gd"), sheet_path), false],
		["the follower asks the same function", load("res://addons/eventsheet/editor/dock/path_follower.gd").is_output_of(script_path, sheet_path), true],
	])
