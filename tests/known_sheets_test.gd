# Godot EventSheets - which `.gd` files the plugin knows are sheets, and what the Project Doctor does with them.
#
# A default-format sheet has no banner, so the Doctor reads as sheets (row by row) the scripts that
# start with the compiler's banner, that are open in a sheet tab, or that the plugin has a record of
# saving from the sheet editor; every other script gets only the checks that make sense for any
# script. The record is per project, seeded once, pruned, and follows a file through a rename.
@tool
extends RefCounted

const SUPPORT := preload("res://tests/support.gd")
const Known := preload("res://addons/eventforge/known_sheets.gd")
const P := "known_sheets_test"
const PLAYER := "res://demo/readme_example/player.gd"


static func run() -> bool:
	Known.forget_memory()
	var folder: String = SUPPORT.own_folder("known_sheets")
	var banner: String = _write(folder + "/banner.gd", "# AUTO-GENERATED by EventForge v0\nextends Node\n")
	var plain: String = _write(folder + "/plain.gd", "extends Node\n\nfunc _ready() -> void:\n\tpass\n")
	var saved: String = _write(folder + "/saved.gd", "extends Node\n")
	var tabbed: String = _write(folder + "/tabbed.gd", "extends Node\n")
	var all: PackedStringArray = PackedStringArray([banner, plain, saved, tabbed])

	var rows: Array = []
	rows.append(["a file starting with the banner is known with no record", Known.known_among(all), PackedStringArray([banner])])
	rows.append(["a script open in a sheet tab is known", Known.known_among(all, PackedStringArray([tabbed])), PackedStringArray([banner, tabbed])])
	Known.note_saved(saved)
	rows.append(["a script saved from the sheet editor is known", Known.known_among(all), PackedStringArray([banner, saved])])
	Known.note_saved(folder + "/not_a_script.tres")
	rows.append(["only a .gd is recorded", Known.recorded().size(), 1])

	# The seed: once, from the saved tabs, Recent, the open tabs and the backup folders.
	Known.forget_memory()
	var added: int = Known.seed_once(all, PackedStringArray([plain]), PackedStringArray([tabbed]),
		PackedStringArray(), PackedStringArray([Known.backup_folder_name(saved), "res_unrelated_file.gd"]))
	rows.append(["the seed takes the saved tabs, Recent and the backups", Known.recorded().keys(), [plain, saved, tabbed]])
	rows.append(["and counts what it added", added, 3])
	rows.append(["it runs only once", Known.seed_once(all, all, all, all, PackedStringArray()), 0])

	# The prune drops what is no longer there.
	Known.note_saved(folder + "/gone.gd")
	var dropped: int = Known.prune()
	rows.append(["a path with no file is pruned", dropped, 1])
	rows.append(["and the rest stay", Known.recorded().size(), 3])

	# A rename or a move follows the file.
	var moved_to: String = folder + "/renamed.gd"
	Known.note_moved(saved, moved_to)
	rows.append(["a renamed file keeps its record under the new name", [Known.recorded().has(saved), Known.recorded().has(moved_to)], [false, true]])
	Known.note_folder_moved(folder, "res://elsewhere")
	rows.append(["a moved folder takes its records along", Known.recorded().has("res://elsewhere/renamed.gd"), true])
	Known.note_folder_removed("res://elsewhere")
	rows.append(["a removed folder takes them away", Known.recorded().size(), 0])
	Known.note_saved(plain)
	Known.note_removed(plain)
	rows.append(["a removed file leaves the record", Known.recorded().size(), 0])

	# What the Doctor reads as sheets. Seeding is switched off with the flag so the machine's own tabs and
	# backups stay out of the answer.
	var doctor: GDScript = EventSheetProjectDoctor
	Known.forget_memory()
	Known.seed_once(PackedStringArray(), PackedStringArray(), PackedStringArray(), PackedStringArray(), PackedStringArray())
	var every: Dictionary = _first_step({})
	rows.append(["by default every script is read as a sheet (the command line)", (every["context"]["sheet_paths"] as PackedStringArray).has(PLAYER), true])
	var only_known: Dictionary = _first_step({"known_only": true})
	var plain_count: int = int(_coverage(only_known).get("plain_count", 0))
	rows.append(["known-only leaves a hand-written script out", (only_known["context"]["sheet_paths"] as PackedStringArray).has(PLAYER), false])
	rows.append(["and counts the scripts it left in one note", plain_count > 0, true])
	var with_tab: Dictionary = _first_step({"known_only": true, "open_paths": PackedStringArray([PLAYER])})
	rows.append(["an open tab makes it a sheet for the audit", (with_tab["context"]["sheet_paths"] as PackedStringArray).has(PLAYER), true])
	Known.note_saved(PLAYER)
	var recorded_run: Dictionary = _first_step({"known_only": true})
	rows.append(["and so does a record of saving it", (recorded_run["context"]["sheet_paths"] as PackedStringArray).has(PLAYER), true])
	rows.append(["the door is offered with the count", int(_coverage(only_known).get("plain_count", 0)) > 0, true])

	# Row-level section: ship-it tells a sheet's print row from a plain script's by the audited set.
	var source: String = FileAccess.get_file_as_string(PLAYER)
	doctor.set("_audited_sheets", {})
	var unknown_says: Array[Dictionary] = EventSheetShipItDoctor.debug_row_findings({PLAYER: source})
	doctor.set("_audited_sheets", {PLAYER: true})
	var known_says: Array[Dictionary] = EventSheetShipItDoctor.debug_row_findings({PLAYER: source})
	doctor.set("_audited_sheets", {})
	rows.append(["a script the audit does not read as a sheet gets one summing note", [unknown_says.size(), unknown_says[0]["severity"]], [1, "info"]])
	rows.append(["a known sheet gets its row-level warning", [known_says.size(), known_says[0]["severity"]], [1, "warning"]])

	# The door.
	var finding: Dictionary = {"check": "sheet-coverage", "plain_count": 2000, "severity": "info", "path": "", "message": "x", "event": 0}
	var offers: Array[Dictionary] = EventSheetProjectDoctorPanel.offers_for(finding)
	rows.append(["the coverage note offers the door", offers.size() > 0 and str(offers[0].get("id", "")) == EventSheetProjectDoctorPanel.CHECK_EVERY_SCRIPT, true])
	rows.append(["the door says how many scripts and about how long", Known.door_text(2000), "Check these 2000 scripts as sheets too (about 3 minutes)"])
	rows.append(["a small count says seconds", Known.door_text(40), "Check these 40 scripts as sheets too (about 5 seconds)"])
	rows.append(["a note with no plain scripts has no door", EventSheetProjectDoctorPanel.offers_for({"check": "sheet-coverage", "message": "x"}).size(), 0])

	Known.forget_memory()
	return SUPPORT.pins(P, rows)


static func _first_step(options: Dictionary) -> Dictionary:
	var session: Dictionary = EventSheetProjectDoctor.begin(options)
	EventSheetProjectDoctor.step(session)
	var context: Dictionary = session["context"]
	var findings: Array = session["findings"]
	EventSheetProjectDoctor.finish(session)
	return {"context": context, "findings": findings}


static func _coverage(step_result: Dictionary) -> Dictionary:
	for finding: Variant in (step_result["findings"] as Array):
		if str((finding as Dictionary).get("check", "")) == "sheet-coverage":
			return finding as Dictionary
	return {}


static func _write(path: String, text: String) -> String:
	DirAccess.make_dir_recursive_absolute(path.get_base_dir())
	var file: FileAccess = FileAccess.open(path, FileAccess.WRITE)
	file.store_string(text)
	file.close()
	return path
