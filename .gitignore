# Godot project cache/import artifacts
.godot/
.import/
*.import
# EXCEPT the translators' template: it carries an empty placeholder locale, and imported as a translation
# it printed "Locale 'xx' does not contain any translation" on every project's first import. Kept as a
# plain file instead - the plugin reads its CSVs itself.
!addons/eventsheet/translations/TEMPLATE.csv.import
*.translation

# Godot export presets
export.cfg
export_presets.cfg

# Mono/.NET (if enabled later)
.mono/

# Crash dumps/logs
*.log
demo/sheets/player_generated_test_output.gd

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/

# Python cache (tooling)
__pycache__/

# Godot's `.uid` sidecars are COMMITTED, every one of them (Godot 4.4+ asks for exactly that): a
# script or shader is named by its uid in scenes, resources and project.godot, and a checkout or a
# user install without the sidecars invents new ids, warns about every one it had cached, and
# churns project.godot. tests/uid_sidecars_test.gd holds every tracked script to its sidecar.
_preview.png
_preview.png.import
_picker_preview.png
_picker_preview.png.import
_code_dialog_preview.png
_code_dialog_preview.png.import
# Generated codegen artifact written by the non-headless render harnesses
event_sheet_generated.gd

# Test Bench temporary artifacts (generated per run)
.eventsheets_test_bench.*

# One-shot patch scripts (session temporary files; never commit)
tools/_*.py
/*_preview.png
/eventsheet_translations/

# AI assistant working dirs - skills and docs belong in docs/internal/skills/
.claude/
.cursor/
