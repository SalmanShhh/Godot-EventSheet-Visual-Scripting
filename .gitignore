# Python cache (tooling)
__pycache__/

# Godot script UID sidecars
*.uid
# EXCEPT the one script project.godot names by uid: the editor rewrites the autoload line to the
# script's uid on import, and without a committed sidecar every fresh checkout invents a new uid -
# so project.godot churned on every machine and the autoload errored until the rewrite landed.
!addons/eventforge/runtime/eventforge_bridge.gd.uid
_preview.png
_preview.png.import
_picker_preview.png
_picker_preview.png.import
_code_dialog_preview.png
_code_dialog_preview.png.import
# Generated codegen artifact written by the non-headless render harnesses
event_sheet_generated.gd

# Test Bench temporary artifacts (generated per run)
.eventsheets_test_bench.*

# One-shot patch scripts (session temporary files; never commit)
tools/_*.py
/*_preview.png
/eventsheet_translations/

# AI assistant working dirs - skills and docs belong in docs/internal/skills/
.claude/
.cursor/
